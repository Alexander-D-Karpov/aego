package demo

// The graph's Speed parameter selects Run independently of the Animator's
// playback Speed field. The color marks actual advancement in that state.
script RunIndicator {
    var advanced bool

    func FixedUpdate(dt float) {
        a := node.Get<Animator>()
        a.SetFloat("Speed", 3)
        if a.State == "Run" && a.Time > 0.05 {
            advanced = true
        }
        if advanced {
            node.Get<SpriteRenderer>().Tint = Color{1, 0.2, 0.1, 1}
        }
    }
}
