package demo

// The target changes color only after its actual Health takes damage.
script DamageIndicator {
    func Update(dt float) {
        hp := node.Get<Health>()
        if hp.Current < hp.Max {
            node.Get<SpriteRenderer>().Tint = Color{1, 0.5, 0.05, 1}
        } else {
            node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
        }
    }
}
