package demo

// The color changes only on the actual Collected signal, not by reading Tag.
script PickupIndicator {
    var collected Connection

    func Ready() {
        collected = node.Get<Pickup2D>().Collected.Connect(OnCollected)
    }

    func OnCollected(by NodeRef) {
        node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
    }
}
