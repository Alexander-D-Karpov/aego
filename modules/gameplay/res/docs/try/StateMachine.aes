package demo

// These are real state-machine hooks: the color changes when the machine
// enters a state, not by reading or mirroring its editable Initial field.
script StateIndicator {
    func EnterIdle() {
        node.Get<SpriteRenderer>().Tint = Color{1, 0.5, 0.05, 1}
    }

    func EnterRun() {
        node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
    }
}
