package demo

// The indicator reports the tagged target's actual Health state.
script ZoneIndicator {
    @export var Target NodeRef

    func Update(dt float) {
        if Target.Get<Health>().Dead {
            node.Get<SpriteRenderer>().Tint = Color{1, 0.5, 0.05, 1}
        } else {
            node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
        }
    }
}
