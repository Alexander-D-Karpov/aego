package demo

// The script requests movement, but the running Motion2D system computes the
// speed and position. The color reports its actual velocity, not MaxSpeed.
script MotionIndicator {
    func FixedUpdate(dt float) {
        m := node.Get<Motion2D>()
        m.Move(1)
        if m.Velocity.X > 0.1 {
            node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
        } else {
            node.Get<SpriteRenderer>().Tint = Color{1, 0.5, 0.05, 1}
        }
    }
}
