package demo

// The bar reads the actual runtime Remaining value, not the configured field.
// It disappears with the node when Lifetime reaches zero.
script TimerDisplay {
    func Update(dt float) {
        remaining := node.Get<Lifetime>().Remaining
        if remaining > 30 {
            node.Get<SpriteRenderer>().Size = Vec2{6, 1.5}
        } else {
            node.Get<SpriteRenderer>().Size = Vec2{2, 1.5}
        }
    }
}
