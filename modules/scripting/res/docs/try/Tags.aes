package demo

// HasTag queries the scene index, including dot-separated parent tags.
script TagIndicator {
    func Update(dt float) {
        if node.HasTag("Enemy") {
            node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
        } else {
            node.Get<SpriteRenderer>().Tint = Color{1, 0.5, 0.05, 1}
        }
    }
}
