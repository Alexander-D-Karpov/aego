package demo

import "aego/save"

// Perform one real in-memory save and reload. OnLoad removes the temporary
// slot, so Reset and another Try run begin independently.
script PersistenceProbe {
    var requested bool
    var finished bool

    func Update(dt float) {
        if finished {
            return
        }
        if !save.Exists("persist-demo") {
            if !requested {
                node.SetPosition(Vec2{2, 0})
                save.Save("persist-demo")
                requested = true
            }
        } else if requested {
            // A newly loaded world waits for OnLoad instead of loading again.
            save.Load("persist-demo")
        }
    }

    func OnLoad() {
        finished = true
        save.Delete("persist-demo")
    }
}
