package demo

// Query the audio service, not the editable PlayOnStart setting. Volume is
// deliberately zero, so this example does not produce audible output.
script VoiceIndicator {
    func Update(dt float) {
        if node.Get<AudioSource2D>().IsPlaying() {
            node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
        } else {
            node.Get<SpriteRenderer>().Tint = Color{1, 0.5, 0.05, 1}
        }
    }
}
