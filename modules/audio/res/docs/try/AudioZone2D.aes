package demo

import "aego/audio"

// The marker reads the target selected by the audio service, not Zone.Gain.
// There is no audio source: observing the mixer does not play a sound.
script GainIndicator {
    func Update(dt float) {
        if audio.WorldBusGain(audio.Bus.Music) > 0.5 {
            node.Get<SpriteRenderer>().Tint = Color{0.05, 0.8, 0.25, 1}
        } else {
            node.Get<SpriteRenderer>().Tint = Color{1, 0.5, 0.05, 1}
        }
    }
}
