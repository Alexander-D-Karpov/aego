project version=1 {
  name="Platformer"
  module="mygame"
  mainScene=asset("7a1e0c5b3d9f4a2e8c6b1d0f9e8a7c01")
  native=true
  window {
    width=1280
    height=720
    title="Aego Platformer"
  }
  defaults {
    audio {
      bus.music.volume=0.8
    }
  }
  input version=2 {
    stack=[Gameplay]
    action {
      name=Move
      type=axis1
      bind=["Key.A/Key.D", "Key.Left/Key.Right", "Pad.LeftX"]
    }
    action {
      name=Jump
      type=button
      bind=["Key.Space", "Pad.A"]
      buffer=0.1
    }
    action {
      name=Attack
      type=button
      bind=["Key.J", "Pad.X"]
    }
    action {
      name=Pause
      type=button
      bind=["Key.Escape", "Pad.Start"]
    }
    action {
      name=Back
      type=button
      bind=["Key.Escape", "Pad.B"]
    }
    action {
      name=QuickSave
      type=button
      bind=["Key.F5"]
    }
    action {
      name=QuickLoad
      type=button
      bind=["Key.F9"]
    }
    context {
      name=Gameplay
      actions=[Move, Jump, Attack, Pause, QuickSave, QuickLoad]
    }
    context {
      name=Menu
      priority=10
      consume=true
      actions=[Back]
    }
  }
  physics {
    gravity=[0, 9.81]
    layers=[Default, Ground, Player, Enemy]
    collide {
      Player=[Ground, Enemy]
      Enemy=[Ground, Player]
    }
  }
}
