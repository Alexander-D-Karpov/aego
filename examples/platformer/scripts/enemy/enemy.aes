package enemy

import (
	"aego/audio"
	"mygame/shared"
)

script EnemyAI {
	signal Died()

	@export
	var PointA NodeRef

	@export
	var PointB NodeRef

	@export(tip="Speed, cooldown, damage and tint of this kind of enemy")
	var Stats AssetRef<EnemyStats>

	@export
	var DieSound AssetRef<AudioEvent>

	var toB bool = true
	var dead bool

	func Ready() {
		node.Get<SpriteRenderer>().Tint = Stats.Tint
		hit := node.Get<Hitbox2D>()
		hit.Damage = Stats.Damage
		hit.Period = Stats.Cooldown
		node.Get<Health>().Died.Connect(OnDied)
		node.Get<Animator>().StateEntered.Connect(OnState)
	}

	func FixedUpdate(dt float) {
		if dead || PointA == nil || PointB == nil {
			return
		}
		body := node.Get<Body2D>()
		goal := PointA.Position()
		if toB {
			goal = PointB.Position()
		}
		dir := shared.Toward(node.Position().X, goal.X, 0.05)
		if dir == 0 {
			toB = !toB
		} else {
			node.Get<SpriteRenderer>().FlipX = dir < 0
		}
		v := body.Velocity
		v.X = dir * Stats.Speed
		body.SetVelocity(v)
	}

	func OnDied(source NodeRef) {
		dead = true
		node.Get<Hitbox2D>().Deactivate()
		node.Get<Animator>().SetTrigger("Die")
		Died.Emit()
		audio.PlayEventAt(DieSound, node.Position())
	}

	func OnState(state int) {
		if node.Get<Animator>().StateName(state) == "Gone" {
			node.Destroy()
		}
	}
}
