package enemy

import (
	"aego/physics"
	"mygame/combat"
	"mygame/shared"
)

script EnemyAI {
	signal Died()

	@export
	var PointA NodeRef

	@export
	var PointB NodeRef

	@export
	var Target NodeRef

	@export(min=0, max=10, unit="u/s")
	var Speed float = 2.5

	@export(min=0, max=5, unit="s")
	var Cooldown float = 1

	var toB bool = true
	var wait float
	var dead bool

	func FixedUpdate(dt float) {
		if wait > 0 {
			wait -= dt
		}
		if dead || PointA == nil || PointB == nil {
			return
		}
		body := node.Get<Body2D>()
		if body == nil {
			return
		}
		goal := PointA.Position()
		if toB {
			goal = PointB.Position()
		}
		dir := shared.Toward(node.Position().X, goal.X, 0.05)
		if dir == 0 {
			toB = !toB
		}
		v := body.Velocity
		v.X = dir * Speed
		body.SetVelocity(v)
	}

	func OnTriggerEnter(other NodeRef) {
		if dead || other != Target {
			return
		}
		tb := other.Get<Body2D>()
		if tb == nil || tb.Velocity.Y <= 0 {
			return
		}
		dead = true
		Died.Emit()
		node.Destroy()
	}

	func OnCollisionEnter(other NodeRef, c physics.Contact) {
		if dead || other != Target || wait > 0 || c.Normal.Y > 0.5 {
			return
		}
		combat.Damage(Target, 1)
		wait = Cooldown
	}
}
