package shared

import "aego/testing"

func TestIsFloor() {
	testing.True(IsFloor(Vec2{0, -1}), "a normal pointing up is a floor")
	testing.False(IsFloor(Vec2{1, 0}), "a wall is not a floor")
	testing.False(IsFloor(Vec2{0, 1}), "a ceiling is not a floor")
}

func TestToward() {
	testing.EqualFloat(Toward(0, 5, 0.1), 1, 0)
	testing.EqualFloat(Toward(5, 0, 0.1), -1, 0)
	testing.EqualFloat(Toward(1, 1.05, 0.1), 0, 0)
}
