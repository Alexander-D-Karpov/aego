package player

import (
	"aego/input"
	"aego/log"
	"aego/math"
	"mygame/enemy"
	"mygame/shared"
)

enum State {
	Idle
	Run
	Air
}

script PlayerController {
	@export(min=0, max=20, unit="u/s")
	var Speed float = 7

	@export(min=0, max=30, unit="u/s")
	var JumpSpeed float = 11

	@export(display="Hit Tint")
	var HitTint Color

	@export
	var EnemyA NodeRef

	@export
	var EnemyB NodeRef

	var vy float
	var state State
	var base Color
	var lastHits int
	var flash float
	var kills int
	var blink Coroutine

	func Ready() {
		sr := node.Get<SpriteRenderer>()
		if sr != nil {
			base = sr.Tint
		}
		watch(EnemyA)
		watch(EnemyB)
		log.Info("player ready at x=" + string(node.Position().X))
	}

	func watch(n NodeRef) {
		if n == nil {
			return
		}
		e := n.GetScript<enemy.EnemyAI>()
		if e != nil {
			e.Died.Connect(OnEnemyDied)
		}
	}

	func OnEnemyDied() {
		kills++
		log.Info("kills=" + string(kills))
	}

	func Blink() coroutine {
		on := true
		for flash > 0 {
			sr := node.Get<SpriteRenderer>()
			if sr != nil {
				if on {
					sr.Tint = HitTint
				} else {
					sr.Tint = base
				}
			}
			on = !on
			yield wait(0.1)
		}
		sr := node.Get<SpriteRenderer>()
		if sr != nil {
			sr.Tint = base
		}
	}

	func Reloaded() {
		if flash > 0 {
			blink = start Blink()
		}
	}

	func FixedUpdate(dt float) {
		p := node.Position()
		x := input.Axis("horizontal")
		p.X += x * Speed * dt
		if p.Y >= shared.GroundY && input.Down(input.KeySpace) {
			vy = -JumpSpeed
		}
		vy += shared.Gravity * dt
		p.Y += vy * dt
		if p.Y >= shared.GroundY {
			p.Y = shared.GroundY
			vy = 0
		}
		p.X = math.Clamp(p.X, -14, 14)
		node.SetPosition(p)
		if p.Y < shared.GroundY {
			state = State.Air
		} else if x != 0 {
			state = State.Run
		} else {
			state = State.Idle
		}
	}

	func Update(dt float) {
		sr := node.Get<SpriteRenderer>()
		if sr == nil {
			return
		}
		x := input.Axis("horizontal")
		if x != 0 {
			sr.FlipX = x < 0
		}
		hp := node.Get<Health>()
		if hp != nil && hp.Hits != lastHits {
			lastHits = hp.Hits
			flash = 1
			if !blink.Running() {
				blink = start Blink()
			}
		}
		if flash > 0 {
			flash -= dt
			return
		}
		if state == State.Air {
			sr.Tint = Color{base.R, base.G, base.B, 0.8}
		} else {
			sr.Tint = base
		}
	}
}
