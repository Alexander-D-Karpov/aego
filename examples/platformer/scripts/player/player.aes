package player

import (
	"aego/audio"
	"aego/camera"
	"aego/input"
	"aego/log"
	"aego/save"
	"aego/settings"
	"mygame/enemy"
)

script PlayerController {
	@export
	var EnemyA NodeRef

	@export
	var EnemyB NodeRef

	@export(min=0)
	var LandShake float = 9

	@export(gizmo="vector")
	var Bounce Vec2 = Vec2{0, -9}

	@export
	var JumpSound AssetRef<AudioEvent>

	@export
	var HitSound AssetRef<AudioEvent>

	@export
	var Theme AssetRef<Clip>

	@persist
	var kills int
	var flash float
	var blink Coroutine

	func Ready() {
		watch(EnemyA)
		watch(EnemyB)
		m := node.Get<Motion2D>()
		m.Jumped.Connect(OnJumped)
		m.Landed.Connect(OnLanded)
		node.Get<Health>().Damaged.Connect(OnDamaged)
		audio.Music(Theme, 1.5)
	}

	func watch(n NodeRef) {
		if n != nil && n.IsAlive() {
			n.GetScript<enemy.EnemyAI>().Died.Connect(OnEnemyDied)
		}
	}

	func OnEnemyDied() {
		kills++
		save.SetGlobalInt("kills", save.GlobalInt("kills", 0) + 1)
		node.Get<Motion2D>().AddVelocity(Bounce)
	}

	func OnJumped() {
		audio.PlayEvent(JumpSound)
	}

	func OnLanded(speed float) {
		if speed > LandShake {
			camera.Shake(0.35)
		}
	}

	func OnDamaged(amount int, source NodeRef) {
		audio.PlayEvent(HitSound)
		flash = 1
		if !blink.Running() {
			blink = start Blink()
		}
	}

	// Blink flashes the sprite while the player is invulnerable after a hit.
	func Blink() coroutine {
		sr := node.Get<SpriteRenderer>()
		for flash > 0 {
			sr.Tint = Color{sr.Tint.R, sr.Tint.G, sr.Tint.B, 1.2 - sr.Tint.A}
			yield wait(0.1)
		}
		sr.Tint = Color{sr.Tint.R, sr.Tint.G, sr.Tint.B, 1}
	}

	func Reloaded() {
		if flash > 0 {
			blink = start Blink()
		}
	}

	func EnterAir() {
		sr := node.Get<SpriteRenderer>()
		sr.Tint = Color{sr.Tint.R, sr.Tint.G, sr.Tint.B, 0.8}
	}

	func ExitAir() {
		sr := node.Get<SpriteRenderer>()
		sr.Tint = Color{sr.Tint.R, sr.Tint.G, sr.Tint.B, 1}
	}

	func Update(dt float) {
		m := node.Get<Motion2D>()
		x := input.Axis("Move")
		m.Move(x)
		if input.Pressed("Jump") {
			m.Jump()
		}
		if input.Released("Jump") {
			m.JumpReleased()
		}
		if x != 0 {
			node.Get<SpriteRenderer>().FlipX = x < 0
		}
		node.Get<Hitbox2D>().Active = !m.Grounded && m.Velocity.Y > 0
		state := "Idle"
		if !m.Grounded {
			state = "Air"
		} else if x != 0 {
			state = "Run"
		}
		node.Get<StateMachine>().Go(state)
		if flash > 0 {
			flash -= dt
		}
		if input.Pressed("QuickSave") {
			save.Save("quick")
		}
		if input.Pressed("QuickLoad") && save.Exists("quick") {
			save.Load("quick")
		}
		if input.Pressed("Pause") {
			settings.OpenView()
		}
	}

	func OnSettingChanged(id string) {
		if id == "audio.bus.music.volume" {
			log.Info("music volume " + string(settings.GetFloat(id)))
		}
	}
}
