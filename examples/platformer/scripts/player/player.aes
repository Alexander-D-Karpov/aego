package player

import (
	"aego/anim"
	"aego/audio"
	"aego/camera"
	"aego/input"
	"aego/log"
	"aego/math"
	"aego/save"
	"aego/settings"
	"mygame/enemy"
)

script PlayerController {
	@export
	var EnemyA NodeRef

	@export
	var EnemyB NodeRef

	@export(min=0)
	var LandShake float = 9

	@export(gizmo="vector")
	var Bounce Vec2 = Vec2{0, -9}

	@export
	var JumpSound AssetRef<AudioEvent>

	@export
	var HitSound AssetRef<AudioEvent>

	@export
	var Theme AssetRef<Clip>

	@export(tip="Hitbox that the Hit frame of the attack clip pulses")
	var Slash NodeRef

	@export(tip="Landing dust emitter")
	var Dust NodeRef

	@export(min=0)
	var Reach float = 0.6

	@persist
	var kills int
	var facing float = 1
	var hit int

	func Ready() {
		watch(EnemyA)
		watch(EnemyB)
		m := node.Get<Motion2D>()
		m.Jumped.Connect(OnJumped)
		m.Landed.Connect(OnLanded)
		node.Get<Health>().Damaged.Connect(OnDamaged)
		hit = anim.EventID("Hit")
		audio.Music(Theme, 1.5)
	}

	func watch(n NodeRef) {
		if n != nil && n.IsAlive() {
			n.GetScript<enemy.EnemyAI>().Died.Connect(OnEnemyDied)
		}
	}

	func OnEnemyDied() {
		kills++
		save.SetGlobalInt("kills", save.GlobalInt("kills", 0) + 1)
		node.Get<Motion2D>().AddVelocity(Bounce)
	}

	func OnJumped() {
		audio.PlayEvent(JumpSound)
	}

	func OnLanded(speed float) {
		if Dust != nil && Dust.IsAlive() {
			Dust.Get<ParticleSystem2D>().Burst(8)
		}
		if speed > LandShake {
			camera.Shake(0.35)
		}
	}

	func OnDamaged(amount int, source NodeRef) {
		audio.PlayEvent(HitSound)
		node.Get<Animator>().SetTrigger("Hurt")
	}

	func OnAnimEvent(id int, payload float) {
		if id == hit && Slash != nil {
			Slash.Get<Hitbox2D>().Pulse()
		}
	}

	func FixedUpdate(dt float) {
		m := node.Get<Motion2D>()
		x := input.Axis("Move")
		m.Move(x)
		if input.Pressed("Jump") {
			m.Jump()
		}
		if input.Released("Jump") {
			m.JumpReleased()
		}
		if x != 0 {
			facing = math.Sign(x)
			node.Get<SpriteRenderer>().FlipX = x < 0
			if Slash != nil {
				Slash.SetPosition(Vec2{facing * Reach, 0})
				Slash.Get<SpriteRenderer>().FlipX = x < 0
			}
		}
		node.Get<Hitbox2D>().Active = !m.Grounded && m.Velocity.Y > 0
		a := node.Get<Animator>()
		a.SetFloat("Speed", math.Abs(m.Velocity.X))
		a.SetBool("Grounded", m.Grounded)
		a.SetFloat("VerticalSpeed", m.Velocity.Y)
		a.SetBool("Climbing", m.Climbing)
		if input.Pressed("Attack") {
			a.SetTrigger("Attack")
		}
		if Slash != nil && a.State != "Hit" {
			Slash.Get<SpriteRenderer>().Tint = Color{1, 1, 1, 0}
		}
	}

	func Update(dt float) {
		if input.Pressed("QuickSave") {
			save.Save("quick")
		}
		if input.Pressed("QuickLoad") && save.Exists("quick") {
			save.Load("quick")
		}
		if input.Pressed("Pause") {
			settings.OpenView()
		}
	}

	func OnSettingChanged(id string) {
		if id == "audio.bus.music.volume" {
			log.Info("music volume " + string(settings.GetFloat(id)))
		}
	}
}
