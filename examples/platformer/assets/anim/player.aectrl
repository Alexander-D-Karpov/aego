  state "Hurt" clip=asset("a0a10000000000000000000000000006") {}
  state "Climb" clip=asset("a0a10000000000000000000000000007") {}
  transition "any" to="Hurt" interrupt=true {
    cond "Hurt" {}
  }
  transition "any" to="Climb" interrupt=true {
    cond "Climbing" {}
  }
  transition "Climb" to="Idle" duration=0.05 {
    cond "Climbing" op=eq value=false {}
  }
