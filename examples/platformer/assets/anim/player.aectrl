controller version=1 {
  entry="Idle"
  param "Speed" kind=float {}
  param "Grounded" kind=bool default=true {}
  param "VerticalSpeed" kind=float {}
  param "Attack" kind=trigger {}
  param "Hurt" kind=trigger {}
  param "Climbing" kind=bool {}
  state "Idle" clip=asset("a0a10000000000000000000000000001") {}
  state "Run" clip=asset("a0a10000000000000000000000000002") {}
  state "Jump" clip=asset("a0a10000000000000000000000000003") {}
  state "Fall" clip=asset("a0a10000000000000000000000000004") {}
