    cond "Attack" {}
  }
  transition "Idle" to="Run" duration=0.1 {
    cond "Grounded" {}
    cond "Speed" op=gt value=0.1 {}
  }
  transition "Run" to="Idle" duration=0.1 {
    cond "Speed" op=le value=0.1 {}
  }
  transition "Idle" to="Jump" {
    cond "Grounded" op=eq value=false {}
    cond "VerticalSpeed" op=lt value=0 {}
  }
  transition "Run" to="Jump" {
    cond "Grounded" op=eq value=false {}
    cond "VerticalSpeed" op=lt value=0 {}
  }
  transition "Idle" to="Fall" duration=0.1 {
    cond "Grounded" op=eq value=false {}
    cond "VerticalSpeed" op=ge value=0 {}
  }
  transition "Run" to="Fall" duration=0.1 {
    cond "Grounded" op=eq value=false {}
    cond "VerticalSpeed" op=ge value=0 {}
  }
  transition "Jump" to="Fall" duration=0.1 {
    cond "VerticalSpeed" op=ge value=0 {}
  }
  transition "Fall" to="Jump" {
    cond "Grounded" op=eq value=false {}
    cond "VerticalSpeed" op=lt value=0 {}
  }
  transition "Jump" to="Idle" duration=0.05 {
    cond "Grounded" {}
    cond "Speed" op=le value=0.1 {}
  }
  transition "Jump" to="Run" duration=0.05 {
    cond "Grounded" {}
    cond "Speed" op=gt value=0.1 {}
