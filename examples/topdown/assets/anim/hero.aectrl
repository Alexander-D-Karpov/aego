controller version=1 {
  entry="Idle"
  param "Speed" kind=float {}
  param "Attack" kind=trigger {}
  state "Idle" clip=asset("70a10000000000000000000000000001") {}
  state "Run" clip=asset("70a10000000000000000000000000002") {}
  state "Attack" clip=asset("70a10000000000000000000000000003") {}
  transition "any" to="Attack" interrupt=true {
    cond "Attack" {}
  }
  transition "Idle" to="Run" duration=0.1 {
