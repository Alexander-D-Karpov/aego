  }
  msg "schema.gameplay.Health.destroyOnDeath.doc" {
    text="Уничтожает узел при смерти, если у него нет Возрождения."
  }
  msg "schema.gameplay.Health.doc" {
    text="Очки здоровья узла. Урон наносят хитбоксы, смертельные зоны и скрипты; при нуле узел умирает один раз, до возрождения."
  }
  msg "schema.gameplay.Health.invulnTime" {
    text="Время неуязвимости"
  }
  msg "schema.gameplay.Health.invulnTime.doc" {
    text="Секунды игрового времени без урона после удара. Удары в одном шаге засчитываются все."
