messages version=1 lang=ru {
  msg "api.aego/action.Action" {
    text="Action выполняет твины, таймеры и другие действия по очереди или вместе; yield a ждёт, пока оно не закончится."
  }
  msg "api.aego/action.Action.Completed" {
    text="Вызывается один раз, когда действие заканчивается; finished равно false после Stop или когда узел его скрипта уничтожен."
  }
  msg "api.aego/action.Action.Done" {
    text="Сообщает, закончилось ли действие, было ли оно остановлено или равно nil."
  }
  msg "api.aego/action.Action.Running" {
    text="Противоположность Done."
  }
  msg "api.aego/action.Action.Stop" {
    text="Останавливает все незаконченные шаги; свойства сохраняют текущие значения."
  }
  msg "api.aego/action.Action.Then" {
    text="Добавляет твин, созданный в этом кадре; он ждёт своей очереди."
  }
  msg "api.aego/action.Action.ThenAction" {
    text="Добавляет другое действие, которое ещё не началось."
  }
  msg "api.aego/action.Action.ThenTimer" {
    text="Добавляет таймер, созданный в этом кадре; шаг заканчивается вместе с таймером."
  }
  msg "api.aego/action.Action.Wait" {
    text="Добавляет паузу в секундах игрового времени."
  }
  msg "api.aego/action.Parallel" {
    text="Создаёт действие, которое выполняет все свои шаги одновременно и заканчивается после последнего."
  }
  msg "api.aego/action.Sequence" {
    text="Создаёт действие, которое выполняет свои шаги один за другим, начиная со следующего обновления твинов."
  }
  msg "api.aego/anim.EventID" {
    text="Возвращает id события, объявленного в «Настройки проекта» → «Анимация», или -1."
  }
  msg "api.aego/anim.EventName" {
    text="Возвращает имя события анимации или пустую строку для неизвестного id."
  }
  msg "api.aego/anim.ParamIndex" {
    text="Возвращает индекс параметра контроллера или -1."
  }
  msg "api.aego/anim.StateName" {
    text="Возвращает имя состояния контроллера или пустую строку."
  }
  msg "api.aego/audio.Builtin" {
    text="Возвращает звук, который поставляется с движком: Beep, Click, Hum (зацикливаемый) или Melody (зацикливаемый)."
  }
  msg "api.aego/audio.Bus" {
    text="Шина микшера: Master, Music, Sfx, UI, Ambience или Voice."
  }
  msg "api.aego/audio.BusVolume" {
    text="Возвращает громкость шины на этот сеанс, заданную SetBusVolume; настройки игрока хранятся отдельно."
  }
  msg "api.aego/audio.Music" {
    text="Зацикливает звук на шине музыки, плавно сменяя прежнюю музыку за seconds секунд."
  }
  msg "api.aego/audio.Mute" {
    text="Заглушает шину на этот сеанс."
  }
  msg "api.aego/audio.Pause" {
    text="Ставит на паузу или продолжает все звуки этого мира."
  }
  msg "api.aego/audio.PauseWith" {
    text="Определяет, встаёт ли звук на паузу вместе с игрой или продолжает играть."
  }
  msg "api.aego/audio.Play" {
    text="Проигрывает звук на его шине. Звук останавливается, когда узел скрипта уничтожается."
  }
  msg "api.aego/audio.PlayAt" {
    text="Проигрывает звук в точке мира; громкость и панорама зависят от расстояния до слушателя."
  }
  msg "api.aego/audio.PlayEvent" {
    text="Проигрывает звуковое событие; пространственное событие следует за узлом скрипта."
  }
  msg "api.aego/audio.PlayEventAt" {
    text="Проигрывает звуковое событие в точке мира."
  }
  msg "api.aego/audio.PlayWith" {
    text="Проигрывает звук с параметрами."
  }
  msg "api.aego/audio.SetBusVolume" {
    text="Задаёт громкость шины на этот сеанс поверх настроек игрока; она не сохраняется."
  }
  msg "api.aego/audio.Sound" {
    text="Sound — играющий звук. yield s ждёт, пока он не закончится; звук, равный nil или закончившийся, считается завершённым. Это событие представления: игровую логику ждите таймером, а не звуком."
  }
  msg "api.aego/audio.Sound.Completed" {
    text="Вызывается один раз, когда звук заканчивается: finished равно false после Stop, когда звук был прерван или когда его узел уничтожен."
  }
  msg "api.aego/audio.Sound.Done" {
    text="Сообщает, закончился ли звук, был ли он остановлен или равен nil."
  }
  msg "api.aego/audio.Sound.Pause" {
    text="Останавливает звук на текущем месте."
  }
  msg "api.aego/audio.Sound.Playing" {
    text="Сообщает, слышен ли звук сейчас: не закончен, не останавливается и не на паузе."
  }
  msg "api.aego/audio.Sound.Position" {
    text="Возвращает проигранные секунды; для зацикленного звука — внутри цикла."
  }
  msg "api.aego/audio.Sound.Resume" {
    text="Продолжает звук после паузы."
  }
  msg "api.aego/audio.Sound.SetPan" {
    text="Задаёт панораму непространственного звука, от -1 до 1."
  }
  msg "api.aego/audio.Sound.SetPitch" {
    text="Меняет скорость и высоту, от 0.25 до 4."
  }
  msg "api.aego/audio.Sound.SetVolume" {
    text="Меняет громкость с коротким переходом."
  }
  msg "api.aego/audio.Sound.Stop" {
    text="Заканчивает звук коротким затуханием."
  }
  msg "api.aego/audio.Sound.StopFade" {
    text="Плавно заглушает звук за seconds секунд."
  }
  msg "api.aego/audio.Steal" {
    text="Что делает звуковое событие при достижении «Макс. голосов»: останавливает самый старый голос, самый тихий или пропускает новый запуск."
  }
  msg "api.aego/audio.StopMusic" {
    text="Плавно заглушает музыку за seconds секунд."
  }
  msg "api.aego/builtin.NodeRef.AddTag" {
    text="Добавляет тег; возвращает false, если тег записан неверно."
  }
  msg "api.aego/builtin.NodeRef.Child" {
    text="Возвращает прямого потомка с этим именем или nil."
  }
  msg "api.aego/builtin.NodeRef.Destroy" {
    text="Удаляет узел и его потомков в конце фазы."
  }
  msg "api.aego/builtin.NodeRef.Enabled" {
    text="Сообщает собственный флаг включения узла, без учёта родителей."
  }
  msg "api.aego/builtin.NodeRef.Find" {
    text="Находит узел по пути относительно этого узла: Weapon/Gun, ../Sibling или /Root/Player."
  }
  msg "api.aego/builtin.NodeRef.HasTag" {
    text="Сообщает, есть ли у узла этот тег или вложенный в него: Enemy подходит к Enemy.Flying."
  }
  msg "api.aego/builtin.NodeRef.IsAlive" {
    text="Сообщает, существует ли узел. Сразу после Destroy равно false."
  }
  msg "api.aego/builtin.NodeRef.IsPrefabInstance" {
    text="Сообщает, является ли узел экземпляром префаба или находится внутри него."
  }
  msg "api.aego/builtin.NodeRef.Name" {
    text="Возвращает имя узла, уникальное среди соседних узлов."
  }
  msg "api.aego/builtin.NodeRef.Parent" {
    text="Возвращает родительский узел или nil для узлов верхнего уровня."
  }
  msg "api.aego/builtin.NodeRef.Position" {
    text="Возвращает локальную позицию относительно родителя."
  }
  msg "api.aego/builtin.NodeRef.Position3" {
    text="Возвращает локальную 3D-позицию."
  }
  msg "api.aego/builtin.NodeRef.PrefabRoot" {
    text="Возвращает корень ближайшего экземпляра префаба, в котором лежит узел, сам узел, если он корень, или nil."
  }
  msg "api.aego/builtin.NodeRef.RemoveTag" {
    text="Удаляет тег и сообщает, был ли он у узла."
  }
  msg "api.aego/builtin.NodeRef.Rotation" {
    text="Возвращает локальный поворот в радианах, по часовой стрелке."
  }
  msg "api.aego/builtin.NodeRef.Rotation3" {
    text="Возвращает локальный 3D-поворот."
  }
  msg "api.aego/builtin.NodeRef.Scale" {
    text="Возвращает локальный масштаб."
  }
  msg "api.aego/builtin.NodeRef.SetEnabled" {
    text="Включает или выключает узел. Выключенные узлы и их потомки не рисуются."
  }
  msg "api.aego/builtin.NodeRef.SetPosition" {
    text="Задаёт локальную позицию."
  }
  msg "api.aego/builtin.NodeRef.SetPosition3" {
    text="Задаёт локальную 3D-позицию."
  }
  msg "api.aego/builtin.NodeRef.SetRotation" {
    text="Задаёт локальный поворот в радианах."
  }
  msg "api.aego/builtin.NodeRef.SetRotation3" {
    text="Задаёт локальный 3D-поворот."
  }
  msg "api.aego/builtin.NodeRef.SetScale" {
    text="Задаёт локальный масштаб. Отрицательный X отражает узел."
  }
  msg "api.aego/builtin.NodeRef.SetTransform2D" {
    text="Заменяет локальную 2D-трансформацию."
  }
  msg "api.aego/builtin.NodeRef.SetTransform3D" {
    text="Заменяет локальную 3D-трансформацию."
  }
  msg "api.aego/builtin.NodeRef.Space" {
    text="Возвращает 0 для 2D-узлов и 1 для 3D-узлов."
  }
  msg "api.aego/builtin.NodeRef.Transform2D" {
    text="Возвращает копию локальной 2D-трансформации. Измените её и передайте в SetTransform2D."
  }
  msg "api.aego/builtin.NodeRef.Transform3D" {
    text="Возвращает копию локальной 3D-трансформации."
  }
  msg "api.aego/builtin.NodeRef.WorldPosition" {
    text="Возвращает позицию в мировых координатах на момент последнего расчёта трансформаций."
  }
  msg "api.aego/camera.Active" {
    text="Возвращает виртуальную камеру, которая управляет основным выводом, или nil."
  }
  msg "api.aego/camera.ActiveOn" {
    text="Возвращает виртуальную камеру, которая управляет выводом с этим именем."
  }
  msg "api.aego/camera.Blend" {
    text="Blend — идущий переход между виртуальными камерами. yield b ждёт, пока он не закончится; переход, равный nil, считается завершённым."
  }
  msg "api.aego/camera.Blend.Completed" {
    text="Вызывается один раз, когда переход заканчивается: finished равно false после Stop или когда раньше стала активной другая камера."
  }
  msg "api.aego/camera.Blend.Done" {
    text="Сообщает, закончился ли переход, был ли он заменён или равен nil."
  }
  msg "api.aego/camera.Blend.Running" {
    text="Противоположность Done."
  }
  msg "api.aego/camera.Blend.Stop" {
    text="Завершает переход сразу на целевой камере."
  }
  msg "api.aego/camera.BlendTo" {
    text="Делает vc активной в обход приоритетов и переходит к ней; seconds 0 берёт её «Время перехода». Release возвращает управление приоритетам."
  }
  msg "api.aego/camera.Cut" {
    text="Делает vc активной сразу, без перехода."
  }
  msg "api.aego/camera.LogicalPose" {
    text="Возвращает положение основного вывода без тряски и привязки к пикселям."
  }
  msg "api.aego/camera.Release" {
    text="Отменяет BlendTo или Cut на основном выводе; снова решают приоритеты, переход длится seconds секунд или «Время перехода» камеры."
  }
  msg "api.aego/camera.RenderPose" {
    text="Возвращает положение, с которым основной вывод был нарисован в последнем кадре."
  }
  msg "api.aego/camera.ScreenToWorld" {
    text="Переводит пиксели вывода в мировые единицы по последнему нарисованному виду основного вывода."
  }
  msg "api.aego/camera.Shake" {
    text="Добавляет травму основному выводу; тряска растёт с травмой, которая ограничена 1 и со временем спадает."
  }
  msg "api.aego/camera.ShakeOn" {
    text="Добавляет травму выводу с этим именем."
  }
  msg "api.aego/camera.Trauma" {
    text="Возвращает текущую травму основного вывода, от 0 до 1."
  }
  msg "api.aego/camera.WorldToScreen" {
    text="Переводит мировые единицы в пиксели вывода по последнему нарисованному виду основного вывода."
  }
  msg "api.aego/curve.Duration" {
    text="Возвращает время между первым и последним ключом, 1 для пресета."
  }
  msg "api.aego/curve.Ease" {
    text="Возвращает значение пресета плавности в точке t, ограниченной диапазоном 0..1."
  }
  msg "api.aego/curve.Easing" {
    text="Имя пресета кривой от 0 до 1. None и Linear движутся с постоянной скоростью."
  }
  msg "api.aego/curve.Eval" {
    text="Возвращает значение кривой в момент t; за пределами ключей кривая продолжается так, как задают её настройки «До» и «После»."
  }
  msg "api.aego/curve.EvalClamped" {
    text="Возвращает значение в момент t, ограниченный первым и последним ключом."
  }
  msg "api.aego/curve.InBack" {
    text="InBack сначала отходит назад за начало, как замах, и только потом движется."
  }
  msg "api.aego/curve.InBounce" {
    text="InBounce отскакивает от начала с растущими прыжками, прежде чем уйти."
  }
  msg "api.aego/curve.InCubic" {
    text="InCubic трогается медленно и разгоняется, сильнее, чем InQuad."
  }
  msg "api.aego/curve.InElastic" {
    text="InElastic качается около начала с растущим размахом, а потом пружиной уходит к концу."
  }
  msg "api.aego/curve.InExpo" {
    text="InExpo почти стоит на месте, а потом проходит почти весь путь в конце."
  }
  msg "api.aego/curve.InOutBack" {
    text="InOutBack отходит назад за начало и проскакивает конец, прежде чем остановиться."
  }
  msg "api.aego/curve.InOutBounce" {
    text="InOutBounce отскакивает от начала и подпрыгивает на конце."
  }
  msg "api.aego/curve.InOutCubic" {
    text="InOutCubic медленна на обоих концах и быстра в середине, сильнее, чем InOutQuad."
  }
  msg "api.aego/curve.InOutElastic" {
    text="InOutElastic качается и около начала, и около конца."
  }
  msg "api.aego/curve.InOutExpo" {
    text="InOutExpo ждёт в начале, проносится через середину и медленно доползает до конца."
  }
  msg "api.aego/curve.InOutQuad" {
    text="InOutQuad медленна на обоих концах и быстрее всего в середине, мягко: для перемещений между двумя положениями покоя."
  }
  msg "api.aego/curve.InOutSine" {
    text="InOutSine медленна на обоих концах, мягче всех кривых: для дыхания, покачивания и затуханий."
  }
  msg "api.aego/curve.InQuad" {
    text="InQuad трогается медленно и разгоняется, мягко: для того, что приходит в движение, например открывающейся двери."
  }
  msg "api.aego/curve.InSine" {
    text="InSine трогается медленно и разгоняется, мягче всех кривых."
  }
  msg "api.aego/curve.Linear" {
    text="Linear движется с постоянной скоростью от начала до конца."
  }
  msg "api.aego/curve.OutBack" {
    text="OutBack проскакивает конец и возвращается к нему: для выскакивающих элементов."
  }
  msg "api.aego/curve.OutBounce" {
    text="OutBounce доходит до конца и подпрыгивает на нём, как упавший мяч."
  }
  msg "api.aego/curve.OutCubic" {
    text="OutCubic начинает быстро и замедляется к концу, сильнее, чем OutQuad."
  }
  msg "api.aego/curve.OutElastic" {
    text="OutElastic пружиной проскакивает конец и качается около него, пока не успокоится."
  }
  msg "api.aego/curve.OutExpo" {
    text="OutExpo сразу проходит почти весь путь, а потом медленно доползает до конца: для резкого интерфейса."
  }
  msg "api.aego/curve.OutQuad" {
    text="OutQuad начинает быстро и мягко замедляется к концу: обычный выбор для выезжающего интерфейса."
  }
  msg "api.aego/curve.OutSine" {
    text="OutSine начинает быстро и замедляется к концу, мягче всех кривых."
  }
  msg "api.aego/debug.Arrow" {
    text="Рисует стрелку от одной точки к другой."
  }
  msg "api.aego/debug.Circle" {
    text="Рисует контур круга радиуса r в мировых единицах."
  }
  msg "api.aego/debug.Clear" {
    text="Удаляет все примитивы, канал которых начинается с prefix."
  }
  msg "api.aego/debug.Cross" {
    text="Рисует крест заданного размера в мировых единицах."
  }
  msg "api.aego/debug.Line" {
    text="Рисует линию в мировых единицах. Она держится один кадр, если Pen не задаёт время жизни."
  }
  msg "api.aego/debug.Pen" {
    text="Задаёт канал и время жизни следующих примитивов, которые рисует этот скрипт. ttl 0 держится один кадр, положительный ttl — столько секунд игрового времени, отрицательный — до Clear."
  }
  msg "api.aego/debug.PenUnscaled" {
    text="То же, что Pen, но время жизни в реальных секундах; такие примитивы исчезают и пока игра на паузе."
  }
  msg "api.aego/debug.Point" {
    text="Отмечает точку маленьким крестом постоянного экранного размера."
  }
  msg "api.aego/debug.Ray" {
    text="Рисует стрелку от origin вдоль dir; длина dir равна длине стрелки."
  }
  msg "api.aego/debug.Rect" {
    text="Рисует контур прямоугольника."
  }
  msg "api.aego/debug.Text" {
    text="Рисует подпись в точке мира; её экранный размер не зависит от масштаба."
  }
  msg "api.aego/input.ActiveDevice" {
    text="Возвращает устройство, которым игрок 0 пользовался последним: -1 — никакое, 0 — клавиатура и мышь, от 1 до 4 — геймпад."
  }
  msg "api.aego/input.Axis" {
    text="Возвращает значение действия-оси от -1 до 1 или силу нажатия действия-кнопки."
  }
  msg "api.aego/input.Axis2" {
    text="Возвращает 2D-действие как вектор длиной не больше 1; Y растёт вниз, как в 2D-мире."
  }
  msg "api.aego/input.Axis2P" {
    text="То же, что Axis2, для одного игрока."
  }
  msg "api.aego/input.AxisP" {
    text="То же, что Axis, для одного игрока."
  }
  msg "api.aego/input.BeginRebind" {
    text="Ждёт следующую клавишу, кнопку или стик и назначает её в слот действия. Escape отменяет."
  }
  msg "api.aego/input.Buffered" {
