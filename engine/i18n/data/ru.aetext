  }
  msg "api.gameplay.Motion2D.HitCeiling" {
    text="Срабатывает, когда персонаж ударяется о потолок."
  }
  msg "api.gameplay.Motion2D.HitWall" {
    text="Срабатывает, когда персонаж начинает касаться стены."
  }
  msg "api.gameplay.Motion2D.Jump" {
