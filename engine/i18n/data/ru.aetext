    text="Масштаб гравитации"
  }
  msg "schema.physics.Body2D.gravityScale.doc" {
    text="Множитель гравитации проекта для этого тела; 0 — тело парит."
  }
  msg "schema.physics.Body2D.interpolate" {
    text="Интерполяция"
  }
  msg "schema.physics.Body2D.interpolate.doc" {
