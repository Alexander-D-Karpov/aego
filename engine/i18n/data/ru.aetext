    text="Угловая скорость"
  }
  msg "schema.physics.Body2D.angularVelocity.doc" {
    text="Скорость вращения в радианах в секунду."
  }
  msg "schema.physics.Body2D.awake" {
    text="Активно"
  }
  msg "schema.physics.Body2D.awake.doc" {
    text="Симулируется ли тело на этом шаге или спит."
  }
  msg "schema.physics.Body2D.bullet" {
    text="Пуля"
  }
  msg "schema.physics.Body2D.bullet.doc" {
    text="Непрерывная проверка столкновений с другими динамическими телами, чтобы быстрое тело не пролетало сквозь них. Дороже."
  }
  msg "schema.physics.Body2D.doc" {
    text="Симулирует узел как твёрдое тело. Его форму задают коллайдеры на узле и его детях."
  }
