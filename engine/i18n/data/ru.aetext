    text="Точки"
  }
  msg "schema.physics.EdgeCollider2D.points.doc" {
    text="Точки линии в пространстве узла, не меньше 2; правьте их в панели «Сцена»."
  }
  msg "schema.physics.EdgeCollider2D.restitution" {
    text="Упругость"
  }
  msg "schema.physics.EdgeCollider2D.restitution.doc" {
    text="Упругость: 0 — останавливается при ударе, 1 — отскакивает с той же скоростью. Для двух форм берётся большее."
  }
  msg "schema.physics.PolygonCollider2D" {
    text="Коллайдер-многоугольник 2D"
