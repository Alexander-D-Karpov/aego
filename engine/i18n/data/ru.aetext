  }
  msg "schema.gameplay.Checkpoint2D" {
    text="Контрольная точка 2D"
  }
  msg "schema.gameplay.Checkpoint2D.area" {
    text="Область"
  }
  msg "schema.gameplay.Checkpoint2D.area.doc" {
    text="Прямоугольник в пространстве этого узла."
  }
  msg "schema.gameplay.Checkpoint2D.doc" {
    text="Задаёт точку возрождения узлу с Возрождением, вошедшему в область."
  }
