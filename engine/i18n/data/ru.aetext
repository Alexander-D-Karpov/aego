  msg "api.audio.AudioSource2D.Play" {
    text="Запускает источник с начала, останавливая звук, который уже играет."
  }
  msg "api.audio.AudioSource2D.Started" {
    text="Вызывается, когда источник начинает звук."
  }
  msg "api.audio.AudioSource2D.Stop" {
    text="Заканчивает звук источника коротким затуханием."
  }
  msg "api.audio.AudioSource2D.StopFade" {
    text="Плавно заглушает звук источника за seconds секунд."
  }
  msg "api.camera.CameraFollow2D.Snap" {
    text="Сразу переносит камеру на цель, например после телепорта."
  }
  msg "api.camera.CameraShake2D.Add" {
    text="Добавляет травму выводу этой камеры; травма ограничена 1."
  }
  msg "api.camera.VirtualCamera2D.IsActive" {
    text="Сообщает, управляет ли эта виртуальная камера своим выводом сейчас."
  }
  msg "api.events.OnAnimEvent" {
    text="Вызывается в скриптах узла, Проигрыватель анимации которого доходит до события своего клипа; anim.EventName(id) даёт имя."
  }
  msg "api.events.OnCollisionEnter" {
    text="Вызывается после физического шага, в котором это тело начало касаться other."
  }
  msg "api.events.OnCollisionExit" {
    text="Вызывается, когда тела перестают касаться, в том числе когда одно из них уничтожено или выключено. Contact.Point — последняя известная точка."
  }
  msg "api.events.OnCollisionStay" {
    text="Вызывается после каждого следующего физического шага, пока тела касаются. Ничего не стоит, если ни один скрипт его не объявляет."
  }
  msg "api.events.OnDespawned" {
    text="Вызывается в каждом скрипте экземпляра из пула, когда его убирают, до завершения его корутин и подключений."
  }
  msg "api.events.OnLoad" {
    text="Вызывается после Ready в каждом скрипте, где он есть, при загрузке сохранённой игры; значения читаются через save.Get*."
  }
  msg "api.events.OnSave" {
    text="Вызывается в каждом скрипте, где он есть, во время сохранения игры; значения записываются через save.Put*."
  }
  msg "api.events.OnSettingChanged" {
    text="Вызывается в каждом скрипте с этим методом после изменения действующего значения настройки: Apply, Revert, переопределение или истечение времени подтверждения."
  }
  msg "api.events.OnSpawned" {
    text="Вызывается в каждом скрипте созданного экземпляра префаба: после Ready для нового экземпляра и вместо него для экземпляра из пула."
  }
  msg "api.events.OnTriggerEnter" {
    text="Вызывается, когда коллайдер other вошёл в триггер этого тела или это тело вошло в триггер other."
  }
  msg "api.events.OnTriggerExit" {
    text="Вызывается, когда пересечение с триггером заканчивается."
  }
  msg "api.gameplay.Checkpoint2D.Reached" {
    text="Срабатывает, когда узел берёт эту контрольную точку."
