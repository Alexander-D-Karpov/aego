  msg "schema.physics.CircleCollider2D.friction" {
    text="Трение"
  }
  msg "schema.physics.CircleCollider2D.friction.doc" {
    text="Сопротивление скольжению по другим формам; 0 — лёд. Для двух форм берётся корень из произведения."
  }
  msg "schema.physics.CircleCollider2D.isTrigger" {
    text="Триггер"
  }
  msg "schema.physics.CircleCollider2D.isTrigger.doc" {
    text="Замечает пересечения и посылает события триггера, не расталкивая тела."
  }
  msg "schema.physics.CircleCollider2D.offset" {
    text="Смещение"
  }
  msg "schema.physics.CircleCollider2D.offset.doc" {
