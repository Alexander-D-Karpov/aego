  }
  msg "schema.gameplay.Health.current" {
    text="Текущее"
  }
  msg "schema.gameplay.Health.current.doc" {
    text="Очки здоровья сейчас."
  }
  msg "schema.gameplay.Health.dead" {
    text="Мёртв"
  }
  msg "schema.gameplay.Health.dead.doc" {
    text="Истина от смерти до Revive."
  }
  msg "schema.gameplay.Health.despawnOnDeath" {
    text="Убрать при смерти"
  }
  msg "schema.gameplay.Health.despawnOnDeath.doc" {
    text="При смерти возвращает узел в его пул; созданный не из пула узел уничтожается."
