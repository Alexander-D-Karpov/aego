  }
  msg "schema.physics.PolygonCollider2D.friction" {
    text="Трение"
  }
  msg "schema.physics.PolygonCollider2D.friction.doc" {
    text="Сопротивление скольжению по другим формам; 0 — лёд. Для двух форм берётся корень из произведения."
  }
  msg "schema.physics.PolygonCollider2D.isTrigger" {
    text="Триггер"
  }
  msg "schema.physics.PolygonCollider2D.isTrigger.doc" {
    text="Замечает пересечения и посылает события триггера, не расталкивая тела."
  }
  msg "schema.physics.PolygonCollider2D.offset" {
    text="Смещение"
  }
  msg "schema.physics.PolygonCollider2D.offset.doc" {
    text="Позиция формы в пространстве узла."
  }
  msg "schema.physics.PolygonCollider2D.points" {
    text="Точки"
  }
  msg "schema.physics.PolygonCollider2D.points.doc" {
    text="Углы в пространстве узла, от 3 до 8, образуют выпуклую форму; правьте их в панели «Сцена»."
  }
  msg "schema.physics.PolygonCollider2D.restitution" {
    text="Упругость"
  }
  msg "schema.physics.PolygonCollider2D.restitution.doc" {
    text="Упругость: 0 — останавливается при ударе, 1 — отскакивает с той же скоростью. Для двух форм берётся большее."
  }
