    text="Высота ступеньки"
  }
  msg "schema.gameplay.Motion2D.stepHeight.doc" {
    text="На ступеньки до этой высоты, в единицах, персонаж поднимается без прыжка. 0 — никогда."
  }
  msg "schema.gameplay.Motion2D.upDirection" {
    text="Направление вверх"
  }
  msg "schema.gameplay.Motion2D.upDirection.doc" {
    text="Направление вверх для пола, прыжков и гравитации. (0, −1) — вверх на экране."
  }
  msg "schema.gameplay.Motion2D.velocity" {
    text="Скорость"
  }
  msg "schema.gameplay.Motion2D.velocity.doc" {
    text="Скорость в единицах в секунду."
  }
  msg "schema.gameplay.Motion2D.wallNormal" {
    text="Нормаль стены"
  }
  msg "schema.gameplay.Motion2D.wallNormal.doc" {
    text="Нормаль последней задетой стены."
  }
  msg "schema.gameplay.Pickup2D" {
    text="Подбираемый предмет 2D"
  }
  msg "schema.gameplay.Pickup2D.area" {
    text="Область"
  }
  msg "schema.gameplay.Pickup2D.area.doc" {
    text="Прямоугольник в пространстве этого узла."
  }
  msg "schema.gameplay.Pickup2D.despawn" {
    text="Убрать"
  }
  msg "schema.gameplay.Pickup2D.despawn.doc" {
    text="Возвращает предмет в его пул вместо уничтожения."
  }
  msg "schema.gameplay.Pickup2D.doc" {
    text="Посылает Collected, когда узел входит в область; с «Один раз» предмет после этого исчезает."
  }
