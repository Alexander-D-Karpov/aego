  msg "api.aego/save.SetGlobalFloat" {
    text="Сохраняет прогресс всей игры, который попадает в каждое сохранение."
  }
  msg "api.aego/save.SetGlobalInt" {
    text="Сохраняет прогресс всей игры, который попадает в каждое сохранение."
  }
  msg "api.aego/save.SetGlobalString" {
