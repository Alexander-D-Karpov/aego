  }
  msg "api.aego/scene.ByID" {
    text="Возвращает узел с этим id, как он записан в файле сцены, или nil."
  }
  msg "api.aego/scene.Despawn" {
    text="Возвращает созданный экземпляр в его пул; узел не из пула уничтожает."
  }
