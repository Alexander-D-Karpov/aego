  msg "schema.gameplay.Health.invulnerable" {
    text="Неуязвим"
  }
  msg "schema.gameplay.Health.invulnerable.doc" {
    text="Истина, пока урон не проходит."
  }
  msg "schema.gameplay.Health.max" {
    text="Максимум"
  }
  msg "schema.gameplay.Health.max.doc" {
    text="Очки здоровья в начале и после полного возрождения."
  }
