  }
  msg "schema.engine.SpriteRenderer.tint" {
    text="Оттенок"
  }
  msg "schema.engine.SpriteRenderer.tint.doc" {
    text="Цвет, на который умножается текстура. Альфа задаёт прозрачность."
  }
  msg "schema.engine.Tags" {
    text="Теги"
  }
  msg "schema.engine.Tags.doc" {
    text="Теги называют группы, в которые входит узел; скрипты находят их через scene.WithTag."
