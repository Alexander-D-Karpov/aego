  msg "schema.gameplay.Hurtbox2D.shape" {
    text="Форма"
  }
  msg "schema.gameplay.Hurtbox2D.shape.doc" {
    text="box — прямоугольник; circle — вписанный в него круг."
  }
  msg "schema.gameplay.KillZone2D" {
    text="Смертельная зона 2D"
  }
  msg "schema.gameplay.KillZone2D.area" {
    text="Область"
  }
  msg "schema.gameplay.KillZone2D.area.doc" {
    text="Прямоугольник в пространстве этого узла."
  }
  msg "schema.gameplay.KillZone2D.doc" {
    text="Убивает Здоровье, вошедшее в область, или возрождает узел с Возрождением без Здоровья."
  }
  msg "schema.gameplay.KillZone2D.tag" {
    text="Тег"
  }
  msg "schema.gameplay.KillZone2D.tag.doc" {
    text="Только узлы с этим тегом; пусто — все узлы со Здоровьем или Возрождением."
  }
  msg "schema.gameplay.Lifetime" {
    text="Время жизни"
  }
  msg "schema.gameplay.Lifetime.despawn" {
    text="Убрать"
  }
  msg "schema.gameplay.Lifetime.despawn.doc" {
    text="Возвращает узел в его пул вместо уничтожения."
  }
