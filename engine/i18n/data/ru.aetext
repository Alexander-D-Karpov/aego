    text="Команда"
  }
  msg "schema.gameplay.Hitbox2D.team.doc" {
    text="Команда атаки; −1 — команда ближайшего Здоровья выше по иерархии."
  }
  msg "schema.gameplay.Hurtbox2D" {
    text="Хёртбокс 2D"
  }
  msg "schema.gameplay.Hurtbox2D.active" {
    text="Активен"
  }
  msg "schema.gameplay.Hurtbox2D.active.doc" {
    text="Выключенный не получает ударов."
  }
  msg "schema.gameplay.Hurtbox2D.area" {
    text="Область"
  }
  msg "schema.gameplay.Hurtbox2D.area.doc" {
    text="Прямоугольник в пространстве этого узла."
  }
  msg "schema.gameplay.Hurtbox2D.doc" {
