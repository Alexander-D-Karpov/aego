    text="Теги"
  }
  msg "schema.engine.Tags.tags.doc" {
    text="Имена через точку, например Enemy.Flying; узел с тегом Enemy.Flying находится и по Enemy."
  }
  msg "schema.engine.Unknown" {
    text="Неизвестный"
  }
  msg "schema.engine.Unknown.doc" {
