  msg "schema.animation.AnimationPlayer" {
    text="Проигрыватель анимации"
  }
  msg "schema.animation.AnimationPlayer.clip" {
    text="Клип"
  }
  msg "schema.animation.AnimationPlayer.clip.doc" {
    text="Клип для воспроизведения."
  }
  msg "schema.animation.AnimationPlayer.cycle" {
    text="Цикл"
  }
  msg "schema.animation.AnimationPlayer.cycle.doc" {
    text="Сколько циклов повторяющегося клипа уже прошло."
  }
  msg "schema.animation.AnimationPlayer.doc" {
    text="Воспроизводит анимационный клип на своём узле и узлах под ним: дорожки свойств, кадры спрайта и события. Время клипа, игровые события и дорожки, кроме позы трансформации, идут фиксированными шагами, поэтому повтор даёт тот же результат при любой частоте кадров."
  }
  msg "schema.animation.AnimationPlayer.loop" {
    text="Повтор"
  }
  msg "schema.animation.AnimationPlayer.loop.doc" {
    text="clip сохраняет режим повтора из клипа; once, loop и pingPong заменяют его."
  }
  msg "schema.animation.AnimationPlayer.playOnStart" {
    text="Запуск при старте"
  }
  msg "schema.animation.AnimationPlayer.playOnStart.doc" {
    text="Запускает клип в начале игры."
  }
  msg "schema.animation.AnimationPlayer.playing" {
    text="Играет"
  }
  msg "schema.animation.AnimationPlayer.playing.doc" {
    text="Играет ли клип."
  }
  msg "schema.animation.AnimationPlayer.speed" {
    text="Скорость"
  }
  msg "schema.animation.AnimationPlayer.speed.doc" {
    text="Скорость воспроизведения: 1 — обычная, 2 — вдвое быстрее; отрицательная играет назад."
  }
  msg "schema.animation.AnimationPlayer.time" {
    text="Время"
  }
  msg "schema.animation.AnimationPlayer.time.doc" {
    text="Время внутри клипа, в секундах."
  }
  msg "schema.animation.AnimationPlayer.timeDomain" {
    text="Шкала времени"
  }
  msg "schema.animation.AnimationPlayer.timeDomain.doc" {
    text="game идёт по игровому времени и встаёт на паузу вместе с ним; unscaled идёт по реальному времени и во время паузы, для меню и другого оформления."
  }
  msg "schema.animation.Animator" {
    text="Аниматор"
  }
  msg "schema.animation.Animator.blending" {
    text="Смешивание"
  }
  msg "schema.animation.Animator.blending.doc" {
    text="Идёт ли смешивание перехода."
  }
  msg "schema.animation.Animator.controller" {
    text="Контроллер"
  }
  msg "schema.animation.Animator.controller.doc" {
    text="Контроллер с состояниями, параметрами и переходами."
  }
  msg "schema.animation.Animator.doc" {
    text="Проигрывает состояния анимационного контроллера и смешивает их, когда меняются его параметры. Граф, смешивание, движение корня и игровые события идут фиксированными шагами, поэтому повторы совпадают при любой частоте кадров."
  }
  msg "schema.animation.Animator.playOnStart" {
    text="Запуск при старте"
  }
  msg "schema.animation.Animator.playOnStart.doc" {
    text="В начале игры входит в начальное состояние."
  }
  msg "schema.animation.Animator.progress" {
    text="Прогресс"
  }
  msg "schema.animation.Animator.progress.doc" {
    text="Время в текущем состоянии, делённое на длину его клипа; 1 — один полный клип."
  }
  msg "schema.animation.Animator.rootFallback" {
    text="Корень без Движения 2D"
  }
  msg "schema.animation.Animator.rootFallback.doc" {
    text="Если у узла нет Движения 2D, toMotion двигает трансформацию."
  }
  msg "schema.animation.Animator.rootMotion" {
    text="Движение корня"
  }
  msg "schema.animation.Animator.rootMotion.doc" {
    text="Что двигает дорожка корня: none её не использует, toMotion двигает узел через Движение 2D, чтобы его останавливали стены, toTransform задаёт позицию."
  }
  msg "schema.animation.Animator.rootScale" {
    text="Масштаб корня"
  }
  msg "schema.animation.Animator.rootScale.doc" {
    text="Умножает движение корня в пространстве родителя узла; пока персонаж смотрит влево, задайте X = -1."
  }
  msg "schema.animation.Animator.speed" {
    text="Скорость"
  }
  msg "schema.animation.Animator.speed.doc" {
    text="Умножает скорость всех состояний; 1 — обычная скорость."
  }
  msg "schema.animation.Animator.state" {
    text="Состояние"
  }
  msg "schema.animation.Animator.state.doc" {
    text="Текущее состояние."
  }
  msg "schema.animation.Animator.time" {
    text="Время"
  }
  msg "schema.animation.Animator.time.doc" {
    text="Секунды в текущем состоянии."
  }
  msg "schema.animation.Animator.timeDomain" {
    text="Шкала времени"
  }
  msg "schema.animation.Animator.timeDomain.doc" {
    text="game идёт по игровому времени и встаёт на паузу вместе с ним; unscaled идёт по реальному времени и во время паузы, только для оформления."
  }
  msg "schema.audio.AudioEvent" {
    text="Звуковое событие"
  }
  msg "schema.audio.AudioEvent.bus" {
    text="Шина"
  }
  msg "schema.audio.AudioEvent.bus.doc" {
    text="Шина микшера, на которой играет событие."
  }
  msg "schema.audio.AudioEvent.cooldown" {
    text="Перезарядка"
  }
  msg "schema.audio.AudioEvent.cooldown.doc" {
    text="Сколько секунд игрового времени должно пройти, прежде чем событие сможет прозвучать снова."
  }
  msg "schema.audio.AudioEvent.doc" {
    text="Звук для проигрывания с вариантами, случайностью, шиной, пределом голосов и пространством."
  }
  msg "schema.audio.AudioEvent.loop" {
    text="Повтор"
  }
  msg "schema.audio.AudioEvent.loop.doc" {
    text="Звучит по кругу, пока его не остановят."
  }
  msg "schema.audio.AudioEvent.maxDistance" {
    text="Макс. расстояние"
  }
  msg "schema.audio.AudioEvent.maxDistance.doc" {
    text="Расстояние в единицах мира, на котором звук не слышен и полностью сдвинут в сторону."
  }
  msg "schema.audio.AudioEvent.maxVoices" {
    text="Макс. голосов"
  }
  msg "schema.audio.AudioEvent.maxVoices.doc" {
    text="Сколько голосов этого события может звучать в мире одновременно; 0 — без ограничения."
  }
  msg "schema.audio.AudioEvent.minDistance" {
    text="Мин. расстояние"
  }
  msg "schema.audio.AudioEvent.minDistance.doc" {
    text="Расстояние в единицах мира, до которого звук звучит в полную громкость."
  }
  msg "schema.audio.AudioEvent.panWidth" {
    text="Ширина панорамы"
  }
  msg "schema.audio.AudioEvent.panWidth.doc" {
    text="Насколько сдвигается в сторону звук сбоку на макс. расстоянии, от 0 до 1."
  }
  msg "schema.audio.AudioEvent.pauseWith" {
    text="Пауза вместе с"
  }
  msg "schema.audio.AudioEvent.pauseWith.doc" {
    text="game — встаёт на паузу вместе с миром, never — продолжает играть."
  }
  msg "schema.audio.AudioEvent.pitch" {
    text="Высота тона"
  }
  msg "schema.audio.AudioEvent.pitch.doc" {
    text="Скорость и высота воспроизведения; 2 — на октаву выше."
  }
  msg "schema.audio.AudioEvent.pitchRandom" {
    text="Случайность тона"
  }
  msg "schema.audio.AudioEvent.pitchRandom.doc" {
    text="При каждом запуске высота тона меняется вверх или вниз не больше чем на эту долю."
  }
  msg "schema.audio.AudioEvent.priority" {
    text="Приоритет"
  }
  msg "schema.audio.AudioEvent.priority.doc" {
    text="Когда у микшера кончаются голоса, первыми забираются голоса с меньшим приоритетом."
  }
  msg "schema.audio.AudioEvent.rolloff" {
    text="Затухание"
  }
  msg "schema.audio.AudioEvent.rolloff.doc" {
    text="Громкость от мин. расстояния (время 0) до макс. расстояния (время 1)."
  }
  msg "schema.audio.AudioEvent.spatial" {
    text="Пространственный"
  }
  msg "schema.audio.AudioEvent.spatial.doc" {
    text="Затихает и сдвигается в сторону в зависимости от расстояния до слушателя."
  }
  msg "schema.audio.AudioEvent.steal" {
    text="Вытеснение"
  }
  msg "schema.audio.AudioEvent.steal.doc" {
    text="Что происходит при достижении «Макс. голосов»: останавливается самый старый голос, самый тихий или новый запуск пропускается."
  }
  msg "schema.audio.AudioEvent.variants" {
    text="Варианты"
  }
  msg "schema.audio.AudioEvent.variants.doc" {
    text="Клипы; при каждом запуске один выбирается случайно."
  }
  msg "schema.audio.AudioEvent.volume" {
    text="Громкость"
  }
  msg "schema.audio.AudioEvent.volume.doc" {
    text="Громкость события до шины."
  }
  msg "schema.audio.AudioEvent.volumeRandom" {
    text="Случайность громкости"
  }
  msg "schema.audio.AudioEvent.volumeRandom.doc" {
    text="При каждом запуске звук тише не больше чем на эту долю."
  }
  msg "schema.audio.AudioListener2D" {
    text="Слушатель звука 2D"
  }
  msg "schema.audio.AudioListener2D.active" {
    text="Активен"
  }
  msg "schema.audio.AudioListener2D.active.doc" {
    text="Используется первый активный слушатель в иерархии."
  }
  msg "schema.audio.AudioListener2D.doc" {
    text="Слышит пространственный звук со своего узла. Без него слушает камера главного выхода."
  }
  msg "schema.audio.AudioSource2D" {
    text="Источник звука 2D"
  }
  msg "schema.audio.AudioSource2D.bus" {
    text="Шина"
  }
  msg "schema.audio.AudioSource2D.bus.doc" {
    text="Шина микшера."
  }
  msg "schema.audio.AudioSource2D.clip" {
    text="Клип"
  }
  msg "schema.audio.AudioSource2D.clip.doc" {
    text="Звук для воспроизведения; не используется, если задано Событие."
  }
  msg "schema.audio.AudioSource2D.doc" {
    text="Воспроизводит клип или звуковое событие со своего узла."
  }
  msg "schema.audio.AudioSource2D.event" {
    text="Событие"
  }
  msg "schema.audio.AudioSource2D.event.doc" {
    text="Звуковое событие вместо клипа; его настройки заменяют поля ниже."
  }
  msg "schema.audio.AudioSource2D.loop" {
    text="Повтор"
  }
  msg "schema.audio.AudioSource2D.loop.doc" {
    text="Повторяется, пока не остановлен."
  }
  msg "schema.audio.AudioSource2D.maxDistance" {
    text="Макс. расстояние"
  }
  msg "schema.audio.AudioSource2D.maxDistance.doc" {
    text="С этого расстояния не слышен, в мировых единицах."
  }
  msg "schema.audio.AudioSource2D.minDistance" {
    text="Мин. расстояние"
  }
  msg "schema.audio.AudioSource2D.minDistance.doc" {
    text="Полная громкость до этого расстояния, в мировых единицах."
  }
  msg "schema.audio.AudioSource2D.pan" {
    text="Панорама"
  }
  msg "schema.audio.AudioSource2D.pan.doc" {
    text="От −1 (слева) до 1 (справа), для непространственного звука."
  }
  msg "schema.audio.AudioSource2D.panWidth" {
    text="Ширина панорамы"
  }
  msg "schema.audio.AudioSource2D.panWidth.doc" {
    text="Насколько сдвигается пространственный звук на макс. расстоянии сбоку: 0 — остаётся по центру, 1 — полностью влево или вправо."
  }
  msg "schema.audio.AudioSource2D.pauseWith" {
    text="Пауза вместе с"
  }
  msg "schema.audio.AudioSource2D.pauseWith.doc" {
    text="game встаёт на паузу вместе с миром, never продолжает играть."
  }
  msg "schema.audio.AudioSource2D.pitch" {
    text="Высота тона"
  }
  msg "schema.audio.AudioSource2D.pitch.doc" {
    text="Скорость и высота тона вместе: 1 — обычная, 2 — на октаву выше и вдвое быстрее."
  }
  msg "schema.audio.AudioSource2D.playOnStart" {
    text="Запуск при старте"
  }
  msg "schema.audio.AudioSource2D.playOnStart.doc" {
    text="Играет с начала игры."
  }
  msg "schema.audio.AudioSource2D.playing" {
    text="Играет"
  }
  msg "schema.audio.AudioSource2D.playing.doc" {
    text="Истина, пока играет звук этого источника."
  }
  msg "schema.audio.AudioSource2D.position" {
    text="Позиция"
  }
  msg "schema.audio.AudioSource2D.position.doc" {
    text="Секунды от начала звука."
  }
  msg "schema.audio.AudioSource2D.rolloff" {
    text="Затухание"
  }
  msg "schema.audio.AudioSource2D.rolloff.doc" {
    text="Громкость от мин. расстояния (время 0) до макс. расстояния (время 1)."
  }
  msg "schema.audio.AudioSource2D.spatial" {
    text="Пространственный"
  }
  msg "schema.audio.AudioSource2D.spatial.doc" {
    text="Затухает и смещается с расстоянием до слушателя."
  }
  msg "schema.audio.AudioSource2D.volume" {
    text="Громкость"
  }
  msg "schema.audio.AudioSource2D.volume.doc" {
    text="Громкость до шины: 0 — тишина, 1 — клип как записан."
  }
  msg "schema.audio.AudioZone2D" {
    text="Звуковая зона 2D"
  }
  msg "schema.audio.AudioZone2D.area" {
    text="Область"
  }
  msg "schema.audio.AudioZone2D.area.doc" {
    text="Прямоугольник в пространстве этого узла."
  }
  msg "schema.audio.AudioZone2D.bus" {
    text="Шина"
  }
  msg "schema.audio.AudioZone2D.bus.doc" {
    text="Шина, громкость которой меняет зона."
  }
  msg "schema.audio.AudioZone2D.doc" {
    text="Пока слушатель в Области, громкость Шины равна Уровню."
  }
  msg "schema.audio.AudioZone2D.fadeTime" {
    text="Время перехода"
  }
  msg "schema.audio.AudioZone2D.fadeTime.doc" {
    text="Секунды на плавный вход в зону и выход из неё."
  }
  msg "schema.audio.AudioZone2D.gain" {
    text="Уровень"
  }
  msg "schema.audio.AudioZone2D.gain.doc" {
    text="Громкость шины внутри зоны, от 0 до 1."
  }
  msg "schema.audio.AudioZone2D.priority" {
    text="Приоритет"
  }
  msg "schema.audio.AudioZone2D.priority.doc" {
    text="Из пересекающихся зон одной шины побеждает высший приоритет, затем та, в которую вошли позже."
  }
  msg "schema.camera.CameraBrain2D" {
    text="Мозг камеры 2D"
  }
  msg "schema.camera.CameraBrain2D.doc" {
    text="Выбирает, какой выход виртуальных камер управляет этой Камерой 2D. Без него камера показывает главный выход."
  }
  msg "schema.camera.CameraBrain2D.output" {
    text="Выход"
  }
  msg "schema.camera.CameraBrain2D.output.doc" {
    text="Имя выхода; этой камерой управляют виртуальные камеры с тем же Выходом."
  }
  msg "schema.camera.CameraFollow2D" {
    text="Слежение камеры 2D"
  }
  msg "schema.camera.CameraFollow2D.damping" {
    text="Демпфирование"
  }
  msg "schema.camera.CameraFollow2D.damping.doc" {
    text="Как быстро камера догоняет цель, в секунду по каждой оси. 0 — следует жёстко."
  }
  msg "schema.camera.CameraFollow2D.deadzone" {
    text="Мёртвая зона"
  }
  msg "schema.camera.CameraFollow2D.deadzone.doc" {
    text="Часть вида, в долях 0..1 его ширины и высоты, где цель двигается, не сдвигая камеру."
  }
  msg "schema.camera.CameraFollow2D.doc" {
    text="Двигает свою виртуальную камеру за Целью, с мёртвой зоной, демпфированием и упреждением."
  }
  msg "schema.camera.CameraFollow2D.lookahead" {
    text="Упреждение"
  }
  msg "schema.camera.CameraFollow2D.lookahead.doc" {
    text="На сколько секунд скорости цели камера смотрит вперёд по каждой оси."
  }
  msg "schema.camera.CameraFollow2D.lookaheadSmoothing" {
    text="Сглаживание упреждения"
  }
  msg "schema.camera.CameraFollow2D.lookaheadSmoothing.doc" {
    text="Как быстро меняется упреждение, в секунду. 0 — сразу."
  }
  msg "schema.camera.CameraFollow2D.maxLookahead" {
    text="Макс. упреждение"
  }
  msg "schema.camera.CameraFollow2D.maxLookahead.doc" {
    text="Наибольшее упреждение в мировых единицах по каждой оси. 0 — без ограничения."
  }
  msg "schema.camera.CameraFollow2D.snapDistance" {
    text="Расстояние скачка"
  }
  msg "schema.camera.CameraFollow2D.snapDistance.doc" {
    text="Скачок цели длиннее этого, в мировых единицах, переносит камеру сразу. 0 — никогда."
  }
  msg "schema.camera.CameraFollow2D.target" {
    text="Цель"
  }
  msg "schema.camera.CameraFollow2D.target.doc" {
    text="Узел, за которым следить; берётся его интерполированная позиция."
  }
  msg "schema.camera.CameraShake2D" {
    text="Тряска камеры 2D"
  }
  msg "schema.camera.CameraShake2D.decay" {
    text="Затухание"
  }
  msg "schema.camera.CameraShake2D.decay.doc" {
    text="Сколько травмы теряется в секунду."
  }
  msg "schema.camera.CameraShake2D.doc" {
    text="Настраивает тряску своей виртуальной камеры. Тряска растёт с травмой и затихает со временем."
  }
  msg "schema.camera.CameraShake2D.exponent" {
    text="Степень"
  }
  msg "schema.camera.CameraShake2D.exponent.doc" {
    text="Тряска — травма в этой степени: при 2 слабые удары почти незаметны."
  }
  msg "schema.camera.CameraShake2D.frequency" {
    text="Частота"
  }
  msg "schema.camera.CameraShake2D.frequency.doc" {
    text="Как быстро меняется тряска, в шагах шума в секунду."
  }
  msg "schema.camera.CameraShake2D.maxAngle" {
    text="Макс. угол"
  }
  msg "schema.camera.CameraShake2D.maxAngle.doc" {
    text="Наибольший поворот в радианах при полной травме."
  }
  msg "schema.camera.CameraShake2D.maxOffset" {
    text="Макс. смещение"
  }
  msg "schema.camera.CameraShake2D.maxOffset.doc" {
    text="Наибольшее смещение в мировых единицах при полной травме."
  }
  msg "schema.camera.CameraZone2D" {
    text="Зона камеры 2D"
  }
  msg "schema.camera.CameraZone2D.area" {
    text="Область"
  }
  msg "schema.camera.CameraZone2D.area.doc" {
    text="Прямоугольник срабатывания в пространстве этого узла."
  }
  msg "schema.camera.CameraZone2D.bounds" {
    text="Границы"
  }
  msg "schema.camera.CameraZone2D.bounds.doc" {
    text="Прямоугольник в мире вместо границ камеры."
  }
  msg "schema.camera.CameraZone2D.camera" {
    text="Камера"
  }
  msg "schema.camera.CameraZone2D.camera.doc" {
    text="Виртуальная камера, которую включает зона. Пусто — камера на этом узле."
  }
  msg "schema.camera.CameraZone2D.doc" {
    text="Пока Цель в Области, Камера получает Приоритет, масштаб и границы зоны."
  }
  msg "schema.camera.CameraZone2D.priority" {
    text="Приоритет"
  }
  msg "schema.camera.CameraZone2D.priority.doc" {
    text="Приоритет камеры, пока цель внутри."
  }
  msg "schema.camera.CameraZone2D.target" {
    text="Цель"
  }
  msg "schema.camera.CameraZone2D.target.doc" {
    text="Узел, на который срабатывает зона. Пусто — цель слежения камеры зоны."
  }
  msg "schema.camera.CameraZone2D.useBounds" {
    text="Использовать границы"
  }
  msg "schema.camera.CameraZone2D.useBounds.doc" {
    text="Заменяет границы камеры, пока действует зона."
  }
  msg "schema.camera.CameraZone2D.zoom" {
    text="Масштаб"
  }
  msg "schema.camera.CameraZone2D.zoom.doc" {
    text="Масштаб, пока действует зона. 0 — масштаб камеры."
  }
  msg "schema.camera.VirtualCamera2D" {
    text="Виртуальная камера 2D"
  }
  msg "schema.camera.VirtualCamera2D.blendCurve" {
    text="Кривая перехода"
  }
  msg "schema.camera.VirtualCamera2D.blendCurve.doc" {
    text="Форма перехода; её время растягивается на Время перехода."
  }
  msg "schema.camera.VirtualCamera2D.blendTime" {
    text="Время перехода"
  }
  msg "schema.camera.VirtualCamera2D.blendTime.doc" {
    text="Секунды плавного перехода на эту камеру, когда она становится активной. 0 — резкая смена."
  }
  msg "schema.camera.VirtualCamera2D.bounds" {
    text="Границы"
  }
  msg "schema.camera.VirtualCamera2D.bounds.doc" {
    text="Прямоугольник в мире, внутри которого остаётся вид. Если он меньше вида, вид центрируется на нём."
  }
  msg "schema.camera.VirtualCamera2D.doc" {
    text="Положение камеры, которое может выбрать мозг. Побеждает высший приоритет; переключение плавно уходит от текущего вида."
  }
  msg "schema.camera.VirtualCamera2D.output" {
    text="Выход"
  }
  msg "schema.camera.VirtualCamera2D.output.doc" {
    text="Выход, которым управляет эта камера. Пусто — главный выход; Камера 2D выбирает другой через Мозг камеры 2D."
  }
  msg "schema.camera.VirtualCamera2D.priority" {
    text="Приоритет"
  }
  msg "schema.camera.VirtualCamera2D.priority.doc" {
    text="Выходом управляет включённая виртуальная камера с высшим приоритетом."
  }
  msg "schema.camera.VirtualCamera2D.snapToPixels" {
    text="Привязка к пикселям"
  }
  msg "schema.camera.VirtualCamera2D.snapToPixels.doc" {
    text="Округляет итоговую позицию до целых пикселей экрана. Камеры pixelPerfect делают это и так."
  }
  msg "schema.camera.VirtualCamera2D.timeDomain" {
    text="Шкала времени"
  }
  msg "schema.camera.VirtualCamera2D.timeDomain.doc" {
    text="unscaled переходит и трясёт по реальному времени, в том числе при стоп-кадре от удара и паузе; game следует масштабу времени."
  }
  msg "schema.camera.VirtualCamera2D.useBounds" {
    text="Использовать границы"
  }
  msg "schema.camera.VirtualCamera2D.useBounds.doc" {
    text="Держит видимую область внутри Границ."
  }
  msg "schema.camera.VirtualCamera2D.zoom" {
    text="Масштаб"
  }
  msg "schema.camera.VirtualCamera2D.zoom.doc" {
    text="Пикселей на мировую единицу, пока эта камера активна. 0 — масштаб Камеры 2D."
  }
  msg "schema.category.Runtime" {
    text="Во время игры"
  }
  msg "schema.engine.Camera2D" {
    text="Камера 2D"
  }
  msg "schema.engine.Camera2D.active" {
    text="Активен"
  }
  msg "schema.engine.Camera2D.active.doc" {
    text="Рисуют только активные камеры."
  }
  msg "schema.engine.Camera2D.clear" {
    text="Очистка"
  }
  msg "schema.engine.Camera2D.clear.doc" {
    text="Очищает область вывода перед отрисовкой."
  }
  msg "schema.engine.Camera2D.clearColor" {
    text="Цвет очистки"
  }
  msg "schema.engine.Camera2D.clearColor.doc" {
    text="Цвет фона, когда очистка включена."
  }
  msg "schema.engine.Camera2D.doc" {
    text="Рисует ортогональный вид из трансформации узла."
  }
  msg "schema.engine.Camera2D.mask" {
    text="Маска"
  }
  msg "schema.engine.Camera2D.mask.doc" {
    text="Слои видимости, которые рисует эта камера. −1 — все слои."
  }
  msg "schema.engine.Camera2D.order" {
    text="Порядок"
  }
  msg "schema.engine.Camera2D.order.doc" {
    text="Камеры с меньшим порядком рисуют первыми."
  }
  msg "schema.engine.Camera2D.scale" {
    text="Масштабирование"
  }
  msg "schema.engine.Camera2D.scale.doc" {
    text="Как вид подстраивается под окно: free, pixelPerfect или fitVirtual."
  }
  msg "schema.engine.Camera2D.viewport" {
    text="Область вывода"
  }
  msg "schema.engine.Camera2D.viewport.doc" {
    text="Часть экрана, в которую рисует камера, в нормированных координатах."
  }
  msg "schema.engine.Camera2D.virtual" {
    text="Виртуальное разрешение"
  }
  msg "schema.engine.Camera2D.virtual.doc" {
    text="Виртуальное разрешение для fitVirtual и pixelPerfect."
  }
  msg "schema.engine.Camera2D.zoom" {
    text="Масштаб"
  }
  msg "schema.engine.Camera2D.zoom.doc" {
    text="Пикселей на мировую единицу. Чем больше, тем меньшая часть мира видна."
  }
  msg "schema.engine.Camera3D" {
    text="Камера 3D"
  }
  msg "schema.engine.Camera3D.active" {
    text="Активен"
  }
  msg "schema.engine.Camera3D.active.doc" {
    text="Рисуют только активные камеры."
  }
  msg "schema.engine.Camera3D.clear" {
    text="Очистка"
  }
  msg "schema.engine.Camera3D.clear.doc" {
    text="Очищает область вывода перед отрисовкой."
  }
  msg "schema.engine.Camera3D.clearColor" {
    text="Цвет очистки"
  }
  msg "schema.engine.Camera3D.clearColor.doc" {
    text="Цвет фона, когда очистка включена."
  }
  msg "schema.engine.Camera3D.doc" {
    text="Рисует перспективный вид вдоль оси −Z узла."
  }
  msg "schema.engine.Camera3D.far" {
    text="Дальняя плоскость"
  }
  msg "schema.engine.Camera3D.far.doc" {
    text="Расстояние до дальней плоскости отсечения."
  }
  msg "schema.engine.Camera3D.fov" {
    text="Угол обзора"
  }
  msg "schema.engine.Camera3D.fov.doc" {
    text="Вертикальный угол обзора в градусах."
  }
  msg "schema.engine.Camera3D.mask" {
    text="Маска"
  }
  msg "schema.engine.Camera3D.mask.doc" {
    text="Слои видимости, которые рисует эта камера. −1 — все слои."
  }
  msg "schema.engine.Camera3D.near" {
    text="Ближняя плоскость"
  }
  msg "schema.engine.Camera3D.near.doc" {
    text="Расстояние до ближней плоскости отсечения."
  }
  msg "schema.engine.Camera3D.order" {
    text="Порядок"
  }
  msg "schema.engine.Camera3D.order.doc" {
    text="Камеры с меньшим порядком рисуют первыми."
  }
  msg "schema.engine.Camera3D.orthoSize" {
    text="Ортогональный размер"
  }
  msg "schema.engine.Camera3D.orthoSize.doc" {
    text="Половина высоты вида в мировых единицах, когда включена ортогональная проекция."
  }
  msg "schema.engine.Camera3D.orthographic" {
    text="Ортогональная"
  }
  msg "schema.engine.Camera3D.orthographic.doc" {
    text="Проекция без перспективы; спрайты и меши сохраняют размер на любой глубине."
  }
  msg "schema.engine.Camera3D.viewport" {
    text="Область вывода"
  }
  msg "schema.engine.Camera3D.viewport.doc" {
