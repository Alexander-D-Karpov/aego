    text="Здоровье"
  }
  msg "schema.gameplay.Hurtbox2D.health.doc" {
    text="Здоровье, которое получает урон. Пусто — этот узел или ближайший родитель со Здоровьем."
  }
  msg "schema.gameplay.Hurtbox2D.multiplier" {
    text="Множитель"
  }
  msg "schema.gameplay.Hurtbox2D.multiplier.doc" {
    text="Урон здесь умножается на это значение — для уязвимых мест и брони."
