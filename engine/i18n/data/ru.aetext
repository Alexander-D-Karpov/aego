    text="Удаляет узел и его потомков в конце фазы."
  }
  msg "api.aego/scene.Find" {
    text="Возвращает узел по пути от корня сцены или nil."
  }
  msg "api.aego/scene.InArea" {
    text="Записывает в out тела, касающиеся прямоугольника, на слоях из mask. Без физики записывает все включённые 2D-узлы, позиция которых лежит в прямоугольнике, без учёта mask."
  }
  msg "api.aego/scene.Instantiate" {
    text="Создаёт экземпляр префаба под parent или под корнем, если parent равен nil.\nНовые узлы появляются в конце фазы; их скрипты получают Ready до следующего Update."
  }
  msg "api.aego/scene.Pool" {
    text="Заранее создаёт n экземпляров префаба; их Ready выполняется сразу, а Spawn берёт их позже."
  }
  msg "api.aego/scene.Spawn" {
    text="Создаёт экземпляр префаба в позиции под корнем сцены, беря его из пула, если там есть свободный."
  }
  msg "api.aego/scene.SpawnAt" {
    text="Создаёт экземпляр префаба под parent с локальной позицией и поворотом."
  }
  msg "api.aego/scene.WithComponent" {
    text="Записывает в out включённые узлы с этим компонентом и возвращает их число."
  }
  msg "api.aego/scene.WithTag" {
    text="Записывает в out включённые узлы с тегом и возвращает их число; Enemy находит и Enemy.Flying. Узлы идут в том порядке, в каком получили тег."
  }
  msg "api.aego/settings.Apply" {
    text="Применяет все подготовленные значения разом; если одно не применяется, не меняется ни одно."
  }
  msg "api.aego/settings.ClearOverride" {
    text="Убирает переопределение на сеанс."
  }
  msg "api.aego/settings.ClearOverrides" {
    text="Убирает все переопределения на сеанс."
  }
  msg "api.aego/settings.CloseView" {
    text="Скрывает экран настроек."
  }
  msg "api.aego/settings.GetBool" {
    text="Возвращает действующее значение настройки-переключателя."
  }
  msg "api.aego/settings.GetFloat" {
    text="Возвращает действующее значение числовой настройки."
  }
  msg "api.aego/settings.GetInt" {
    text="Возвращает действующее значение целочисленной настройки или настройки с выбором."
  }
  msg "api.aego/settings.GetString" {
    text="Возвращает текстовую настройку или имя текущего варианта."
  }
  msg "api.aego/settings.NeedsRestart" {
    text="Сообщает, вступит ли применённая настройка в силу только после перезапуска."
  }
  msg "api.aego/settings.OpenView" {
    text="Показывает экран настроек и ставит игру на паузу, пока он не закроется."
  }
  msg "api.aego/settings.OverrideBool" {
    text="Задаёт значение переключателя только на этот сеанс."
  }
  msg "api.aego/settings.OverrideFloat" {
    text="Задаёт значение только на этот сеанс; оно никогда не сохраняется."
  }
  msg "api.aego/settings.OverrideInt" {
    text="Задаёт целое число только на этот сеанс."
  }
  msg "api.aego/settings.OverrideString" {
    text="Задаёт текстовое значение только на этот сеанс."
  }
  msg "api.aego/settings.Reset" {
    text="Подготавливает возврат к значению проекта по умолчанию."
  }
  msg "api.aego/settings.Revert" {
    text="Отбрасывает подготовленные значения."
  }
  msg "api.aego/settings.Save" {
    text="Сразу записывает профиль игрока; он также сохраняется сам вскоре после изменения."
  }
  msg "api.aego/settings.SetBool" {
    text="Подготавливает значение; Apply вводит его в силу."
  }
  msg "api.aego/settings.SetFloat" {
    text="Подготавливает число."
  }
  msg "api.aego/settings.SetInt" {
    text="Подготавливает целое число или индекс варианта."
  }
  msg "api.aego/settings.SetString" {
    text="Подготавливает текстовое значение."
  }
  msg "api.aego/settings.ViewOpen" {
    text="Сообщает, показан ли экран настроек."
  }
  msg "api.aego/testing.Equal" {
    text="Проваливает тест, если два целых числа различаются."
  }
  msg "api.aego/testing.EqualFloat" {
    text="Проваливает тест, если got отличается от want больше чем на eps или равно NaN."
  }
  msg "api.aego/testing.EqualString" {
    text="Проваливает тест, если две строки различаются."
  }
  msg "api.aego/testing.Fail" {
    text="Останавливает тест и сообщает msg."
  }
  msg "api.aego/testing.False" {
    text="Проваливает тест с msg, если v равно true."
  }
  msg "api.aego/testing.True" {
    text="Проваливает тест с msg, если v равно false."
  }
  msg "api.aego/time.Delta" {
    text="Возвращает секунды игрового времени с прошлого кадра: реальное время × Scale, 0 на паузе. Внутри FixedUpdate равно фиксированному шагу."
  }
  msg "api.aego/time.Elapsed" {
    text="Возвращает секунды игрового времени с начала игры. Останавливается на паузе и учитывает Scale."
  }
  msg "api.aego/time.Fixed" {
    text="Возвращает длину фиксированного шага в секундах, по умолчанию 1/60. Scale её не меняет; он меняет число выполняемых шагов."
  }
  msg "api.aego/time.Frame" {
    text="Возвращает число кадров, которые прошёл этот мир, включая кадры на паузе."
  }
  msg "api.aego/time.IsPaused" {
    text="Сообщает, стоит ли игровое время на паузе."
  }
  msg "api.aego/time.Scale" {
    text="Возвращает масштаб времени: 1 — обычная скорость, 0.5 — половина, 0 замораживает игровое время без паузы."
  }
  msg "api.aego/time.SetPaused" {
    text="Ставит на паузу или продолжает игровое время. На паузе Update, FixedUpdate и корутины игрового времени обычных скриптов не выполняются."
  }
  msg "api.aego/time.SetScale" {
    text="Задаёт масштаб времени от 0 до 8. Фиксированный шаг не меняется, поэтому симуляция остаётся стабильной; меняется только число шагов."
  }
  msg "api.aego/time.Tick" {
    text="Возвращает номер текущего или последнего фиксированного шага. Тот же номер показывают профилировщик и Монитор событий."
  }
  msg "api.aego/time.Unscaled" {
    text="Возвращает реальные секунды с прошлого кадра без учёта Scale и паузы."
  }
  msg "api.aego/time.UnscaledElapsed" {
    text="Возвращает реальные секунды с начала игры, включая паузы."
  }
  msg "api.aego/timer.Cooldown" {
    text="Создаёт таймер, который сразу готов; Use забирает его и начинает ожидание."
  }
  msg "api.aego/timer.New" {
    text="Создаёт таймер, который остаётся после окончания, так что Restart может запустить его снова."
  }
  msg "api.aego/timer.Start" {
    text="Создаёт одноразовый таймер, который освобождается после срабатывания."
  }
  msg "api.aego/timer.Timer" {
    text="Timer отсчитывает время и срабатывает. yield t ждёт следующего срабатывания или конца; таймер исчезает вместе с узлом скрипта, который его создал."
  }
  msg "api.aego/timer.Timer.Cancel" {
    text="Завершает таймер без срабатывания."
  }
  msg "api.aego/timer.Timer.Count" {
    text="Возвращает, сколько раз таймер сработал."
  }
  msg "api.aego/timer.Timer.Done" {
    text="Сообщает, закончился ли таймер, был ли он отменён или равен nil."
  }
  msg "api.aego/timer.Timer.Fired" {
    text="Вызывается при каждом срабатывании таймера; count — число срабатываний на этот момент."
  }
  msg "api.aego/timer.Timer.Pause" {
    text="Останавливает отсчёт."
  }
  msg "api.aego/timer.Timer.Ready" {
    text="Сообщает, можно ли использовать перезарядку."
  }
  msg "api.aego/timer.Timer.Remaining" {
    text="Возвращает секунды до следующего срабатывания."
  }
  msg "api.aego/timer.Timer.Repeat" {
    text="Заставляет таймер сработать n раз; -1 повторяет до Cancel."
  }
  msg "api.aego/timer.Timer.Restart" {
    text="Запускает отсчёт заново; ничего не делает с одноразовым таймером, который уже сработал."
  }
  msg "api.aego/timer.Timer.Resume" {
    text="Продолжает отсчёт после паузы."
  }
  msg "api.aego/timer.Timer.Unscaled" {
    text="Считает реальное время, в том числе пока игра на паузе."
  }
  msg "api.aego/timer.Timer.Use" {
    text="Забирает готовую перезарядку и начинает её ожидание; возвращает false, пока перезарядка идёт."
  }
  msg "api.aego/tween.Position" {
    text="Перемещает 2D-узел в локальную позицию."
  }
  msg "api.aego/tween.ToColor" {
    text="Анимирует свойство Color."
  }
  msg "api.aego/tween.ToFloat" {
    text="Анимирует свойство float или int либо одну компоненту вектора или цвета.\nПути: Component.Field, Component.Field.a, transform.rotation, script/Name.Field."
  }
  msg "api.aego/tween.ToQuat" {
    text="Поворачивает вращение по короткой дуге."
  }
  msg "api.aego/tween.ToVec2" {
    text="Анимирует свойство Vec2."
  }
  msg "api.aego/tween.ToVec3" {
    text="Анимирует свойство Vec3, например позицию 3D-узла."
  }
  msg "api.aego/tween.Tween" {
    text="Tween анимирует одно свойство узла. Законченный, остановленный или равный nil твин считается завершённым; yield t ждёт, пока он не закончится."
  }
  msg "api.aego/tween.Tween.Completed" {
    text="Вызывается один раз, когда твин заканчивается. Его параметр finished равен true при естественном окончании и false после Stop, когда его заменил новый твин того же свойства или когда его узла или цели больше нет."
  }
  msg "api.aego/tween.Tween.Curve" {
    text="Заменяет плавность полем-кривой; диапазон времени кривой растягивается на длительность."
  }
  msg "api.aego/tween.Tween.Delay" {
    text="Ждёт перед началом твина; начальное значение читается в конце задержки. Вызывается сразу после создания твина."
  }
  msg "api.aego/tween.Tween.Done" {
    text="Сообщает, закончился ли твин, был ли он остановлен или равен nil."
  }
  msg "api.aego/tween.Tween.Loop" {
    text="Проигрывает твин n раз с начала; -1 повторяет до Stop."
  }
  msg "api.aego/tween.Tween.PingPong" {
    text="Проигрывает n проходов, каждый второй — в обратную сторону; 2 — туда и обратно, -1 повторяет до Stop."
  }
  msg "api.aego/tween.Tween.Running" {
    text="Противоположность Done."
  }
  msg "api.aego/tween.Tween.Stop" {
    text="Завершает твин на месте; свойство сохраняет текущее значение."
  }
  msg "api.aego/tween.Tween.Unscaled" {
    text="Выполняет твин в реальном времени, в том числе пока игра на паузе."
  }
  msg "api.aego/update.Apply" {
    text="Устанавливает скачанную версию и перезапускает на ней игру; сначала сохраните прогресс игрока."
  }
  msg "api.aego/update.Check" {
    text="Ищет в фоне новую версию на сервере обновлений игры; State сообщает, что найдено."
  }
  msg "api.aego/update.Download" {
    text="Скачивает новую версию в фоне; в режиме Auto это происходит само."
  }
  msg "api.aego/update.Error" {
    text="Сообщает, почему не удалась последняя проверка или загрузка."
  }
  msg "api.aego/update.Notes" {
    text="Описание изменений новой версии."
  }
  msg "api.aego/update.State" {
    text="Состояние: idle, checking, upToDate, available, downloading, ready или failed."
  }
  msg "api.aego/update.Version" {
    text="Новая версия, найденная последней проверкой; пусто, если её нет."
  }
  msg "api.animation.AnimationPlayer.Event" {
    text="Вызывается, когда клип доходит до события; anim.EventName(id) даёт его имя."
  }
  msg "api.animation.AnimationPlayer.Finished" {
    text="Вызывается, когда незацикленный клип заканчивается, с cycle 0, или после Stop, с cycle -1."
  }
  msg "api.animation.AnimationPlayer.Pause" {
    text="Останавливает клип на текущем месте."
  }
  msg "api.animation.AnimationPlayer.Play" {
    text="Запускает клип с начала на следующем фиксированном шаге; nil заново проигрывает текущий клип."
  }
  msg "api.animation.AnimationPlayer.Resume" {
    text="Продолжает клип после паузы."
  }
  msg "api.animation.AnimationPlayer.Seek" {
    text="Переходит к моменту внутри клипа на следующем фиксированном шаге, не вызывая события между ними."
  }
  msg "api.animation.AnimationPlayer.SetSpeed" {
    text="Меняет скорость проигрывания; отрицательная скорость проигрывает назад."
  }
  msg "api.animation.AnimationPlayer.Stop" {
    text="Завершает клип на следующем фиксированном шаге: дорожки с onEnd=restore получают значения, которые были до Play, Finished вызывается с cycle -1."
  }
  msg "api.animation.Animator.CrossFade" {
    text="Плавно переходит в состояние за несколько секунд, начиная со следующего фиксированного шага."
  }
  msg "api.animation.Animator.Event" {
    text="Вызывается, когда состояние доходит до события своего клипа; во время смешивания политика событий состояния решает, какая сторона сообщает о нём."
  }
  msg "api.animation.Animator.GetBool" {
    text="Читает параметр bool или trigger."
  }
  msg "api.animation.Animator.GetFloat" {
    text="Читает параметр float."
  }
  msg "api.animation.Animator.GetInt" {
    text="Читает параметр int."
  }
  msg "api.animation.Animator.IsState" {
    text="Сообщает, находится ли аниматор в состоянии; во время смешивания это состояние, в которое идёт переход."
  }
  msg "api.animation.Animator.Play" {
    text="Переключает на состояние на следующем фиксированном шаге, без смешивания."
  }
  msg "api.animation.Animator.ResetTrigger" {
    text="Сбрасывает триггер, который ещё не сработал."
  }
  msg "api.animation.Animator.SetBool" {
    text="Задаёт параметр bool; переходы читают его на следующем фиксированном шаге."
  }
  msg "api.animation.Animator.SetFloat" {
    text="Задаёт параметр float."
  }
  msg "api.animation.Animator.SetInt" {
    text="Задаёт параметр int."
  }
  msg "api.animation.Animator.SetTrigger" {
    text="Взводит триггер на следующий фиксированный шаг; его сбрасывает переход, который его использует, или конец этого шага."
  }
  msg "api.animation.Animator.StateEntered" {
    text="Вызывается, когда аниматор входит в состояние, в начале перехода."
  }
  msg "api.animation.Animator.StateExited" {
    text="Вызывается, когда состояние перестаёт проигрываться, в конце перехода."
  }
