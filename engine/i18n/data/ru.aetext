    text="Убирает узел через несколько секунд: в пул или уничтожает."
  }
  msg "schema.gameplay.Lifetime.remaining" {
    text="Осталось"
  }
  msg "schema.gameplay.Lifetime.remaining.doc" {
    text="Осталось секунд."
  }
  msg "schema.gameplay.Lifetime.seconds" {
    text="Секунды"
  }
  msg "schema.gameplay.Lifetime.seconds.doc" {
    text="Сколько секунд живёт узел."
  }
  msg "schema.gameplay.Lifetime.unscaled" {
    text="Реальное время"
  }
  msg "schema.gameplay.Lifetime.unscaled.doc" {
    text="Считает реальное время, в том числе на паузе и при замедлении."
  }
  msg "schema.gameplay.Motion2D" {
    text="Движение 2D"
  }
  msg "schema.gameplay.Motion2D.accel" {
    text="Ускорение"
  }
  msg "schema.gameplay.Motion2D.accel.doc" {
    text="Как быстро скорость растёт к целевой, в единицах в секунду за секунду."
  }
