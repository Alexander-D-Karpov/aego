    text="Предыдущее"
  }
  msg "schema.gameplay.StateMachine.previous.doc" {
    text="Состояние до последней смены."
  }
  msg "schema.gameplay.StateMachine.states" {
    text="Состояния"
  }
  msg "schema.gameplay.StateMachine.states.doc" {
    text="Имена состояний, они же суффиксы методов-обработчиков."
  }
  msg "schema.gameplay.StateMachine.time" {
    text="Время"
  }
  msg "schema.gameplay.StateMachine.time.doc" {
    text="Секунды фиксированных шагов в текущем состоянии."
  }
  msg "schema.physics.Body2D" {
    text="Тело 2D"
  }
  msg "schema.physics.Body2D.allowSleep" {
    text="Разрешить сон"
  }
  msg "schema.physics.Body2D.allowSleep.doc" {
    text="Позволяет телу засыпать в покое, это экономит время; контакты и скрипты его будят."
  }
  msg "schema.physics.Body2D.angularDamping" {
    text="Угловое затухание"
  }
  msg "schema.physics.Body2D.angularDamping.doc" {
    text="Замедляет вращение каждый шаг; 0 — вращение не затухает."
  }
