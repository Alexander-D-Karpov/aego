    text="Переносит персонажа вместе с телом, на котором он стоит."
  }
  msg "schema.gameplay.Motion2D.onCeiling" {
    text="У потолка"
  }
  msg "schema.gameplay.Motion2D.onCeiling.doc" {
    text="Касался ли персонаж потолка на последнем шаге."
  }
  msg "schema.gameplay.Motion2D.onWall" {
    text="У стены"
  }
  msg "schema.gameplay.Motion2D.onWall.doc" {
    text="Касался ли персонаж стены на последнем шаге."
  }
  msg "schema.gameplay.Motion2D.platformOnLeave" {
    text="Платформа при уходе"
  }
  msg "schema.gameplay.Motion2D.platformOnLeave.doc" {
    text="keep сохраняет скорость платформы после схода с неё, drop теряет её, add сохраняет только горизонтальную часть."
  }
  msg "schema.gameplay.Motion2D.pushBodies" {
    text="Толкать тела"
  }
  msg "schema.gameplay.Motion2D.pushBodies.doc" {
    text="Проходит сквозь динамические тела и толкает их, а не останавливается."
  }
