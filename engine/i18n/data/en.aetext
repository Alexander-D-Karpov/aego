    text="Cuts a rising jump by Jump Cut Multiplier."
  }
  msg "api.gameplay.Motion2D.Jumped" {
    text="Fires when a jump starts."
  }
  msg "api.gameplay.Motion2D.Landed" {
    text="Fires when the character touches a floor, with the falling speed."
  }
  msg "api.gameplay.Motion2D.LeftGround" {
    text="Fires when the character walks off a floor without jumping."
  }
  msg "api.gameplay.Motion2D.Move" {
    text="Sets the horizontal input, -1..1; it stays until the next Move."
  }
  msg "api.gameplay.Motion2D.MoveDir" {
    text="Sets the top-down input; a longer vector is cut to length 1."
  }
  msg "api.gameplay.Motion2D.Stop" {
    text="Zeroes the velocity and ends a dash."
  }
  msg "api.gameplay.Motion2D.Teleport" {
    text="Moves to a position on the next step and resets velocity and state."
  }
  msg "api.gameplay.Pickup2D.Collected" {
