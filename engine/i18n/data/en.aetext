  }
  msg "api.gameplay.Respawn.Respawned" {
    text="Fires when the node is back at its point."
  }
  msg "api.gameplay.Respawn.SetPoint" {
    text="Sets the respawn point."
  }
  msg "api.gameplay.Respawn.Trigger" {
    text="Respawns the node after Delay."
  }
  msg "api.gameplay.StateMachine.Changed" {
