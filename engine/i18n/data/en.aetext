  }
  msg "schema.gameplay.Lifetime" {
    text="Lifetime"
  }
  msg "schema.gameplay.Lifetime.despawn" {
    text="Despawn"
  }
  msg "schema.gameplay.Lifetime.despawn.doc" {
    text="Returns the node to its pool instead of destroying it."
  }
  msg "schema.gameplay.Lifetime.doc" {
    text="Removes the node after some seconds: back to its pool or destroyed."
  }
  msg "schema.gameplay.Lifetime.remaining" {
    text="Remaining"
  }
  msg "schema.gameplay.Lifetime.remaining.doc" {
    text="Seconds left."
  }
  msg "schema.gameplay.Lifetime.seconds" {
    text="Seconds"
  }
