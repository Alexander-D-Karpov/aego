    text="On Ceiling"
  }
  msg "schema.gameplay.Motion2D.onCeiling.doc" {
    text="Whether the character touched a ceiling in the last step."
  }
  msg "schema.gameplay.Motion2D.onWall" {
    text="On Wall"
  }
  msg "schema.gameplay.Motion2D.onWall.doc" {
    text="Whether the character touched a wall in the last step."
  }
