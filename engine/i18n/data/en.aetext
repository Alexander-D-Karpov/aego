    text="A checkpoint does not replace one with a higher priority."
  }
  msg "schema.gameplay.Checkpoint2D.spawnPoint" {
    text="Spawn Point"
  }
  msg "schema.gameplay.Checkpoint2D.spawnPoint.doc" {
    text="Node whose position becomes the respawn point. Empty uses this checkpoint's position."
  }
  msg "schema.gameplay.Health" {
    text="Health"
  }
  msg "schema.gameplay.Health.current" {
    text="Current"
  }
  msg "schema.gameplay.Health.current.doc" {
    text="Hit points now."
  }
  msg "schema.gameplay.Health.dead" {
    text="Dead"
  }
  msg "schema.gameplay.Health.dead.doc" {
    text="True from death until Revive."
  }
