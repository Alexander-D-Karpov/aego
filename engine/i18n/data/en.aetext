  }
  msg "api.aego/tween.Tween" {
    text="Tween animates one property of a node. A finished, stopped or nil tween reads as done; yield t waits until it ends."
  }
  msg "api.aego/tween.Tween.Completed" {
    text="Runs once when the tween ends. Its finished parameter is true at the natural end, false after Stop, when a new tween on the same property replaced it, or when its node or target is gone."
  }
  msg "api.aego/tween.Tween.Curve" {
    text="Replaces the easing with a curve field; its time range is stretched over the duration."
  }
  msg "api.aego/tween.Tween.Delay" {
    text="Waits before the tween starts; the start value is read when the delay ends. Call it right after creating the tween."
  }
  msg "api.aego/tween.Tween.Done" {
    text="Reports whether the tween finished, was stopped or is nil."
  }
  msg "api.aego/tween.Tween.Loop" {
    text="Plays the tween n times from the start; -1 repeats until Stop."
  }
  msg "api.aego/tween.Tween.PingPong" {
    text="Plays n legs, every second one backwards; 2 goes there and back, -1 repeats until Stop."
  }
  msg "api.aego/tween.Tween.Running" {
    text="Is the opposite of Done."
  }
  msg "api.aego/tween.Tween.Stop" {
    text="Ends the tween where it is; the property keeps its current value."
  }
  msg "api.aego/tween.Tween.Unscaled" {
    text="Runs the tween in real time, also while the game is paused."
  }
  msg "api.aego/update.Apply" {
    text="Installs the downloaded version and restarts the game on it; save the player's progress first."
  }
  msg "api.aego/update.Check" {
    text="Looks for a newer version on the game's update server in the background; State says what it found."
  }
  msg "api.aego/update.Download" {
    text="Fetches the newer version in the background; Auto mode does it on its own."
  }
  msg "api.aego/update.Error" {
    text="Says why the last check or download failed."
  }
  msg "api.aego/update.Notes" {
    text="Notes are the release notes of the newer version."
  }
  msg "api.aego/update.State" {
    text="Is idle, checking, upToDate, available, downloading, ready or failed."
  }
  msg "api.aego/update.Version" {
    text="Is the newer version the last check found, empty when there is none."
  }
  msg "api.animation.AnimationPlayer.Event" {
    text="Runs when the clip reaches an event; anim.EventName(id) gives its name."
  }
  msg "api.animation.AnimationPlayer.Finished" {
    text="Runs when a clip that does not loop ends, with cycle 0, or after Stop, with cycle -1."
  }
  msg "api.animation.AnimationPlayer.Pause" {
    text="Holds the clip where it is."
  }
  msg "api.animation.AnimationPlayer.Play" {
    text="Starts a clip from its beginning on the next fixed step; nil plays the current clip again."
  }
  msg "api.animation.AnimationPlayer.Resume" {
    text="Continues a paused clip."
  }
  msg "api.animation.AnimationPlayer.Seek" {
    text="Jumps to a time inside the clip on the next fixed step without firing the events in between."
  }
  msg "api.animation.AnimationPlayer.SetSpeed" {
    text="Changes the playback speed; a negative speed plays backwards."
  }
  msg "api.animation.AnimationPlayer.Stop" {
    text="Ends the clip on the next fixed step: tracks with onEnd=restore get back the values they had before Play, Finished runs with cycle -1."
  }
  msg "api.animation.Animator.CrossFade" {
    text="Blends into a state over some seconds, starting on the next fixed step."
  }
  msg "api.animation.Animator.Event" {
    text="Runs when a state reaches an event of its clip; during a blend the state's event policy decides which side reports."
  }
  msg "api.animation.Animator.GetBool" {
    text="Reads a bool or trigger parameter."
  }
  msg "api.animation.Animator.GetFloat" {
    text="Reads a float parameter."
  }
  msg "api.animation.Animator.GetInt" {
    text="Reads an int parameter."
  }
  msg "api.animation.Animator.IsState" {
    text="Reports whether the animator is in a state; during a blend that is the state it blends into."
  }
  msg "api.animation.Animator.Play" {
    text="Switches to a state on the next fixed step, without a blend."
  }
  msg "api.animation.Animator.ResetTrigger" {
    text="Clears a trigger that has not fired yet."
  }
  msg "api.animation.Animator.SetBool" {
    text="Sets a bool parameter; transitions read it on the next fixed step."
  }
  msg "api.animation.Animator.SetFloat" {
    text="Sets a float parameter."
  }
  msg "api.animation.Animator.SetInt" {
    text="Sets an int parameter."
  }
  msg "api.animation.Animator.SetTrigger" {
    text="Sets a trigger for the next fixed step; a transition that uses it, or the end of that step, clears it."
  }
  msg "api.animation.Animator.StateEntered" {
    text="Runs when the animator enters a state, at the start of the transition."
