    text="Seconds the node lives."
  }
  msg "schema.gameplay.Lifetime.unscaled" {
    text="Unscaled"
  }
  msg "schema.gameplay.Lifetime.unscaled.doc" {
    text="Counts real time, also while paused or slowed down."
  }
