  msg "api.audio.AudioSource2D.Started" {
    text="Runs when the source starts a sound."
  }
  msg "api.audio.AudioSource2D.Stop" {
    text="Ends the sound of the source with a short fade."
  }
  msg "api.audio.AudioSource2D.StopFade" {
    text="Fades the sound of the source out over seconds."
  }
  msg "api.camera.CameraFollow2D.Snap" {
