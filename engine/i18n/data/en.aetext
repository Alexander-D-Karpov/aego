  }
  msg "api.engine.MaterialOverride.SetColor" {
    text="Sets a linear Color instance parameter declared with the color hint."
  }
  msg "api.engine.MaterialOverride.SetFloat" {
    text="Sets an instance float parameter on this node. Type mismatch leaves its previous value unchanged."
  }
  msg "api.engine.MaterialOverride.SetInt" {
    text="Sets an exact signed int32 instance parameter. Values outside the int32 range are rejected."
  }
