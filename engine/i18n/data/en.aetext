    text="Knockback From Center"
  }
  msg "schema.gameplay.Hitbox2D.knockbackFromCenter.doc" {
    text="Pushes away from the hitbox centre instead, with the length of Knockback."
  }
  msg "schema.gameplay.Hitbox2D.period" {
    text="Period"
  }
  msg "schema.gameplay.Hitbox2D.period.doc" {
    text="Seconds between hits for the periodic policy."
  }
