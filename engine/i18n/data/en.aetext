  msg "api.events.OnAnimEvent" {
    text="Runs on the scripts of a node whose Animation Player reaches an event of its clip; anim.EventName(id) gives the name."
  }
  msg "api.events.OnCollisionEnter" {
    text="Runs after the physics step in which this body started touching other."
  }
  msg "api.events.OnCollisionExit" {
    text="Runs when the bodies stop touching, including when one of them is destroyed or disabled. Contact.Point is the last known point."
  }
  msg "api.events.OnCollisionStay" {
    text="Runs after every later physics step while the bodies keep touching. It costs nothing when no script declares it."
  }
  msg "api.events.OnDespawned" {
    text="Runs on every script of a pooled copy when it is despawned, before its coroutines and connections end."
  }
  msg "api.events.OnLoad" {
    text="Runs after Ready on every script that has it when a saved game is loaded; read values with save.Get*."
  }
  msg "api.events.OnSave" {
    text="Runs on every script that has it while a game is saved; write values with save.Put*."
  }
  msg "api.events.OnSettingChanged" {
    text="Runs on every script with this method after a setting's effective value changed: Apply, Revert, an override or a confirmation timeout."
  }
  msg "api.events.OnSpawned" {
    text="Runs on every script of a spawned prefab copy, after Ready for a new copy and instead of it for a copy taken from a pool."
  }
  msg "api.events.OnTriggerEnter" {
    text="Runs when other's collider entered a trigger of this body, or this body entered other's trigger."
  }
  msg "api.events.OnTriggerExit" {
    text="Runs when the overlap with a trigger ends."
  }
  msg "api.gameplay.Checkpoint2D.Reached" {
    text="Fires when a node takes this checkpoint."
  }
  msg "api.gameplay.Health.Damage" {
    text="Removes hit points and reports whether they were removed: not while invulnerable, dead or for amounts below 1."
  }
