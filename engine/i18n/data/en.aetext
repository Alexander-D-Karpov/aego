  }
  msg "schema.gameplay.Health.invulnerable" {
    text="Invulnerable"
  }
  msg "schema.gameplay.Health.invulnerable.doc" {
    text="True while damage is ignored."
  }
  msg "schema.gameplay.Health.max" {
    text="Max"
  }
  msg "schema.gameplay.Health.max.doc" {
    text="Hit points at the start and after a full revive."
  }
  msg "schema.gameplay.Health.team" {
    text="Team"
  }
  msg "schema.gameplay.Health.team.doc" {
    text="Hitboxes of the same team do not hurt this node unless they allow friendly fire."
  }
  msg "schema.gameplay.Hitbox2D" {
    text="Hitbox 2D"
  }
  msg "schema.gameplay.Hitbox2D.active" {
    text="Active"
  }
  msg "schema.gameplay.Hitbox2D.active.doc" {
    text="Off deals no damage."
  }
  msg "schema.gameplay.Hitbox2D.area" {
    text="Area"
  }
  msg "schema.gameplay.Hitbox2D.area.doc" {
    text="Rectangle in this node's space."
  }
  msg "schema.gameplay.Hitbox2D.damage" {
    text="Damage"
  }
  msg "schema.gameplay.Hitbox2D.damage.doc" {
    text="Damage per hit before the hurtbox multiplier."
  }
  msg "schema.gameplay.Hitbox2D.doc" {
    text="Damages hurtboxes inside its area, once per target per activation, on every entry or periodically."
  }
