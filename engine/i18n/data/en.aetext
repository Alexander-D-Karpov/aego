  msg "api.animation.Animator.StateExited" {
    text="Runs when a state stops playing, at the end of the transition."
  }
  msg "api.animation.Animator.StateName" {
    text="Returns the name of a state index, as StateEntered and StateExited report it."
  }
  msg "api.audio.AudioSource2D.Finished" {
