  }
  msg "schema.gameplay.Hurtbox2D.active" {
    text="Active"
  }
  msg "schema.gameplay.Hurtbox2D.active.doc" {
    text="Off ignores hits."
  }
  msg "schema.gameplay.Hurtbox2D.area" {
    text="Area"
  }
  msg "schema.gameplay.Hurtbox2D.area.doc" {
    text="Rectangle in this node's space."
  }
  msg "schema.gameplay.Hurtbox2D.doc" {
    text="Area where hitboxes damage a Health: on this node or on its nearest parent with Health."
  }
  msg "schema.gameplay.Hurtbox2D.health" {
    text="Health"
  }
  msg "schema.gameplay.Hurtbox2D.health.doc" {
    text="Health that takes the damage. Empty uses this node or its nearest parent with Health."
  }
  msg "schema.gameplay.Hurtbox2D.multiplier" {
    text="Multiplier"
  }
  msg "schema.gameplay.Hurtbox2D.multiplier.doc" {
    text="Damage taken here is multiplied by this, for weak spots and armour."
  }
  msg "schema.gameplay.Hurtbox2D.shape" {
    text="Shape"
  }
  msg "schema.gameplay.Hurtbox2D.shape.doc" {
    text="box uses the rectangle; circle uses the circle inside it."
  }
  msg "schema.gameplay.KillZone2D" {
    text="Kill Zone 2D"
  }
  msg "schema.gameplay.KillZone2D.area" {
    text="Area"
  }
  msg "schema.gameplay.KillZone2D.area.doc" {
    text="Rectangle in this node's space."
  }
  msg "schema.gameplay.KillZone2D.doc" {
    text="Kills a Health that enters the area, or respawns a node with Respawn and no Health."
