    text="Ambient Intensity"
  }
  msg "schema.engine.LightingEnvironment2D.ambientIntensity.doc" {
    text="Nonnegative ambient energy multiplier."
  }
  msg "schema.engine.LightingEnvironment2D.camera" {
    text="Camera"
  }
