    text="Fires once when the hit points reach zero."
  }
  msg "api.gameplay.Health.Heal" {
    text="Adds hit points up to Max; it does nothing while dead."
  }
  msg "api.gameplay.Health.Healed" {
    text="Fires with the hit points restored."
  }
  msg "api.gameplay.Health.Kill" {
    text="Sets the hit points to zero."
  }
  msg "api.gameplay.Health.Revive" {
    text="Brings the node back with this many hit points; 0 means Max."
  }
  msg "api.gameplay.Health.Revived" {
    text="Fires after Revive."
  }
  msg "api.gameplay.Health.SetInvulnerable" {
    text="Ignores damage for some seconds of game time."
  }
  msg "api.gameplay.Hitbox2D.Activate" {
    text="Starts a new attack: targets hit before can be hit again."
  }
  msg "api.gameplay.Hitbox2D.Deactivate" {
    text="Stops dealing damage."
  }
  msg "api.gameplay.Hitbox2D.Hit" {
    text="Fires for each target damaged."
  }
  msg "api.gameplay.Hitbox2D.Pulse" {
    text="Deals one round of damage in the next step, active or not."
  }
  msg "api.gameplay.Motion2D.AddDisplacement" {
