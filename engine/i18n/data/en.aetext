messages version=1 lang=en {
  msg "api.aego/action.Action" {
    text="Action runs tweens, timers and other actions one after another or together; yield a waits until it ends."
  }
  msg "api.aego/action.Action.Completed" {
    text="Runs once when the action ends; finished is false after Stop or when the node of its script died."
  }
  msg "api.aego/action.Action.Done" {
    text="Reports whether the action ended, was stopped or is nil."
  }
  msg "api.aego/action.Action.Running" {
    text="Is the opposite of Done."
  }
  msg "api.aego/action.Action.Stop" {
    text="Stops every unfinished step; the properties keep their current values."
  }
  msg "api.aego/action.Action.Then" {
    text="Adds a tween created in this frame; it waits for its turn."
  }
  msg "api.aego/action.Action.ThenAction" {
    text="Adds another action that has not started."
  }
  msg "api.aego/action.Action.ThenTimer" {
    text="Adds a timer created in this frame; the step ends when the timer ends."
  }
  msg "api.aego/action.Action.Wait" {
    text="Adds a pause in game seconds."
  }
  msg "api.aego/action.Parallel" {
    text="Makes an action that runs all its steps at once and ends after the last one."
  }
  msg "api.aego/action.Sequence" {
    text="Makes an action that runs its steps one after another, starting at the next tween update."
  }
  msg "api.aego/anim.EventID" {
    text="Returns the id of an event declared in Project Settings → Animation, or -1."
  }
  msg "api.aego/anim.EventName" {
    text="Returns the name of an animation event, or an empty string for an unknown id."
  }
  msg "api.aego/anim.ParamIndex" {
    text="Returns the index of a parameter of a controller, or -1."
  }
  msg "api.aego/anim.StateName" {
    text="Returns the name of a state of a controller, or an empty string."
  }
  msg "api.aego/audio.Builtin" {
    text="Returns a clip that ships with the engine: Beep, Click, Hum (loopable) or Melody (loopable)."
  }
  msg "api.aego/audio.Bus" {
    text="Bus is a mixer bus: Master, Music, Sfx, UI, Ambience or Voice."
  }
  msg "api.aego/audio.BusVolume" {
    text="Returns the session volume of a bus set by SetBusVolume; the player's settings are separate."
  }
  msg "api.aego/audio.ListenerPosition" {
    text="Returns the last effective listener position in world space, or zero outside Play. It includes the camera fallback when no listener is active."
  }
  msg "api.aego/audio.Music" {
    text="Loops a clip on the music bus, crossfading from the music that played over seconds."
  }
  msg "api.aego/audio.Mute" {
    text="Silences a bus for this session."
  }
  msg "api.aego/audio.Pause" {
    text="Pauses or resumes every sound of this world."
  }
  msg "api.aego/audio.PauseWith" {
    text="PauseWith decides whether a sound pauses with the game or keeps playing."
  }
  msg "api.aego/audio.Play" {
    text="Plays a clip on its bus. The sound stops when the node of the script is destroyed."
  }
  msg "api.aego/audio.PlayAt" {
    text="Plays a clip at a world position, fading and panning with the distance to the listener."
  }
  msg "api.aego/audio.PlayEvent" {
    text="Plays an audio event; a spatial event follows the node of the script."
  }
  msg "api.aego/audio.PlayEventAt" {
    text="Plays an audio event at a world position."
  }
  msg "api.aego/audio.PlayWith" {
    text="Plays a clip with options."
  }
  msg "api.aego/audio.SetBusVolume" {
    text="Sets the session volume of a bus, on top of the player's settings; it is not saved."
  }
  msg "api.aego/audio.Sound" {
    text="Sound is a playing sound. yield s waits until it ends; a nil or finished sound is done. It is a presentation event: wait for game logic with a timer, not a sound."
  }
  msg "api.aego/audio.Sound.Completed" {
    text="Runs once when the sound ends: finished is false after Stop, when it was cut off, or when its node died."
  }
  msg "api.aego/audio.Sound.Done" {
    text="Reports whether the sound ended, was stopped or is nil."
  }
  msg "api.aego/audio.Sound.Pause" {
    text="Holds the sound where it is."
  }
  msg "api.aego/audio.Sound.Playing" {
    text="Reports whether the sound is audible now: not done, not stopping and not paused."
  }
  msg "api.aego/audio.Sound.Position" {
    text="Returns the seconds played, within the loop for a looping sound."
  }
  msg "api.aego/audio.Sound.Resume" {
    text="Continues a paused sound."
  }
  msg "api.aego/audio.Sound.SetPan" {
    text="Pans a sound that is not spatial, -1 to 1."
  }
  msg "api.aego/audio.Sound.SetPitch" {
    text="Changes speed and pitch, 0.25 to 4."
  }
  msg "api.aego/audio.Sound.SetVolume" {
    text="Changes the volume with a short ramp."
  }
  msg "api.aego/audio.Sound.Stop" {
    text="Ends the sound with a short fade."
  }
  msg "api.aego/audio.Sound.StopFade" {
    text="Fades the sound out over seconds."
  }
  msg "api.aego/audio.Steal" {
    text="Steal is what an audio event does at Max Voices: stop the oldest voice, stop the quietest, or skip the new play."
  }
  msg "api.aego/audio.StopMusic" {
    text="Fades the music out over seconds."
  }
  msg "api.aego/audio.WorldBusGain" {
    text="Returns the last zone-selected world-layer target for a bus, or 1 outside Play. It is not the ramped mixer output or the player's settings."
  }
  msg "api.aego/builtin.NodeRef.AddTag" {
    text="Adds a tag and returns false when it is malformed."
  }
  msg "api.aego/builtin.NodeRef.Child" {
    text="Returns the direct child with this name, or nil."
  }
  msg "api.aego/builtin.NodeRef.Destroy" {
    text="Removes the node and its children at the end of the phase."
  }
  msg "api.aego/builtin.NodeRef.Enabled" {
    text="Reports the node's own enabled flag, ignoring its parents."
  }
  msg "api.aego/builtin.NodeRef.Find" {
    text="Resolves a path relative to the node: Weapon/Gun, ../Sibling or /Root/Player."
  }
  msg "api.aego/builtin.NodeRef.HasTag" {
    text="Reports whether the node has the tag or a tag under it: Enemy matches Enemy.Flying."
  }
  msg "api.aego/builtin.NodeRef.IsAlive" {
    text="Reports whether the node exists. It is false right after Destroy."
  }
  msg "api.aego/builtin.NodeRef.IsPrefabInstance" {
    text="Reports whether the node is a prefab copy or lies inside one."
  }
  msg "api.aego/builtin.NodeRef.Name" {
    text="Returns the node name, unique among its siblings."
  }
  msg "api.aego/builtin.NodeRef.Parent" {
    text="Returns the parent node, or nil for top-level nodes."
  }
  msg "api.aego/builtin.NodeRef.Position" {
    text="Returns the local position relative to the parent."
  }
  msg "api.aego/builtin.NodeRef.Position3" {
    text="Returns the local 3D position."
  }
  msg "api.aego/builtin.NodeRef.PrefabRoot" {
    text="Returns the root of the nearest prefab copy that holds the node, the node itself for a root, or nil."
  }
  msg "api.aego/builtin.NodeRef.RemoveTag" {
    text="Removes a tag and returns whether the node had it."
  }
  msg "api.aego/builtin.NodeRef.Rotation" {
    text="Returns the local rotation in radians, clockwise."
  }
  msg "api.aego/builtin.NodeRef.Rotation3" {
    text="Returns the local 3D rotation."
  }
  msg "api.aego/builtin.NodeRef.Scale" {
    text="Returns the local scale."
  }
  msg "api.aego/builtin.NodeRef.SetEnabled" {
    text="Turns the node on or off. Disabled nodes and their children are not drawn."
  }
  msg "api.aego/builtin.NodeRef.SetPosition" {
    text="Sets the local position."
  }
  msg "api.aego/builtin.NodeRef.SetPosition3" {
    text="Sets the local 3D position."
  }
  msg "api.aego/builtin.NodeRef.SetRotation" {
    text="Sets the local rotation in radians."
  }
  msg "api.aego/builtin.NodeRef.SetRotation3" {
    text="Sets the local 3D rotation."
  }
  msg "api.aego/builtin.NodeRef.SetScale" {
    text="Sets the local scale. A negative X mirrors the node."
  }
  msg "api.aego/builtin.NodeRef.SetTransform2D" {
    text="Replaces the local 2D transform."
  }
  msg "api.aego/builtin.NodeRef.SetTransform3D" {
    text="Replaces the local 3D transform."
  }
  msg "api.aego/builtin.NodeRef.Space" {
    text="Returns 0 for 2D nodes and 1 for 3D nodes."
  }
  msg "api.aego/builtin.NodeRef.Transform2D" {
    text="Returns a copy of the local 2D transform. Change it and pass it to SetTransform2D."
  }
  msg "api.aego/builtin.NodeRef.Transform3D" {
    text="Returns a copy of the local 3D transform."
  }
  msg "api.aego/builtin.NodeRef.WorldPosition" {
    text="Returns the position in world space, as of the last transform pass."
  }
  msg "api.aego/camera.Active" {
    text="Returns the virtual camera that drives the main output, or nil."
  }
  msg "api.aego/camera.ActiveOn" {
    text="Returns the virtual camera that drives the named output."
  }
  msg "api.aego/camera.Blend" {
    text="Blend is a running blend between virtual cameras. yield b waits until it ends; a nil blend is done."
  }
  msg "api.aego/camera.Blend.Completed" {
    text="Runs once when the blend ends: finished is false after Stop or when another camera became active first."
  }
  msg "api.aego/camera.Blend.Done" {
    text="Reports whether the blend ended, was replaced or is nil."
  }
  msg "api.aego/camera.Blend.Running" {
    text="Is the opposite of Done."
  }
  msg "api.aego/camera.Blend.Stop" {
    text="Ends the blend at the target camera."
  }
  msg "api.aego/camera.BlendTo" {
    text="Makes vc active over priorities and blends to it; seconds 0 uses its Blend Time. Release hands control back to priorities."
  }
  msg "api.aego/camera.Cut" {
    text="Makes vc active at once, without a blend."
  }
  msg "api.aego/camera.LogicalPose" {
    text="Returns the pose of the main output without shake and pixel snapping."
  }
  msg "api.aego/camera.Release" {
    text="Ends BlendTo or Cut on the main output; priorities decide again, blending over seconds or the camera's Blend Time."
  }
  msg "api.aego/camera.RenderPose" {
    text="Returns the pose the main output was drawn with in the last frame."
  }
  msg "api.aego/camera.ScreenToWorld" {
    text="Converts output pixels to world units with the last drawn view of the main output."
  }
  msg "api.aego/camera.Shake" {
    text="Adds trauma to the main output; shake grows with trauma, which is capped at 1 and fades over time."
  }
  msg "api.aego/camera.ShakeOn" {
    text="Adds trauma to the named output."
  }
  msg "api.aego/camera.Trauma" {
    text="Returns the current trauma of the main output, 0 to 1."
  }
  msg "api.aego/camera.WorldToScreen" {
    text="Converts world units to output pixels with the last drawn view of the main output."
  }
  msg "api.aego/curve.Duration" {
    text="Returns the time between the first and the last key, 1 for a preset."
  }
  msg "api.aego/curve.Ease" {
    text="Returns a preset easing at t, clamped to 0..1."
  }
  msg "api.aego/curve.Easing" {
    text="Easing names a preset curve from 0 to 1. None and Linear move at a constant speed."
  }
  msg "api.aego/curve.Eval" {
    text="Returns the value of a curve at time t; outside its keys the curve repeats as its Before and After settings say."
  }
  msg "api.aego/curve.EvalClamped" {
    text="Returns the value at t clamped to the first and last key."
  }
  msg "api.aego/curve.InBack" {
    text="InBack pulls back past the start before it moves, like a wind-up."
  }
  msg "api.aego/curve.InBounce" {
    text="InBounce bounces off the start with growing hops before it goes."
  }
  msg "api.aego/curve.InCubic" {
    text="InCubic starts slowly and speeds up, more strongly than InQuad."
  }
  msg "api.aego/curve.InElastic" {
    text="InElastic wobbles around the start with growing swings, then springs to the end."
  }
  msg "api.aego/curve.InExpo" {
    text="InExpo barely moves at first, then covers nearly all the way at the end."
  }
  msg "api.aego/curve.InOutBack" {
    text="InOutBack pulls back past the start and goes past the end before it settles."
  }
  msg "api.aego/curve.InOutBounce" {
    text="InOutBounce bounces off the start and bounces on the end."
  }
  msg "api.aego/curve.InOutCubic" {
    text="InOutCubic is slow at both ends and fast in the middle, more strongly than InOutQuad."
  }
  msg "api.aego/curve.InOutElastic" {
    text="InOutElastic wobbles around both the start and the end."
  }
  msg "api.aego/curve.InOutExpo" {
    text="InOutExpo waits at the start, rushes through the middle and creeps to the end."
  }
  msg "api.aego/curve.InOutQuad" {
    text="InOutQuad is slow at both ends and fastest in the middle, gently: for moves between two rest positions."
  }
  msg "api.aego/curve.InOutSine" {
    text="InOutSine is slow at both ends, the softest of the curves: for breathing, bobbing and fades."
  }
  msg "api.aego/curve.InQuad" {
    text="InQuad starts slowly and speeds up, gently: for things that set off, such as a door starting to open."
  }
  msg "api.aego/curve.InSine" {
    text="InSine starts slowly and speeds up, the softest of the curves."
  }
  msg "api.aego/curve.Linear" {
    text="Linear moves at a constant speed from start to end."
  }
  msg "api.aego/curve.OutBack" {
    text="OutBack goes past the end and settles back: for a pop or a bounce-in."
  }
  msg "api.aego/curve.OutBounce" {
    text="OutBounce reaches the end and bounces on it like a dropped ball."
  }
  msg "api.aego/curve.OutCubic" {
    text="OutCubic starts fast and slows down to the end, more strongly than OutQuad."
  }
  msg "api.aego/curve.OutElastic" {
    text="OutElastic springs past the end and wobbles around it as it settles, like a spring."
  }
  msg "api.aego/curve.OutExpo" {
    text="OutExpo covers nearly all the way at once, then creeps to the end: for snappy UI."
  }
  msg "api.aego/curve.OutQuad" {
    text="OutQuad starts fast and slows down gently to the end: the usual choice for UI that slides in."
  }
  msg "api.aego/curve.OutSine" {
    text="OutSine starts fast and slows down to the end, the softest of the curves."
  }
  msg "api.aego/debug.Arrow" {
    text="Draws an arrow from one point to another."
  }
  msg "api.aego/debug.Circle" {
    text="Draws a circle outline with radius r in world units."
  }
  msg "api.aego/debug.Clear" {
    text="Removes every primitive whose channel starts with prefix."
  }
  msg "api.aego/debug.Cross" {
    text="Draws a cross of the given size in world units."
  }
  msg "api.aego/debug.Line" {
    text="Draws a line in world units. It lasts one frame unless Pen sets a lifetime."
  }
  msg "api.aego/debug.Pen" {
    text="Sets the channel and the lifetime of the next primitives this script draws. A ttl of 0 lasts one frame, a positive ttl that many game seconds, a negative ttl until Clear."
  }
  msg "api.aego/debug.PenUnscaled" {
    text="Is Pen with a lifetime in real seconds; such primitives fade out while the game is paused."
  }
  msg "api.aego/debug.Point" {
    text="Marks a point with a small cross of constant screen size."
  }
  msg "api.aego/debug.Ray" {
    text="Draws an arrow from origin along dir; the length of dir is the length of the arrow."
  }
  msg "api.aego/debug.Rect" {
    text="Draws a rectangle outline."
  }
  msg "api.aego/debug.Text" {
    text="Draws a label at a world position; it keeps its screen size at any zoom."
  }
  msg "api.aego/input.ActiveDevice" {
    text="Returns the device player 0 used last: -1 none, 0 keyboard and mouse, 1 to 4 a gamepad."
  }
  msg "api.aego/input.Axis" {
    text="Returns the value of an axis action from -1 to 1, or the press strength of a button action."
  }
  msg "api.aego/input.Axis2" {
    text="Returns a 2D action as a vector no longer than 1; Y grows downward like the 2D world."
  }
  msg "api.aego/input.Axis2P" {
    text="Is Axis2 for one player."
  }
  msg "api.aego/input.AxisP" {
    text="Is Axis for one player."
  }
  msg "api.aego/input.BeginRebind" {
    text="Waits for the next key, button or stick and binds it to the slot of the action. Escape cancels."
  }
  msg "api.aego/input.Buffered" {
    text="Reports whether the action was pressed in the last window game seconds and not consumed. A window of 0 uses the action's buffer setting."
  }
  msg "api.aego/input.Button" {
    text="Button is a mouse button."
  }
  msg "api.aego/input.Consume" {
    text="Clears the press and the buffer of the action, so later readers this frame do not see it."
  }
  msg "api.aego/input.DeviceChanged" {
    text="Is true for the frame a gamepad was connected or removed."
  }
  msg "api.aego/input.Down" {
    text="Reports whether a raw key is held. For prototypes; release builds use actions."
  }
  msg "api.aego/input.Glyph" {
    text="Returns the binding of the action for the active device as text, like [Space] or [A]."
  }
  msg "api.aego/input.Held" {
    text="Reports whether the action is active."
  }
  msg "api.aego/input.HeldP" {
    text="Is Held for one player."
  }
  msg "api.aego/input.Key" {
    text="Key is a physical key, independent of the keyboard layout. Prefer actions; raw keys are for prototypes."
  }
  msg "api.aego/input.KeyA" {
    text="The A key."
  }
  msg "api.aego/input.KeyB" {
    text="The B key."
  }
  msg "api.aego/input.KeyBackspace" {
