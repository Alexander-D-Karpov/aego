    text="Friendly Fire"
  }
  msg "schema.gameplay.Hitbox2D.friendlyFire.doc" {
    text="Also hits targets of the same team."
  }
  msg "schema.gameplay.Hitbox2D.knockback" {
    text="Knockback"
  }
