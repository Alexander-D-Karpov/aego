  }
  msg "schema.camera.CameraFollow2D" {
    text="Camera Follow 2D"
  }
  msg "schema.camera.CameraFollow2D.damping" {
    text="Damping"
  }
  msg "schema.camera.CameraFollow2D.damping.doc" {
    text="How fast the camera catches up, per second on each axis. 0 follows rigidly."
  }
  msg "schema.camera.CameraFollow2D.deadzone" {
    text="Deadzone"
  }
  msg "schema.camera.CameraFollow2D.deadzone.doc" {
    text="Area of the view, in 0..1 of its width and height, where the target moves without moving the camera."
  }
  msg "schema.camera.CameraFollow2D.doc" {
    text="Moves its virtual camera after Target, with a deadzone, damping and lookahead."
  }
  msg "schema.camera.CameraFollow2D.lookahead" {
    text="Lookahead"
  }
  msg "schema.camera.CameraFollow2D.lookahead.doc" {
    text="Seconds of target velocity the camera looks ahead on each axis."
  }
  msg "schema.camera.CameraFollow2D.lookaheadSmoothing" {
    text="Lookahead Smoothing"
  }
  msg "schema.camera.CameraFollow2D.lookaheadSmoothing.doc" {
    text="How fast the lookahead changes, per second. 0 changes at once."
  }
  msg "schema.camera.CameraFollow2D.maxLookahead" {
    text="Max Lookahead"
  }
  msg "schema.camera.CameraFollow2D.maxLookahead.doc" {
    text="Largest lookahead in world units on each axis. 0 is unlimited."
  }
  msg "schema.camera.CameraFollow2D.snapDistance" {
    text="Snap Distance"
  }
  msg "schema.camera.CameraFollow2D.snapDistance.doc" {
    text="A target jump longer than this, in world units, moves the camera at once. 0 never snaps."
  }
  msg "schema.camera.CameraFollow2D.target" {
    text="Target"
  }
  msg "schema.camera.CameraFollow2D.target.doc" {
    text="Node to follow; its interpolated position is used."
  }
  msg "schema.camera.CameraShake2D" {
    text="Camera Shake 2D"
  }
  msg "schema.camera.CameraShake2D.decay" {
    text="Decay"
  }
  msg "schema.camera.CameraShake2D.decay.doc" {
    text="Trauma lost per second."
  }
  msg "schema.camera.CameraShake2D.doc" {
    text="Tunes the shake of its virtual camera. Shake grows with trauma and fades over time."
  }
  msg "schema.camera.CameraShake2D.exponent" {
    text="Exponent"
  }
  msg "schema.camera.CameraShake2D.exponent.doc" {
    text="Shake is trauma to this power: 2 keeps small hits subtle."
  }
  msg "schema.camera.CameraShake2D.frequency" {
    text="Frequency"
  }
  msg "schema.camera.CameraShake2D.frequency.doc" {
    text="How fast the shake changes, in noise steps per second."
  }
  msg "schema.camera.CameraShake2D.maxAngle" {
    text="Max Angle"
  }
  msg "schema.camera.CameraShake2D.maxAngle.doc" {
    text="Largest rotation in radians at full trauma."
  }
  msg "schema.camera.CameraShake2D.maxOffset" {
    text="Max Offset"
  }
  msg "schema.camera.CameraShake2D.maxOffset.doc" {
    text="Largest offset in world units at full trauma."
  }
  msg "schema.camera.CameraZone2D" {
    text="Camera Zone 2D"
  }
  msg "schema.camera.CameraZone2D.area" {
    text="Area"
  }
  msg "schema.camera.CameraZone2D.area.doc" {
    text="Trigger rectangle in this node's space."
  }
  msg "schema.camera.CameraZone2D.bounds" {
    text="Bounds"
  }
  msg "schema.camera.CameraZone2D.bounds.doc" {
    text="World rectangle used instead of the camera's bounds."
  }
  msg "schema.camera.CameraZone2D.camera" {
    text="Camera"
  }
  msg "schema.camera.CameraZone2D.camera.doc" {
    text="Virtual camera the zone activates. Empty uses the one on this node."
  }
  msg "schema.camera.CameraZone2D.doc" {
    text="While Target is inside Area, Camera gets Priority and the zone's zoom and bounds."
  }
  msg "schema.camera.CameraZone2D.priority" {
    text="Priority"
  }
  msg "schema.camera.CameraZone2D.priority.doc" {
    text="Priority of the camera while the target is inside."
  }
  msg "schema.camera.CameraZone2D.target" {
    text="Target"
  }
  msg "schema.camera.CameraZone2D.target.doc" {
    text="Node that triggers the zone. Empty uses the follow target of the zone's camera."
  }
  msg "schema.camera.CameraZone2D.useBounds" {
    text="Use Bounds"
  }
  msg "schema.camera.CameraZone2D.useBounds.doc" {
    text="Replaces the camera's bounds while the zone is in effect."
  }
  msg "schema.camera.CameraZone2D.zoom" {
    text="Zoom"
  }
  msg "schema.camera.CameraZone2D.zoom.doc" {
    text="Zoom while the zone is in effect. 0 keeps the camera's zoom."
  }
  msg "schema.camera.VirtualCamera2D" {
    text="Virtual Camera 2D"
  }
  msg "schema.camera.VirtualCamera2D.blendCurve" {
    text="Blend Curve"
  }
  msg "schema.camera.VirtualCamera2D.blendCurve.doc" {
    text="Shape of the blend; its time range is stretched over Blend Time."
  }
  msg "schema.camera.VirtualCamera2D.blendTime" {
    text="Blend Time"
  }
  msg "schema.camera.VirtualCamera2D.blendTime.doc" {
    text="Seconds to blend into this camera when it becomes active. 0 cuts."
  }
  msg "schema.camera.VirtualCamera2D.bounds" {
    text="Bounds"
  }
  msg "schema.camera.VirtualCamera2D.bounds.doc" {
    text="World rectangle the view stays inside. A smaller area centres the view on it."
  }
  msg "schema.camera.VirtualCamera2D.doc" {
    text="A camera pose the brain can pick. The highest priority wins; switching blends from the current view."
  }
  msg "schema.camera.VirtualCamera2D.output" {
    text="Output"
  }
  msg "schema.camera.VirtualCamera2D.output.doc" {
    text="Output this camera drives. Empty is the main output; a Camera 2D picks another one with Camera Output Selector 2D."
  }
  msg "schema.camera.VirtualCamera2D.priority" {
    text="Priority"
  }
  msg "schema.camera.VirtualCamera2D.priority.doc" {
    text="The enabled virtual camera with the highest priority drives its output."
  }
  msg "schema.camera.VirtualCamera2D.snapToPixels" {
    text="Snap To Pixels"
  }
  msg "schema.camera.VirtualCamera2D.snapToPixels.doc" {
    text="Rounds the final position to whole screen pixels. pixelPerfect cameras already do this."
  }
  msg "schema.camera.VirtualCamera2D.timeDomain" {
    text="Time Domain"
  }
  msg "schema.camera.VirtualCamera2D.timeDomain.doc" {
    text="unscaled blends and shakes in real time, also during hit-stop and pause; game follows the time scale."
  }
  msg "schema.camera.VirtualCamera2D.useBounds" {
    text="Use Bounds"
  }
  msg "schema.camera.VirtualCamera2D.useBounds.doc" {
    text="Keeps the visible area inside Bounds."
  }
  msg "schema.camera.VirtualCamera2D.zoom" {
    text="Zoom"
  }
  msg "schema.camera.VirtualCamera2D.zoom.doc" {
    text="Pixels per world unit while this camera is active. 0 keeps the zoom of the Camera 2D."
  }
