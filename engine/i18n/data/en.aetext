    text="Policy"
  }
  msg "schema.gameplay.Hitbox2D.policy.doc" {
    text="onEnter hits on every entry, oncePerActivation hits each target once until Activate, periodic hits every Period while overlapping."
  }
  msg "schema.gameplay.Hitbox2D.shape" {
    text="Shape"
  }
  msg "schema.gameplay.Hitbox2D.shape.doc" {
    text="box uses the rectangle; circle uses the circle inside it."
  }
  msg "schema.gameplay.Hitbox2D.team" {
    text="Team"
  }
  msg "schema.gameplay.Hitbox2D.team.doc" {
    text="Team of the attack; -1 takes the team of the nearest Health above."
  }
  msg "schema.gameplay.Hurtbox2D" {
