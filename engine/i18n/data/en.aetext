    text="Fires when the character starts climbing onto a ledge."
  }
  msg "api.gameplay.Motion2D.Dash" {
    text="Moves at a fixed velocity for some seconds."
  }
  msg "api.gameplay.Motion2D.HitCeiling" {
    text="Fires when the character bumps into a ceiling."
  }
  msg "api.gameplay.Motion2D.HitWall" {
    text="Fires when the character starts touching a wall."
  }
  msg "api.gameplay.Motion2D.Jump" {
    text="Jumps on the next step if grounded, within coyote time or later within the jump buffer."
  }
