  msg "diag.AES1001" {
    text="This character cannot appear here."
  }
  msg "diag.AES1001.fix" {
    text="Use ASCII letters for names, put other text inside a string, and use && or || instead of & or |."
  }
  msg "diag.AES1002" {
    text="The string literal has no closing quote."
  }
  msg "diag.AES1002.fix" {
    text="Add \" at the end of the string."
  }
  msg "diag.AES1003" {
    text="The escape sequence after \\ is not supported."
  }
  msg "diag.AES1003.fix" {
    text="Use \\n, \\t, \\\", \\\\ or \\uXXXX."
  }
  msg "diag.AES1004" {
    text="The word is reserved for a future version of the language."
  }
  msg "diag.AES1004.fix" {
    text="Rename the identifier."
  }
  msg "diag.AES1005" {
    text="The number literal is malformed."
  }
  msg "diag.AES1005.fix" {
    text="Write digits after the point (1.0, not 1.) and separate digits with _ only between digits."
  }
  msg "diag.AES1006" {
    text="The block comment has no closing */."
  }
  msg "diag.AES1006.fix" {
    text="Add */ where the comment should end."
  }
  msg "diag.AES1007" {
    text="The file contains bytes that are not valid UTF-8."
  }
  msg "diag.AES1007.fix" {
    text="Save the file as UTF-8."
  }
  msg "diag.AES1008" {
    text="A string literal cannot span lines."
  }
  msg "diag.AES1008.fix" {
    text="Close the string on the same line or use \\n."
  }
  msg "diag.AES1101" {
    text="The parser expected something else at this point."
  }
  msg "diag.AES1101.fix" {
    text="Check for a missing bracket, comma or operator right before this position."
  }
  msg "diag.AES1102" {
    text="Every script file starts with a package clause."
  }
  msg "diag.AES1102.fix" {
    text="Add `package <directory name>` as the first line."
  }
  msg "diag.AES1103" {
    text="Attributes are allowed only on scripts and script fields."
  }
  msg "diag.AES1103.fix" {
    text="Move the attribute above a script or a `var` inside a script, or remove it."
  }
  msg "diag.AES1104" {
    text="Imports must come before any declaration."
  }
  msg "diag.AES1104.fix" {
    text="Move the import to the top of the file, after the package clause."
  }
  msg "diag.AES1105" {
    text="Packages cannot hold mutable state."
  }
  msg "diag.AES1105.fix" {
    text="Use const for fixed values, or move the variable into a script as a field."
  }
  msg "diag.AES1106" {
    text="Types, functions and constants are declared at package level."
  }
  msg "diag.AES1106.fix" {
    text="Move the declaration out of the function body."
  }
  msg "diag.AES1107" {
    text="The left side of := must be one new name."
  }
  msg "diag.AES1107.fix" {
    text="Write `name := value`, or use = to assign to an existing field or element."
  }
  msg "diag.AES1108" {
    text="A composite literal key must be a field name."
  }
  msg "diag.AES1108.fix" {
    text="Write `Type{Field: value}`."
  }
  msg "diag.AES1109" {
    text="The code is nested too deeply."
  }
  msg "diag.AES1109.fix" {
    text="Split the expression or block into helper functions."
  }
  msg "diag.AES1110" {
    text="The single part of a for loop must be a condition."
  }
  msg "diag.AES1110.fix" {
    text="Write `for cond {}` or `for init; cond; post {}`."
  }
  msg "diag.AES1111" {
    text="A slice type here must be followed by a literal."
  }
  msg "diag.AES1111.fix" {
    text="Write `[]T{...}`."
  }
  msg "diag.AES1112" {
    text="Only one value can be assigned per statement."
  }
  msg "diag.AES1112.fix" {
    text="Split the assignment into several statements."
  }
  msg "diag.AES1113" {
    text="else must follow the closing brace on the same line."
  }
  msg "diag.AES1113.fix" {
    text="Write `} else {`."
  }
  msg "diag.AES2001" {
    text="The name is not declared in this scope."
  }
  msg "diag.AES2001.fix" {
    text="Check the spelling, declare it, or add the missing import."
  }
  msg "diag.AES2002" {
    text="The name refers to something that is not a type."
  }
  msg "diag.AES2002.fix" {
    text="Use a type name such as int, Vec2 or a declared struct."
  }
  msg "diag.AES2003" {
    text="The value has a different type than the place it is used."
  }
  msg "diag.AES2003.fix" {
    text="Convert explicitly, for example float(x) or int(f)."
  }
  msg "diag.AES2004" {
    text="The operator is not defined for these operand types."
  }
  msg "diag.AES2004.fix" {
    text="Convert the operands to a type the operator supports."
  }
  msg "diag.AES2005" {
    text="The call passes a different number of arguments than the function expects."
  }
  msg "diag.AES2005.fix" {
    text="Match the function signature; hover the function to see it."
  }
  msg "diag.AES2006" {
    text="The expression is not a function."
  }
  msg "diag.AES2006.fix" {
    text="Remove the parentheses or call a function instead."
  }
  msg "diag.AES2007" {
    text="The left side cannot be assigned to."
  }
  msg "diag.AES2007.fix" {
    text="Assign to a variable, field, slice element or writable component field."
  }
  msg "diag.AES2008" {
    text="The type has no field or member with this name."
  }
  msg "diag.AES2008.fix" {
    text="Check the spelling; press Ctrl+Space after . to see the members."
  }
  msg "diag.AES2009" {
    text="The name starts with a lowercase letter, so it is private to its package."
  }
  msg "diag.AES2009.fix" {
    text="Rename it to start with an uppercase letter if other packages need it."
  }
  msg "diag.AES2010" {
    text="A constant needs a value known at compile time."
  }
  msg "diag.AES2010.fix" {
    text="Use literals and other constants only."
  }
  msg "diag.AES2011" {
    text="Integer division by a constant zero."
  }
  msg "diag.AES2011.fix" {
    text="Check the divisor."
  }
  msg "diag.AES2012" {
    text="The constant does not fit its type."
  }
  msg "diag.AES2012.fix" {
    text="Use a smaller value or a wider type."
  }
  msg "diag.AES2013" {
    text="The function can reach its end without returning a value."
  }
  msg "diag.AES2013.fix" {
    text="Add a return statement on every path."
  }
  msg "diag.AES2014" {
    text="break or continue is outside a loop or switch."
  }
  msg "diag.AES2014.fix" {
    text="Move it inside a for loop, or use return."
  }
  msg "diag.AES2015" {
    text="A switch on an enum must handle every member."
  }
  msg "diag.AES2015.fix" {
    text="Add the missing cases or a default."
  }
  msg "diag.AES2016" {
    text="The same case value appears twice."
  }
  msg "diag.AES2016.fix" {
    text="Remove the duplicate case."
  }
  msg "diag.AES2017" {
    text="A struct cannot contain itself by value."
  }
  msg "diag.AES2017.fix" {
    text="Store the relation in a slice or remove the field."
  }
  msg "diag.AES2018" {
    text="The name is already declared in this scope."
  }
  msg "diag.AES2018.fix" {
    text="Rename one of the declarations or remove one of them."
  }
  msg "diag.AES2019" {
    text="The returned value does not match the function result."
  }
  msg "diag.AES2019.fix" {
    text="Return a value of the declared type, or none in a function without a result."
  }
  msg "diag.AES2020" {
    text="nil has no type of its own here."
  }
  msg "diag.AES2020.fix" {
    text="Give the variable an explicit reference type: `var r NodeRef = nil`."
  }
  msg "diag.AES2021" {
    text="The type argument is not valid here."
  }
  msg "diag.AES2021.fix" {
    text="Use Get<T>/Has<T> with a component name, AssetRef<Texture|Scene|Prefab|Mesh>."
  }
  msg "diag.AES2022" {
    text="A lifecycle method has the wrong signature."
  }
  msg "diag.AES2022.fix" {
    text="Use func Ready(), func Update(dt float), func FixedUpdate(dt float), func Reloaded()."
  }
  msg "diag.AES2023" {
    text="These types cannot be converted into each other."
  }
  msg "diag.AES2023.fix" {
    text="Convert through int, float or string as documented."
  }
  msg "diag.AES2024" {
    text="The expression does not produce a value."
  }
  msg "diag.AES2024.fix" {
    text="Call the function, or use a value instead of a type or package."
  }
  msg "diag.AES2025" {
    text="The value is computed and then thrown away."
  }
  msg "diag.AES2025.fix" {
    text="Assign the result or remove the expression."
  }
  msg "diag.AES2026" {
    text="Constants refer to each other in a cycle."
  }
  msg "diag.AES2026.fix" {
    text="Break the cycle with a literal value."
  }
  msg "diag.AES2027" {
    text="Constants can only be bool, int, float, string or enum."
  }
  msg "diag.AES2027.fix" {
    text="Use a script field for other types."
  }
  msg "diag.AES2027.why" {
    text="Every other constant type is rejected earlier as AES2010 or AES2003."
  }
  msg "diag.AES2028" {
    text="The composite literal does not fit its type."
  }
  msg "diag.AES2028.fix" {
    text="Use all keyed or all positional values, with the right count."
  }
  msg "diag.AES2029" {
    text="The function is too large to compile."
  }
  msg "diag.AES2029.fix" {
    text="Split it into smaller functions."
  }
  msg "diag.AES2030" {
    text="The package was not built because a dependency has errors."
  }
  msg "diag.AES2030.fix" {
    text="Fix the errors in the named package."
  }
  msg "diag.AES2031" {
    text="The variable is declared but never read."
  }
  msg "diag.AES2031.fix" {
    text="Use it or remove it."
  }
  msg "diag.AES2032" {
    text="Slice elements may occupy at most 32 value slots."
  }
  msg "diag.AES2032.fix" {
    text="Make the element struct smaller or store several slices."
  }
  msg "diag.AES2050" {
    text="yield suspends a coroutine, so it is allowed only inside a function declared as coroutine."
  }
  msg "diag.AES2050.fix" {
    text="Declare the method as func Name() coroutine and start it with start Name()."
  }
  msg "diag.AES2051" {
    text="A coroutine cannot be called like a plain function."
  }
  msg "diag.AES2051.fix" {
    text="Write start Name(args); keep the result in a Coroutine field to stop it later."
  }
  msg "diag.AES2052" {
    text="start runs a coroutine method of the current script."
  }
  msg "diag.AES2052.fix" {
    text="Mark the method with coroutine after its signature, or call a plain method directly."
  }
  msg "diag.AES2053" {
    text="A coroutine is a script method and returns no value."
  }
  msg "diag.AES2053.fix" {
    text="Move it into a script and remove the result type; pass results through fields or signals."
  }
  msg "diag.AES2054" {
    text="The handler parameters must match the signal parameters exactly."
  }
  msg "diag.AES2054.fix" {
    text="Change the handler to take the same types in the same order as the signal."
  }
  msg "diag.AES2055" {
    text="Connect takes a plain method of this script or ref.Method; signals are emitted only by their own script."
  }
  msg "diag.AES2055.fix" {
    text="Pass a method name like OnDied or other.OnDied; call Emit only on a signal of this script."
  }
  msg "diag.AES2056" {
    text="Ready, Update, FixedUpdate and Reloaded are called by the engine and cannot be coroutines."
  }
  msg "diag.AES2056.fix" {
    text="Keep the lifecycle method plain and write start Name() inside it."
  }
  msg "diag.AES2057" {
    text="wait and waitUnscaled take seconds as float, frames and fixed take a count as int, a bare yield value must be a Coroutine."
  }
  msg "diag.AES2057.fix" {
    text="Convert the value, for example yield wait(float(n)) or yield frames(int(t))."
  }
  msg "diag.AES2058" {
    text="ScriptRef and GetScript need the name of a script type."
  }
  msg "diag.AES2058.fix" {
    text="Use the script name, or pkg.Name when the short name is ambiguous."
  }
  msg "diag.AES2059" {
    text="Lifecycle methods and coroutines run only on their own instance."
  }
  msg "diag.AES2059.fix" {
    text="Call a plain method of the target that does the work, or connect to a signal."
  }
  msg "diag.AES2060" {
    text="A script method named after an engine event receives that event and must match its signature."
  }
  msg "diag.AES2060.fix" {
    text="Use the parameter types shown in the hover for the event, or rename the method if it is not meant to be a handler."
  }
  msg "diag.AES2061" {
    text="Engine event handlers are called only by the engine."
  }
  msg "diag.AES2061.fix" {
    text="Move the shared code into a plain method and call that from the handler and from your code."
  }
  msg "diag.AES3001" {
