  msg "cli.source_recovery.confirm_required" {
    text="recovery requires --confirm; inspect status first"
  }
  msg "cli.source_recovery.finished" {
    text="The transaction was already resolved; restore --confirm only finishes recovery-file cleanup."
  }
  msg "cli.source_recovery.flag.confirm" {
    text="explicitly resolve the interrupted transaction"
  }
  msg "cli.source_recovery.none" {
    text="No interrupted source transaction was found."
  }
  msg "cli.source_recovery.prepared" {
    text="Inspect these files and close the editor. Restore with --confirm only if you want the previous source generation."
  }
  msg "cli.source_recovery.resolved" {
    text="Source recovery was resolved."
  }
  msg "cli.source_recovery.status" {
    text="Source recovery {id}: {state}"
  }
  msg "cli.source_recovery.usage" {
    text="usage: aego source-recovery status [dir] | restore [dir] --confirm"
  }
  msg "cli.source_recovery.usage_line" {
    text="  source-recovery <status|restore>  inspect or explicitly recover interrupted source edits"
  }
  msg "cli.unknown_command" {
    text="unknown command {name}"
  }
  msg "cli.usage" {
    text="aego <command> [flags]\n\n  new <dir> [--template empty|2d|2.5d|3d] [--module m] [--example name] [--native]\n                         create a project from a template or an engine example\n  run [dir]              import assets and run the game\n  edit [dir|file] [--launcher recent|new]\n                         open a project, or one of its scenes, in the editor; without a project opens the launcher\n  build [dir]            build the native binary\n  export [dir] [--target host|linux|windows|darwin] [--release|--development] [--out dir] [--check] [--json]\n                         build a distributable game that runs without Go and project sources\n  bootstrap [dir]        regenerate .aego/generated for the native module without building\n  import [dir] [--force] reimport all assets\n  check [dir] [--manifest file] [--explain] [--ensure-meta]  parse every document, audit .meta files and type-check scripts\n  icons [check|list] [dir] [--json] [--out file]  check icon use against the icon sources, or print the manifest\n  test [dir] [-run name] [-v] [--determinism [--frames n] [--every n] [--seed s] [--scene file]]\n                         run *_test.aes script tests headless, or run the game twice and compare state hashes\n  dump script <pkg|Type> [--func name]  disassemble a script package with source lines\n  docs export|check|build|serve  documentation registry, site and playground\n  mcp [--project dir] [--watch]   serve the project to an AI agent over MCP (stdio)\n  update [status|check|apply|restore] [--channel stable|nightly]   check for and install a new Aego, or go back to the previous one\n  release keygen|manifest ...     make a signing key and the signed release.json of a release\n  scene|prefab|data|refs|asset|schema|project <verb> ...   edit project files without the editor, see aego scene help\n  version                print the engine version and the commit it was built from\n"
  }
