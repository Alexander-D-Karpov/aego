messages version=1 lang=en {
  msg "editor.art.blank_title" { text="Untitled drawing" }
  msg "editor.art.blank_hint" { text="Untitled drawing in memory. Save to create a project asset." }
  msg "editor.art.save_blank" { text="Save drawing as an asset" }
  msg "editor.art.save_blank_notice" { text="Choose a project source. Replacing an existing drawing requires confirmation." }
  msg "editor.art.blank_saved" { text="Saved drawing: {path}" }
  msg "editor.art.replace" { text="Replace" }
  msg "editor.art.replace_title" { text="Replace existing drawing?" }
  msg "editor.art.replace_notice" { text="Replace {path}? Its current drawing will be overwritten. The asset identity is kept, so all users of this shared asset can change." }
  msg "editor.art.replace_missing_meta" { text="The existing drawing has no metadata. Resolve its identity before replacing it." }
  msg "editor.art.replace_invalid_meta" { text="The existing drawing has invalid or incompatible metadata. It was not replaced." }
  msg "editor.art.replace_invalid_source" { text="The existing drawing could not be read; it was not replaced" }
  msg "editor.art.replace_orphan_meta" { text="The destination already has metadata but no source. Resolve it or choose another name." }
  msg "editor.art.replace_incompatible" { text="Replacing this drawing would remove existing frame, animation, or surface references. Choose a new name instead." }
  msg "editor.art.replace_changed" { text="The destination changed while saving. Review it and try again." }
  msg "editor.art.pick_canvas_color" { text="Pick color from canvas" }
  msg "editor.art.pick_canvas_hint" { text="Pick a pixel from the active layer, then return to the previous tool. Click again or press Escape to cancel." }
  msg "editor.art.eraser_mode" { text="Eraser mode" }
  msg "editor.art.eraser_erase" { text="Erase" }
  msg "editor.art.eraser_smudge" { text="Smudge" }
  msg "editor.art.eraser_strength" { text="Strength (%)" }
  msg "editor.art.eraser_indexed" { text="In indexed mode, partial results are limited to the existing palette." }
  msg "editor.shell.recovery_write_failed" { text="Could not save recovery" }
  msg "editor.shell.recovery_write_failed_notice" { text="One or more recovery files could not be updated: {error}. Keep the editor open; recent changes may exist only in memory. Free space or resolve the access problem, or save a copy to another filesystem. Earlier recovery files may be out of date." }
  msg "editor.shell.recovery_retry" { text="Retry recovery" }
  msg "editor.shell.recovered_scene_in_background" { text="Recovered {path} without changing the current scene. Select it from the Scene menu to inspect its unsaved changes." }
  msg "editor.shell.continue_editing" { text="Continue editing" }
  msg "editor.shell.recovery_copy_action" { text="Save recovery copy…" }
  msg "editor.shell.recovery_copy_title" { text="Save emergency recovery copies" }
  msg "editor.shell.recovery_copy_notice" { text="Choose an existing directory on a filesystem with free space. A new private folder will contain copies of current unsaved documents; project assets and existing recovery files are not replaced. Earlier pending recovery files are not included. This is not Save, and recovery is never automatic. Temporary storage may disappear after reboot." }
  msg "editor.shell.recovery_copy_directory" { text="Absolute destination directory" }
  msg "editor.shell.recovery_copy_save" { text="Save copies" }
  msg "editor.shell.recovery_copy_project_changed" { text="The project changed before the recovery copy was saved." }
  msg "editor.shell.recovery_copy_partial" { text="Recovery copy is incomplete in {path}: {error}. Keep the editor open and try another location." }
  msg "editor.shell.recovery_copy_failed" { text="Could not save recovery copies: {error}. Keep the editor open and try another location." }
  msg "editor.shell.recovery_copy_saved" { text="Saved {count} emergency recovery copies in {path}. These are not saved project assets and will not restore automatically." }
  msg "editor.audio.setting_changed" { text="This audio setting changed in another view. Review it before editing again." }
  msg "editor.audio.preview_cancel" { text="Cancel" }
  msg "editor.audio.preview_preparing" { text="Preparing preview..." }
  msg "editor.audio.preview_save_required" { text="Save this audio's import settings before previewing it." }
  msg "editor.audio.preview_stale" { text="The audio or preview changed while preparing. Play again to use the current version." }
