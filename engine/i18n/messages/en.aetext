  }
  msg "cli.edit.flag.profile" {
    text="player settings profile, default when empty"
  }
  msg "cli.examples.help" {
    text="Remote examples (data only; no code execution)\n  remoteexample clone  -url HTTPS_MANIFEST -approve-origin HTTPS_ORIGIN [-root DIR]\n  remoteexample open   -url HTTPS_MANIFEST -approve-origin HTTPS_ORIGIN [-root DIR]\n  remoteexample recent [-root DIR]\n  remoteexample reopen -id LOCAL_COPY_ID [-root DIR]\n  remoteexample check  -id LOCAL_COPY_ID -approve-origin HTTPS_ORIGIN [-root DIR]\n  remoteexample link   -url HTTPS_MANIFEST [-mode project|scene]\n  remoteexample inspect -link AEGO_URL\n\nclone always creates an independent editable copy. open reuses the most recent\nlocal copy, including offline edits, before attempting HTTPS. check only reports\nupdates; it never replaces files. inspect parses a deep link but grants no trust.\nNo origin is implicitly trusted. -approve-origin must be an exact HTTPS origin."
  }
  msg "cli.examples.usage" {
    text="  examples <clone|open|recent|reopen|check|link|inspect>  manage remote example copies"
  }
  msg "cli.export.flag.base_url" {
    text="where the archive is downloaded from; update.url/<channel> by default"
  }
  msg "cli.export.flag.cc" {
    text="C compiler for the target"
  }
  msg "cli.export.flag.channel" {
    text="update channel of the release: stable or nightly"
  }
  msg "cli.export.flag.check" {
    text="run the pre-export checks only"
  }
  msg "cli.export.flag.development" {
    text="development profile"
  }
  msg "cli.export.flag.engine" {
    text="path to the aego source tree"
  }
  msg "cli.export.flag.json" {
    text="print the report as JSON"
  }
  msg "cli.export.flag.key_file" {
    text="private key that signs release.json"
  }
  msg "cli.export.flag.out" {
    text="output directory"
  }
  msg "cli.export.flag.release" {
    text="release profile"
  }
  msg "cli.export.flag.release_json" {
    text="pack the export and write the signed release.json its copies update from"
  }
  msg "cli.export.flag.target" {
    text="target platform"
  }
  msg "cli.export.profiles" {
    text="--release and --development cannot be used together"
  }
  msg "cli.export.usage" {
    text="usage: aego export [dir] [flags]\n\n  --target host|linux|windows|darwin[/amd64|/arm64]|web   default host\n  --development | --release                           default development\n  --out dir        output directory, default <project>/exports/<os>-<arch>-<profile>\n  --cc compiler    C compiler for a cross target, or CC_<OS>_<ARCH>\n  --check          run the pre-export checks only\n  --json           print the report as JSON\n  --engine dir     path to the aego source tree\n  --release-json   pack the export and write the signed release.json its copies update from\n  --channel c      update channel of that release: stable or nightly\n  --base-url url   where the archive is downloaded from, update.url/<channel> by default\n  --key-file file  private key that signs release.json, from aego release keygen"
  }
  msg "cli.icons.usage" {
    text="usage: aego icons [check|list] [dir] [flags]\n\n  check            fail on icons that are used but missing, or provided but unused\n  list [--json]    print the icon manifest as markdown, or as JSON\n       [--out f]   write it to a file instead of stdout"
  }
  msg "cli.import.flag.force" {
    text="ignore the artifact cache"
  }
  msg "cli.new.flag.engine" {
    text="path to the aego source tree for native projects and examples"
