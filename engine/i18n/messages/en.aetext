  msg "cli.export.usage" {
    text="usage: aego export [dir] [flags]\n\n  --target host|linux|windows|darwin[/amd64|/arm64]|web   default host\n  --development | --release                           default development\n  --out dir        output directory, default <project>/exports/<os>-<arch>-<profile>\n  --cc compiler    C compiler for a cross target, or CC_<OS>_<ARCH>\n  --check          run the pre-export checks only\n  --json           print the report as JSON\n  --engine dir     path to the aego source tree"
  }
  msg "cli.icons.usage" {
    text="usage: aego icons [check|list] [dir] [flags]\n\n  check            fail on icons that are used but missing, or provided but unused\n  list [--json]    print the icon manifest as markdown, or as JSON\n       [--out f]   write it to a file instead of stdout"
  }
  msg "cli.import.flag.force" {
