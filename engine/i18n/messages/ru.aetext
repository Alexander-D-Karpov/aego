  msg "cli.docs.usage" {
    text="использование: aego docs <команда> [флаги]\n\n  export [--out файл]          записать реестр документации в JSON\n  check [--strict]             битые ссылки, правила стиля (DOC010–DOC023), привязки без описаний\n  report [--json]              все страницы: вводный абзац, примеры и найденное\n  build [--out site] [--demo] собрать статический сайт с песочницей\n  serve [--addr host:port]     собрать, раздать на localhost и пересобирать при изменениях\n\nфлаги: --project папка, --engine папка, --playground=false"
  }
