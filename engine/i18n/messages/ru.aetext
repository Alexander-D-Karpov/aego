  msg "cli.source_recovery.confirm_required" {
    text="для восстановления нужен --confirm; сначала проверьте status"
  }
  msg "cli.source_recovery.finished" {
    text="Транзакция уже завершена; restore --confirm только закончит очистку файлов восстановления."
  }
  msg "cli.source_recovery.flag.confirm" {
    text="явно разрешить восстановление прерванной транзакции"
  }
  msg "cli.source_recovery.none" {
    text="Прерванных транзакций исходников не найдено."
  }
  msg "cli.source_recovery.prepared" {
    text="Проверьте эти файлы и закройте редактор. Используйте restore --confirm, только если хотите вернуть прежние исходники."
  }
  msg "cli.source_recovery.resolved" {
    text="Восстановление исходников завершено."
  }
  msg "cli.source_recovery.status" {
    text="Восстановление исходников {id}: {state}"
  }
  msg "cli.source_recovery.usage" {
    text="использование: aego source-recovery status [папка] | restore [папка] --confirm"
  }
  msg "cli.source_recovery.usage_line" {
    text="  source-recovery <status|restore>  проверить или явно восстановить прерванную запись исходников"
  }
  msg "cli.unknown_command" {
    text="неизвестная команда {name}"
  }
  msg "cli.examples.usage" { text="  examples <clone|open|recent|reopen|check|link|inspect>  управление локальными копиями удалённых примеров" }
  msg "editor.art.read_only" { text="Только чтение" }
  msg "editor.art.show_layer" { text="Показать слой" }
  msg "editor.art.hide_layer" { text="Скрыть слой" }
  msg "editor.art.lock_layer" { text="Заблокировать слой" }
  msg "editor.art.unlock_layer" { text="Разблокировать слой" }
  msg "cli.examples.help" { text="Удалённые примеры (только данные; код не запускается)\n  remoteexample clone  -url HTTPS_MANIFEST -approve-origin HTTPS_ORIGIN [-root ПАПКА]\n  remoteexample open   -url HTTPS_MANIFEST -approve-origin HTTPS_ORIGIN [-root ПАПКА]\n  remoteexample recent [-root ПАПКА]\n  remoteexample reopen -id LOCAL_COPY_ID [-root ПАПКА]\n  remoteexample check  -id LOCAL_COPY_ID -approve-origin HTTPS_ORIGIN [-root ПАПКА]\n  remoteexample link   -url HTTPS_MANIFEST [-mode project|scene]\n  remoteexample inspect -link AEGO_URL\n\nclone создаёт независимую редактируемую копию. open сначала открывает последнюю\nлокальную копию вместе с офлайн-правками. check только проверяет обновления,\nне перезаписывая файлы. inspect разбирает ссылку без выдачи разрешений.\nНет доверенных источников по умолчанию: -approve-origin требует точный HTTPS-источник." }
  msg "cli.usage" {
    text="aego <команда> [флаги]\n\n  new <папка> [--template empty|2d|2.5d|3d] [--module m] [--example имя] [--native]\n                         создать проект из шаблона или примера движка\n  run [папка]            импортировать ассеты и запустить игру\n  edit [папка|файл] [--launcher recent|new]\n                         открыть проект или одну из его сцен в редакторе; без проекта открывается лаунчер\n  build [папка]          собрать нативный исполняемый файл\n  export [папка] [--target host|linux|windows|darwin] [--release|--development] [--out папка] [--check] [--json]\n                         собрать игру для распространения, которой не нужны Go и исходники проекта\n  bootstrap [папка]      перегенерировать .aego/generated для нативного модуля без сборки\n  import [папка] [--force] заново импортировать все ассеты\n  check [папка] [--manifest файл] [--explain] [--ensure-meta]  разобрать все документы, проверить файлы .meta и типы в скриптах\n  icons [check|list] [папка] [--json] [--out файл]  сверить используемые иконки с исходниками иконок или вывести манифест\n  test [папка] [-run имя] [-v] [--determinism [--frames n] [--every n] [--seed s] [--scene файл]]\n                         запустить тесты скриптов *_test.aes без окна или запустить игру дважды и сравнить хеши состояния\n  dump script <пакет|Тип> [--func имя]  дизассемблировать пакет скриптов с номерами строк\n  docs export|check|build|serve  реестр документации, сайт и песочница\n  mcp [--project папка] [--watch]   отдать проект ИИ-агенту по MCP (stdio)\n  update [status|check|apply|restore] [--channel stable|nightly]   проверить и поставить новую версию Aego или вернуться к предыдущей\n  release keygen|manifest ...     создать ключ подписи и подписанный release.json релиза\n  scene|prefab|data|refs|asset|schema|project <действие> ...   правка файлов проекта без редактора, см. aego scene help\n  version                вывести версию движка и коммит, из которого собрана программа\n"
  }
