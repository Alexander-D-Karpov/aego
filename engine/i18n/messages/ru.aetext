  msg "cli.export.profiles" {
    text="--release и --development нельзя указывать вместе"
  }
  msg "cli.export.usage" {
    text="использование: aego export [папка] [флаги]\n\n  --target host|linux|windows|darwin[/amd64|/arm64]|web   по умолчанию host\n  --development | --release                           по умолчанию development\n  --out папка      папка вывода, по умолчанию <проект>/exports/<os>-<arch>-<профиль>\n  --cc компилятор  компилятор C для другой платформы, или CC_<OS>_<ARCH>\n  --check          только выполнить проверки перед экспортом\n  --json           вывести отчёт в JSON\n  --engine папка   путь к исходникам aego\n  --release-json   ещё упаковать экспорт и записать подписанный release.json, по которому обновляются копии\n  --channel c      канал этого релиза: stable или nightly\n  --base-url url   откуда скачивается архив, по умолчанию update.url/<канал>\n  --key-file file  закрытый ключ из aego release keygen, которым подписывается release.json"
  }
  msg "cli.icons.usage" {
    text="использование: aego icons [check|list] [папка] [флаги]\n\n  check            ошибка, если иконка используется, но её нет, или есть, но не используется\n  list [--json]    вывести манифест иконок в markdown или JSON\n       [--out f]   записать его в файл, а не в stdout"
  }
