  struct "PlayOptions" module="aego/audio" slots=8 {
    doc="PlayOptions tune one play. Volume and Pitch 0 mean 1; Bus Master plays on the bus of the clip; Unscaled keeps playing while the game is paused."
    field "Volume" {
      type="float"
    }
    field "Pitch" {
      type="float"
    }
    field "Pan" {
      type="float"
    }
    field "Bus" {
      type="enum:aego/audio.Bus"
    }
    field "Loop" {
      type="bool"
    }
    field "FadeIn" {
      type="float"
    }
    field "Priority" {
      type="int"
    }
    field "Unscaled" {
      type="bool"
    }
  }
  struct "Pose" module="aego/camera" slots=3 {
    doc="Pose is a camera position in world units, a rotation in radians and a zoom in pixels per unit."
    field "Position" {
      type="Vec2"
    }
    field "Rotation" {
      type="float"
    }
    field "Zoom" {
      type="float"
    }
  }
