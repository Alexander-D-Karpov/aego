manifest version=6 {
  abi="bcc9a6fcfceb5081d07aca8e74e13f84d4550bf5c2396751025908c518e9d5d9"
  module "aego/action" {
    func "Parallel" {
      params=[]
      result="Handle<aego/action.Action>"
      doc="Parallel makes an action that runs all its steps at once and ends after the last one."
    }
    func "Sequence" {
      params=[]
      result="Handle<aego/action.Action>"
      doc="Sequence makes an action that runs its steps one after another, starting at the next tween update."
      example="yield action.Sequence().Then(tween.Position(node, Vec2{4, 0}, 0.5, curve.OutCubic)).Wait(0.2).Then(tween.ToFloat(node, \"SpriteRenderer.Tint.a\", 0, 0.3, curve.Linear))"
    }
  }
  module "aego/anim" {
    func "EventID" {
      params=["string"]
      result="int"
      names=["name"]
      doc="EventID returns the id of an event declared in Project Settings → Animation, or -1."
      example="hit := anim.EventID(\"Hit\")"
    }
    func "EventName" {
      params=["int"]
      result="string"
      names=["id"]
      doc="EventName returns the name of an animation event, or an empty string for an unknown id."
      example="func OnAnimEvent(id int, payload float) {\n\tif anim.EventName(id) == \"Hit\" {"
    }
    func "ParamIndex" {
      params=["AssetRef<animctrl>", "string"]
      result="int"
      names=["controller", "name"]
      doc="ParamIndex returns the index of a parameter of a controller, or -1."
    }
    func "StateName" {
      params=["AssetRef<animctrl>", "int"]
      result="string"
      names=["controller", "index"]
      doc="StateName returns the name of a state of a controller, or an empty string."
    }
  }
  module "aego/audio" {
    func "Builtin" {
      params=["string"]
      result="AssetRef<audio>"
      names=["name"]
      doc="Builtin returns a clip that ships with the engine: Beep, Click, Hum (loopable) or Melody (loopable)."
      example="audio.Play(audio.Builtin(\"Beep\"))"
    }
    func "BusVolume" {
      params=["enum:aego/audio.Bus"]
      result="float"
      names=["bus"]
      doc="BusVolume returns the session volume of a bus set by SetBusVolume; the player's settings are separate."
    }
    func "ListenerPosition" {
      params=[]
      result="Vec2"
      doc="ListenerPosition returns the last effective listener position in world space, or zero outside Play. It includes the camera fallback when no listener is active."
    }
    func "Music" {
      params=["AssetRef<audio>", "float"]
      result="Handle<aego/audio.Sound>"
      names=["clip", "seconds"]
      doc="Music loops a clip on the music bus, crossfading from the music that played over seconds."
      example="audio.Music(Theme, 1.5)"
    }
    func "Mute" {
      params=["enum:aego/audio.Bus", "bool"]
      result="void"
      names=["bus", "on"]
      doc="Mute silences a bus for this session."
    }
    func "Pause" {
      params=["bool"]
      result="void"
      names=["on"]
      doc="Pause pauses or resumes every sound of this world."
    }
    func "Play" {
      params=["AssetRef<audio>"]
      result="Handle<aego/audio.Sound>"
      names=["clip"]
      doc="Play plays a clip on its bus. The sound stops when the node of the script is destroyed."
      example="audio.Play(Coin)"
    }
    func "PlayAt" {
      params=["AssetRef<audio>", "Vec2"]
      result="Handle<aego/audio.Sound>"
      names=["clip", "position"]
      doc="PlayAt plays a clip at a world position, fading and panning with the distance to the listener."
    }
    func "PlayEvent" {
      params=["AssetRef<data:AudioEvent>"]
      result="Handle<aego/audio.Sound>"
      names=["event"]
      doc="PlayEvent plays an audio event; a spatial event follows the node of the script."
      example="audio.PlayEvent(Jump)"
    }
    func "PlayEventAt" {
      params=["AssetRef<data:AudioEvent>", "Vec2"]
      result="Handle<aego/audio.Sound>"
      names=["event", "position"]
      doc="PlayEventAt plays an audio event at a world position."
    }
    func "PlayWith" {
      params=["AssetRef<audio>", "struct:aego/audio.PlayOptions"]
      result="Handle<aego/audio.Sound>"
      names=["clip", "options"]
      doc="PlayWith plays a clip with options."
      example="audio.PlayWith(Step, audio.PlayOptions{Volume: 0.5, Pitch: 1.1})"
    }
    func "SetBusVolume" {
      params=["enum:aego/audio.Bus", "float"]
      result="void"
      names=["bus", "volume"]
      doc="SetBusVolume sets the session volume of a bus, on top of the player's settings; it is not saved."
    }
    func "StopMusic" {
      params=["float"]
      result="void"
      names=["seconds"]
      doc="StopMusic fades the music out over seconds."
    }
    func "WorldBusGain" {
      params=["enum:aego/audio.Bus"]
      result="float"
      names=["bus"]
      doc="WorldBusGain returns the last zone-selected world-layer target for a bus, or 1 outside Play. It is not the ramped mixer output or the player's settings."
    }
  }
  module "aego/camera" {
    func "Active" {
      params=[]
      result="NodeRef"
      doc="Active returns the virtual camera that drives the main output, or nil."
    }
    func "ActiveOn" {
      params=["string"]
      result="NodeRef"
      names=["output"]
      doc="ActiveOn returns the virtual camera that drives the named output."
    }
    func "BlendTo" {
      params=["NodeRef", "float"]
      result="Handle<aego/camera.Blend>"
      names=["camera", "seconds"]
      doc="BlendTo makes vc active over priorities and blends to it; seconds 0 uses its Blend Time. Release hands control back to priorities."
      example="yield camera.BlendTo(BossCam, 1.5)"
    }
    func "Cut" {
      params=["NodeRef"]
      result="void"
      names=["camera"]
      doc="Cut makes vc active at once, without a blend."
    }
    func "LogicalPose" {
      params=[]
      result="struct:aego/camera.Pose"
      doc="LogicalPose returns the pose of the main output without shake and pixel snapping."
    }
    func "Release" {
      params=["float"]
      result="Handle<aego/camera.Blend>"
      names=["seconds"]
      doc="Release ends BlendTo or Cut on the main output; priorities decide again, blending over seconds or the camera's Blend Time."
    }
    func "RenderPose" {
      params=[]
      result="struct:aego/camera.Pose"
      doc="RenderPose returns the pose the main output was drawn with in the last frame."
    }
    func "ScreenToWorld" {
      params=["Vec2"]
      result="Vec2"
      names=["point"]
      doc="ScreenToWorld converts output pixels to world units with the last drawn view of the main output."
    }
    func "Shake" {
      params=["float"]
      result="void"
      names=["trauma"]
      doc="Shake adds trauma to the main output; shake grows with trauma, which is capped at 1 and fades over time."
      example="camera.Shake(0.4)"
    }
    func "ShakeOn" {
      params=["string", "float"]
      result="void"
      names=["output", "trauma"]
      doc="ShakeOn adds trauma to the named output."
    }
    func "Trauma" {
      params=[]
      result="float"
      doc="Trauma returns the current trauma of the main output, 0 to 1."
    }
    func "WorldToScreen" {
      params=["Vec2"]
      result="Vec2"
      names=["point"]
      doc="WorldToScreen converts world units to output pixels with the last drawn view of the main output."
    }
  }
  module "aego/curve" {
    func "Duration" {
      params=["Curve"]
      result="float"
      names=["curve"]
      doc="Duration returns the time between the first and the last key, 1 for a preset."
      example="t := age / curve.Duration(fade)"
    }
    func "Ease" {
      params=["enum:aego/curve.Easing", "float"]
      result="float"
      names=["easing", "t"]
      doc="Ease returns a preset easing at t, clamped to 0..1."
      example="x := math.Lerp(a, b, curve.Ease(curve.OutCubic, k))"
    }
    func "Eval" {
      params=["Curve", "float"]
      result="float"
      names=["curve", "t"]
      doc="Eval returns the value of a curve at time t; outside its keys the curve repeats as its Before and After settings say."
      example="speed := Speed * curve.Eval(node.Get<Mover>().Accel, elapsed)"
    }
    func "EvalClamped" {
      params=["Curve", "float"]
      result="float"
      names=["curve", "t"]
      doc="EvalClamped returns the value at t clamped to the first and last key."
      example="k := curve.EvalClamped(fade, age)"
    }
    const "InBack" {
      type="enum:aego/curve.Easing"
      int=14
      float=0
      bool=false
      str=""
      doc="InBack pulls back past the start before it moves, like a wind-up."
    }
    const "InBounce" {
      type="enum:aego/curve.Easing"
      int=20
      float=0
      bool=false
      str=""
      doc="InBounce bounces off the start with growing hops before it goes."
    }
    const "InCubic" {
      type="enum:aego/curve.Easing"
      int=5
      float=0
      bool=false
      str=""
      doc="InCubic starts slowly and speeds up, more strongly than InQuad."
    }
    const "InElastic" {
      type="enum:aego/curve.Easing"
      int=17
      float=0
      bool=false
      str=""
      doc="InElastic wobbles around the start with growing swings, then springs to the end."
    }
    const "InExpo" {
      type="enum:aego/curve.Easing"
      int=11
      float=0
      bool=false
      str=""
      doc="InExpo barely moves at first, then covers nearly all the way at the end."
    }
    const "InOutBack" {
      type="enum:aego/curve.Easing"
      int=16
      float=0
      bool=false
      str=""
      doc="InOutBack pulls back past the start and goes past the end before it settles."
    }
    const "InOutBounce" {
      type="enum:aego/curve.Easing"
      int=22
      float=0
      bool=false
      str=""
      doc="InOutBounce bounces off the start and bounces on the end."
    }
    const "InOutCubic" {
      type="enum:aego/curve.Easing"
      int=7
      float=0
      bool=false
      str=""
      doc="InOutCubic is slow at both ends and fast in the middle, more strongly than InOutQuad."
    }
    const "InOutElastic" {
      type="enum:aego/curve.Easing"
      int=19
      float=0
      bool=false
      str=""
      doc="InOutElastic wobbles around both the start and the end."
    }
    const "InOutExpo" {
      type="enum:aego/curve.Easing"
      int=13
      float=0
      bool=false
      str=""
      doc="InOutExpo waits at the start, rushes through the middle and creeps to the end."
    }
    const "InOutQuad" {
      type="enum:aego/curve.Easing"
      int=4
      float=0
      bool=false
      str=""
      doc="InOutQuad is slow at both ends and fastest in the middle, gently: for moves between two rest positions."
    }
    const "InOutSine" {
      type="enum:aego/curve.Easing"
      int=10
      float=0
      bool=false
      str=""
      doc="InOutSine is slow at both ends, the softest of the curves: for breathing, bobbing and fades."
    }
    const "InQuad" {
      type="enum:aego/curve.Easing"
      int=2
      float=0
      bool=false
      str=""
      doc="InQuad starts slowly and speeds up, gently: for things that set off, such as a door starting to open."
    }
    const "InSine" {
      type="enum:aego/curve.Easing"
      int=8
      float=0
      bool=false
      str=""
      doc="InSine starts slowly and speeds up, the softest of the curves."
    }
    const "Linear" {
      type="enum:aego/curve.Easing"
      int=1
      float=0
      bool=false
      str=""
      doc="Linear moves at a constant speed from start to end."
    }
    const "OutBack" {
      type="enum:aego/curve.Easing"
      int=15
      float=0
      bool=false
      str=""
      doc="OutBack goes past the end and settles back: for a pop or a bounce-in."
    }
    const "OutBounce" {
      type="enum:aego/curve.Easing"
      int=21
      float=0
      bool=false
      str=""
      doc="OutBounce reaches the end and bounces on it like a dropped ball."
    }
    const "OutCubic" {
      type="enum:aego/curve.Easing"
      int=6
      float=0
      bool=false
      str=""
      doc="OutCubic starts fast and slows down to the end, more strongly than OutQuad."
    }
    const "OutElastic" {
      type="enum:aego/curve.Easing"
      int=18
      float=0
      bool=false
      str=""
      doc="OutElastic springs past the end and wobbles around it as it settles, like a spring."
    }
    const "OutExpo" {
      type="enum:aego/curve.Easing"
      int=12
      float=0
      bool=false
      str=""
      doc="OutExpo covers nearly all the way at once, then creeps to the end: for snappy UI."
    }
    const "OutQuad" {
      type="enum:aego/curve.Easing"
      int=3
      float=0
      bool=false
      str=""
      doc="OutQuad starts fast and slows down gently to the end: the usual choice for UI that slides in."
    }
    const "OutSine" {
      type="enum:aego/curve.Easing"
      int=9
      float=0
      bool=false
      str=""
      doc="OutSine starts fast and slows down to the end, the softest of the curves."
    }
  }
  module "aego/data" {}
  module "aego/debug" {
    func "Arrow" {
      params=["Vec2", "Vec2", "Color"]
      result="void"
      names=["from", "to", "color"]
      doc="Arrow draws an arrow from one point to another."
      example="debug.Arrow(p, p + body.Velocity * 0.2, Color{0, 1, 0, 1})"
    }
    func "Circle" {
      params=["Vec2", "float", "Color"]
      result="void"
      names=["center", "radius", "color"]
      doc="Circle draws a circle outline with radius r in world units."
      example="debug.Circle(node.WorldPosition(), SightRange, Color{0, 0.6, 1, 1})"
    }
    func "Clear" {
      params=["string"]
      result="void"
      names=["channel"]
      doc="Clear removes every primitive whose channel starts with prefix."
      example="debug.Clear(\"ai\")"
    }
    func "Cross" {
      params=["Vec2", "float", "Color"]
      result="void"
      names=["p", "size", "color"]
      doc="Cross draws a cross of the given size in world units."
      example="debug.Cross(goal, 0.5, Color{1, 0, 1, 1})"
    }
    func "Line" {
      params=["Vec2", "Vec2", "Color"]
      result="void"
      names=["a", "b", "color"]
      doc="Line draws a line in world units. It lasts one frame unless Pen sets a lifetime."
      example="debug.Line(node.WorldPosition(), Target.WorldPosition(), Color{1, 0, 0, 1})"
    }
    func "Pen" {
      params=["string", "float"]
      result="void"
      names=["channel", "ttl"]
      doc="Pen sets the channel and the lifetime of the next primitives this script draws. A ttl of 0 lasts one frame, a positive ttl that many game seconds, a negative ttl until Clear."
      example="debug.Pen(\"ai.path\", 2)"
    }
    func "PenUnscaled" {
      params=["string", "float"]
      result="void"
      names=["channel", "ttl"]
      doc="PenUnscaled is Pen with a lifetime in real seconds; such primitives fade out while the game is paused."
      example="debug.PenUnscaled(\"ui\", 1)"
    }
    func "Point" {
      params=["Vec2", "Color"]
      result="void"
      names=["p", "color"]
      doc="Point marks a point with a small cross of constant screen size."
      example="debug.Point(hit.Point, Color{1, 0, 0, 1})"
    }
    func "Ray" {
      params=["Vec2", "Vec2", "Color"]
      result="void"
      names=["origin", "dir", "color"]
      doc="Ray draws an arrow from origin along dir; the length of dir is the length of the arrow."
      example="debug.Ray(node.WorldPosition(), Vec2{0, 2}, Color{1, 1, 0, 1})"
    }
    func "Rect" {
      params=["Rect", "Color"]
      result="void"
      names=["rect", "color"]
      doc="Rect draws a rectangle outline."
      example="debug.Rect(Rect{0, 0, 4, 2}, Color{1, 1, 1, 1})"
    }
    func "Text" {
      params=["Vec2", "string", "Color"]
      result="void"
      names=["p", "text", "color"]
      doc="Text draws a label at a world position; it keeps its screen size at any zoom."
      example="debug.Text(node.WorldPosition(), string(state), Color{1, 1, 1, 1})"
    }
  }
  module "aego/input" {
    func "ActiveDevice" {
      params=[]
      result="int"
      doc="ActiveDevice returns the device player 0 used last: -1 none, 0 keyboard and mouse, 1 to 4 a gamepad."
      example="onPad := input.ActiveDevice() > 0"
    }
    func "Axis" {
      params=["string"]
      result="float"
      names=["action"]
      doc="Axis returns the value of an axis action from -1 to 1, or the press strength of a button action."
      example="x := input.Axis(\"Move\")"
    }
    func "Axis2" {
      params=["string"]
      result="Vec2"
      names=["action"]
      doc="Axis2 returns a 2D action as a vector no longer than 1; Y grows downward like the 2D world."
      example="v := input.Axis2(\"Move\") * Speed"
    }
    func "Axis2P" {
      params=["int", "string"]
      result="Vec2"
      names=["player", "action"]
      doc="Axis2P is Axis2 for one player."
      example="v := input.Axis2P(1, \"Move\")"
    }
    func "AxisP" {
      params=["int", "string"]
      result="float"
      names=["player", "action"]
      doc="AxisP is Axis for one player."
      example="x := input.AxisP(1, \"Move\")"
    }
    func "BeginRebind" {
      params=["string", "int"]
      result="bool"
      names=["action", "slot"]
      doc="BeginRebind waits for the next key, button or stick and binds it to the slot of the action. Escape cancels."
      example="input.BeginRebind(\"Jump\", 0)"
    }
    func "Buffered" {
      params=["string", "float"]
      result="bool"
      names=["action", "window"]
      doc="Buffered reports whether the action was pressed in the last window game seconds and not consumed. A window of 0 uses the action's buffer setting."
      example="if grounded && input.Buffered(\"Jump\", 0) {\n\tinput.Consume(\"Jump\")\n}"
    }
    func "Consume" {
      params=["string"]
      result="void"
      names=["action"]
      doc="Consume clears the press and the buffer of the action, so later readers this frame do not see it."
      example="input.Consume(\"Jump\")"
    }
    func "DeviceChanged" {
      params=[]
      result="bool"
      doc="DeviceChanged is true for the frame a gamepad was connected or removed."
      example="if input.DeviceChanged() {"
    }
    func "Down" {
      params=["enum:aego/input.Key"]
      result="bool"
      names=["key"]
      doc="Down reports whether a raw key is held. For prototypes; release builds use actions."
      example="if input.Down(input.KeyShift) {"
    }
    func "Glyph" {
      params=["string"]
      result="string"
      names=["action"]
      doc="Glyph returns the binding of the action for the active device as text, like [Space] or [A]."
      example="hint.Text = \"Jump \" + input.Glyph(\"Jump\")"
    }
    func "Held" {
      params=["string"]
      result="bool"
      names=["action"]
      doc="Held reports whether the action is active."
      example="if input.Held(\"Run\") {"
    }
    func "HeldP" {
      params=["int", "string"]
      result="bool"
      names=["player", "action"]
      doc="HeldP is Held for one player."
      example="if input.HeldP(1, \"Run\") {"
    }
    func "KeyPressed" {
      params=["enum:aego/input.Key"]
      result="bool"
      names=["key"]
      doc="KeyPressed reports whether a raw key went down this frame. For prototypes."
      example="if input.KeyPressed(input.KeyF5) {"
    }
    func "KeyReleased" {
      params=["enum:aego/input.Key"]
      result="bool"
      names=["key"]
      doc="KeyReleased reports whether a raw key went up this frame. For prototypes."
      example="if input.KeyReleased(input.KeySpace) {"
    }
    func "MouseDown" {
      params=["enum:aego/input.Button"]
      result="bool"
      names=["button"]
      doc="MouseDown reports whether a mouse button is held."
      example="if input.MouseDown(input.MouseLeft) {"
    }
    func "MousePos" {
      params=[]
      result="Vec2"
      doc="MousePos returns the cursor in logical pixels of the game area."
      example="p := input.MousePos()"
    }
    func "MousePressed" {
      params=["enum:aego/input.Button"]
      result="bool"
      names=["button"]
      doc="MousePressed reports whether a mouse button went down this frame."
      example="if input.MousePressed(input.MouseRight) {"
    }
    func "MouseWorld" {
      params=[]
      result="Vec2"
      doc="MouseWorld returns the cursor in world units through the camera under it."
      example="target := input.MouseWorld()"
    }
    func "Pointer" {
      params=[]
      result="Vec2"
      doc="Pointer returns the cursor in logical pixels."
      example="p := input.Pointer()"
    }
    func "PointerDelta" {
      params=[]
      result="Vec2"
      doc="PointerDelta returns how far the cursor moved this frame."
      example="look += input.PointerDelta()"
    }
    func "PopContext" {
      params=[]
      result="void"
      doc="PopContext removes the top input context."
      example="input.PopContext()"
    }
    func "Pressed" {
      params=["string"]
      result="bool"
      names=["action"]
      doc="Pressed reports whether the action started. In Update it is true for one frame; in FixedUpdate for the first fixed step after the press."
      example="if input.Pressed(\"Attack\") {"
    }
    func "PressedP" {
      params=["int", "string"]
      result="bool"
      names=["player", "action"]
      doc="PressedP is Pressed for one player."
      example="if input.PressedP(1, \"Jump\") {"
    }
    func "PushContext" {
      params=["string"]
      result="void"
      names=["context"]
      doc="PushContext puts an input context on top of the stack."
      example="input.PushContext(\"Menu\")"
    }
    func "RebindConflict" {
      params=[]
      result="string"
      doc="RebindConflict names the action that already used the new control, or explains why it was refused."
      example="if input.RebindConflict() != \"\" {"
    }
    func "Rebinding" {
      params=[]
      result="bool"
      doc="Rebinding reports whether a rebind waits for input."
      example="if input.Rebinding() {"
    }
    func "Released" {
      params=["string"]
      result="bool"
      names=["action"]
      doc="Released reports whether the action ended this frame or fixed step."
      example="if input.Released(\"Jump\") {"
    }
    func "ReleasedP" {
      params=["int", "string"]
      result="bool"
      names=["player", "action"]
      doc="ReleasedP is Released for one player."
      example="if input.ReleasedP(1, \"Jump\") {"
    }
    func "ResetBinding" {
      params=["string"]
      result="void"
      names=["action"]
      doc="ResetBinding restores the project bindings of the action."
      example="input.ResetBinding(\"Jump\")"
    }
    func "ResetBindings" {
      params=[]
      result="void"
      doc="ResetBindings restores every project binding."
      example="input.ResetBindings()"
    }
    func "SaveBindings" {
      params=[]
      result="void"
      doc="SaveBindings writes the player's settings profile now; changes are also saved on their own."
      example="input.SaveBindings()"
    }
    func "SetContext" {
      params=["string"]
      result="void"
      names=["context"]
      doc="SetContext replaces the whole stack with one context."
      example="input.SetContext(\"Gameplay\")"
    }
    const "KeyA" {
      type="enum:aego/input.Key"
      int=4
      float=0
      bool=false
      str=""
      doc="The A key."
    }
    const "KeyB" {
      type="enum:aego/input.Key"
      int=5
      float=0
      bool=false
      str=""
      doc="The B key."
    }
    const "KeyBackspace" {
      type="enum:aego/input.Key"
      int=42
      float=0
      bool=false
      str=""
      doc="The Backspace key."
    }
    const "KeyC" {
      type="enum:aego/input.Key"
      int=6
      float=0
      bool=false
      str=""
