  struct "Contact" module="aego/physics" slots=6 {
    doc="Contact describes a touch between two colliders from the receiver's side.\nNormal points from the other body into this one, RelativeVelocity is this body's velocity relative to the other at Point."
    field "Point" {
      type="Vec2"
    }
    field "Normal" {
      type="Vec2"
    }
    field "NormalImpulse" {
      type="float"
    }
    field "RelativeVelocity" {
      type="Vec2"
    }
    field "SelfCollider" {
      type="NodeRef"
    }
    field "OtherCollider" {
      type="NodeRef"
    }
  }
  struct "RayHit" module="aego/physics" slots=6 {
    doc="RayHit is the result of a ray query. Hit is false when nothing was found; Node is the body, Collider the node of the shape that was hit."
    field "Hit" {
      type="bool"
    }
    field "Point" {
      type="Vec2"
    }
    field "Normal" {
      type="Vec2"
    }
    field "Distance" {
      type="float"
    }
    field "Node" {
      type="NodeRef"
    }
    field "Collider" {
      type="NodeRef"
    }
  }
  handle "aego/action.Action" await=true {
    doc="Action runs tweens, timers and other actions one after another or together; yield a waits until it ends."
  }
  handle "aego/timer.Timer" await=true {
    doc="Timer counts down and fires. yield t waits for the next fire or the end; a timer dies with the node of the script that made it."
  }
  handle "aego/tween.Tween" await=true {
    doc="Tween animates one property of a node. A finished, stopped or nil tween reads as done; yield t waits until it ends."
  }
  event "OnCollisionEnter" {
    params=["NodeRef", "struct:aego/physics.Contact"]
    names=["other", "contact"]
    doc="OnCollisionEnter runs after the physics step in which this body started touching other."
  }
  event "OnCollisionStay" {
    params=["NodeRef", "struct:aego/physics.Contact"]
    names=["other", "contact"]
    doc="OnCollisionStay runs after every later physics step while the bodies keep touching. It costs nothing when no script declares it."
  }
  event "OnCollisionExit" {
    params=["NodeRef", "struct:aego/physics.Contact"]
    names=["other", "contact"]
    doc="OnCollisionExit runs when the bodies stop touching, including when one of them is destroyed or disabled. Contact.Point is the last known point."
  }
  event "OnTriggerEnter" {
    params=["NodeRef"]
    names=["other"]
    doc="OnTriggerEnter runs when other's collider entered a trigger of this body, or this body entered other's trigger."
  }
  event "OnTriggerExit" {
    params=["NodeRef"]
    names=["other"]
    doc="OnTriggerExit runs when the overlap with a trigger ends."
  }
  event "OnSettingChanged" {
    params=["string"]
    names=["id"]
    doc="OnSettingChanged runs on every script with this method after a setting's effective value changed: Apply, Revert, an override or a confirmation timeout."
  }
  event "OnSpawned" {
    params=[]
    doc="OnSpawned runs on every script of a spawned prefab copy, after Ready for a new copy and instead of it for a copy taken from a pool."
  }
  event "OnDespawned" {
    params=[]
    doc="OnDespawned runs on every script of a pooled copy when it is despawned, before its coroutines and connections end."
  }
  event "OnSave" {
    params=[]
    doc="OnSave runs on every script that has it while a game is saved; write values with save.Put*."
  }
  event "OnLoad" {
    params=[]
    doc="OnLoad runs after Ready on every script that has it when a saved game is loaded; read values with save.Get*."
  }
  method "AddTag" recv="NodeRef" {
    params=["string"]
    result="bool"
    names=["tag"]
    doc="AddTag adds a tag and returns false when it is malformed."
    example="node.AddTag(\"Enemy.Stunned\")"
  }
  method "Child" recv="NodeRef" {
    params=["string"]
    result="NodeRef"
    names=["name"]
    doc="Child returns the direct child with this name, or nil."
    example="gun := node.Child(\"Gun\")"
  }
  method "Destroy" recv="NodeRef" {
    params=[]
    result="void"
    doc="Destroy removes the node and its children at the end of the phase."
    example="node.Destroy()"
  }
  method "Enabled" recv="NodeRef" {
    params=[]
    result="bool"
    doc="Enabled reports the node's own enabled flag, ignoring its parents."
    example="if !Door.Enabled() {"
  }
  method "Find" recv="NodeRef" {
    params=["string"]
    result="NodeRef"
    names=["path"]
    doc="Find resolves a path relative to the node: Weapon/Gun, ../Sibling or /Root/Player."
    example="muzzle := node.Find(\"Weapon/Muzzle\")"
  }
  method "HasTag" recv="NodeRef" {
    params=["string"]
    result="bool"
    names=["tag"]
    doc="HasTag reports whether the node has the tag or a tag under it: Enemy matches Enemy.Flying."
    example="if other.HasTag(\"Enemy\") {"
  }
  method "IsAlive" recv="NodeRef" {
    params=[]
    result="bool"
    doc="IsAlive reports whether the node exists. It is false right after Destroy."
    example="if Target != nil && Target.IsAlive() {"
  }
  method "IsPrefabInstance" recv="NodeRef" {
    params=[]
    result="bool"
    doc="IsPrefabInstance reports whether the node is a prefab copy or lies inside one."
    example="if node.IsPrefabInstance() {"
  }
  method "Name" recv="NodeRef" {
    params=[]
    result="string"
    doc="Name returns the node name, unique among its siblings."
    example="log.Info(node.Name())"
  }
  method "Parent" recv="NodeRef" {
    params=[]
    result="NodeRef"
    doc="Parent returns the parent node, or nil for top-level nodes."
    example="owner := node.Parent()"
  }
  method "Position" recv="NodeRef" {
    params=[]
    result="Vec2"
    doc="Position returns the local position relative to the parent."
    example="p := node.Position()"
  }
  method "Position3" recv="NodeRef" {
    params=[]
    result="Vec3"
    doc="Position3 returns the local 3D position."
    example="p := node.Position3()"
  }
  method "PrefabRoot" recv="NodeRef" {
    params=[]
    result="NodeRef"
    doc="PrefabRoot returns the root of the nearest prefab copy that holds the node, the node itself for a root, or nil."
    example="owner := node.PrefabRoot()\nowner.Destroy()"
  }
  method "RemoveTag" recv="NodeRef" {
    params=["string"]
    result="bool"
    names=["tag"]
    doc="RemoveTag removes a tag and returns whether the node had it."
  }
  method "Rotation" recv="NodeRef" {
    params=[]
    result="float"
    doc="Rotation returns the local rotation in radians, clockwise."
    example="a := node.Rotation()"
  }
  method "Rotation3" recv="NodeRef" {
    params=[]
    result="Quat"
    doc="Rotation3 returns the local 3D rotation."
    example="q := node.Rotation3()"
  }
  method "Scale" recv="NodeRef" {
    params=[]
    result="Vec2"
    doc="Scale returns the local scale."
    example="s := node.Scale()"
  }
  method "SetEnabled" recv="NodeRef" {
    params=["bool"]
    result="void"
    names=["enabled"]
    doc="SetEnabled turns the node on or off. Disabled nodes and their children are not drawn."
    example="Shield.SetEnabled(false)"
  }
  method "SetPosition" recv="NodeRef" {
    params=["Vec2"]
    result="void"
    names=["p"]
    doc="SetPosition sets the local position."
    example="node.SetPosition(node.Position() + velocity * dt)"
  }
  method "SetPosition3" recv="NodeRef" {
    params=["Vec3"]
    result="void"
    names=["p"]
    doc="SetPosition3 sets the local 3D position."
    example="node.SetPosition3(node.Position3() + Vec3{0, 0, -Speed * dt})"
  }
  method "SetRotation" recv="NodeRef" {
    params=["float"]
    result="void"
    names=["radians"]
    doc="SetRotation sets the local rotation in radians."
    example="node.SetRotation(node.Rotation() + Spin * dt)"
  }
  method "SetRotation3" recv="NodeRef" {
    params=["Quat"]
    result="void"
    names=["q"]
    doc="SetRotation3 sets the local 3D rotation."
    example="node.SetRotation3(math.QuatEuler(0, angle, 0))"
  }
  method "SetScale" recv="NodeRef" {
    params=["Vec2"]
    result="void"
    names=["scale"]
    doc="SetScale sets the local scale. A negative X mirrors the node."
    example="node.SetScale(Vec2{-1, 1})"
  }
  method "SetTransform2D" recv="NodeRef" {
    params=["Transform2D"]
    result="void"
    names=["t"]
    doc="SetTransform2D replaces the local 2D transform."
    example="node.SetTransform2D(t)"
  }
  method "SetTransform3D" recv="NodeRef" {
    params=["Transform3D"]
    result="void"
    names=["t"]
    doc="SetTransform3D replaces the local 3D transform."
    example="node.SetTransform3D(t)"
  }
  method "Space" recv="NodeRef" {
    params=[]
    result="int"
    doc="Space returns 0 for 2D nodes and 1 for 3D nodes."
    example="if node.Space() == 1 {"
  }
  method "Transform2D" recv="NodeRef" {
    params=[]
    result="Transform2D"
    doc="Transform2D returns a copy of the local 2D transform. Change it and pass it to SetTransform2D."
    example="t := node.Transform2D()\nt.Position.X += 1\nnode.SetTransform2D(t)"
  }
  method "Transform3D" recv="NodeRef" {
    params=[]
    result="Transform3D"
    doc="Transform3D returns a copy of the local 3D transform."
    example="t := node.Transform3D()\nt.Position.Y += 1\nnode.SetTransform3D(t)"
  }
  method "WorldPosition" recv="NodeRef" {
    params=[]
    result="Vec2"
    doc="WorldPosition returns the position in world space, as of the last transform pass."
    example="d := math.Dist(node.WorldPosition(), Target.WorldPosition())"
  }
  cmethod "ApplyForce" comp="physics.Body2D" {
    params=["Vec2"]
    result="void"
    names=["force"]
    doc="ApplyForce pushes the body's center of mass during the next physics step. Call it from FixedUpdate."
  }
  cmethod "ApplyForceAt" comp="physics.Body2D" {
    params=["Vec2", "Vec2"]
    result="void"
    names=["force", "point"]
    doc="ApplyForceAt pushes the body at a world point, which also spins it."
  }
  cmethod "ApplyImpulse" comp="physics.Body2D" {
    params=["Vec2"]
    result="void"
    names=["impulse"]
    doc="ApplyImpulse changes the velocity at once, scaled by mass."
    example="body.ApplyImpulse(Vec2{Y: -jumpImpulse})"
  }
  cmethod "ApplyImpulseAt" comp="physics.Body2D" {
    params=["Vec2", "Vec2"]
    result="void"
    names=["impulse", "point"]
    doc="ApplyImpulseAt applies an impulse at a world point."
  }
  cmethod "ApplyTorque" comp="physics.Body2D" {
    params=["float"]
    result="void"
    names=["torque"]
    doc="ApplyTorque spins the body during the next physics step."
  }
  cmethod "Mass" comp="physics.Body2D" {
    params=[]
    result="float"
    doc="Mass returns the mass computed from the colliders or the override."
  }
  cmethod "MoveTo" comp="physics.Body2D" {
    params=["Vec2", "float"]
    result="void"
    names=["position", "angle"]
    doc="MoveTo drives a kinematic body to the pose by the end of the next physics step, pushing dynamic bodies on the way. Call it from FixedUpdate."
  }
  cmethod "SetAngularVelocity" comp="physics.Body2D" {
    params=["float"]
    result="void"
    names=["velocity"]
    doc="SetAngularVelocity sets the spin in radians per second."
  }
  cmethod "SetVelocity" comp="physics.Body2D" {
    params=["Vec2"]
    result="void"
    names=["velocity"]
    doc="SetVelocity sets the linear velocity in units per second."
  }
  cmethod "Sleep" comp="physics.Body2D" {
    params=[]
    result="void"
    doc="Sleep stops the body until something touches it."
  }
  cmethod "Teleport" comp="physics.Body2D" {
    params=["Vec2", "float"]
    result="void"
    names=["position", "angle"]
    doc="Teleport moves the body to a world pose without sweeping, keeping its velocity."
  }
  cmethod "WakeUp" comp="physics.Body2D" {
    params=[]
    result="void"
    doc="WakeUp makes a sleeping body simulate again."
  }
  hmethod "Done" handle="aego/action.Action" {
    params=[]
    result="bool"
    doc="Done reports whether the action ended, was stopped or is nil."
  }
  hmethod "Running" handle="aego/action.Action" {
    params=[]
    result="bool"
    doc="Running is the opposite of Done."
  }
  hmethod "Stop" handle="aego/action.Action" {
    params=[]
    result="void"
    doc="Stop stops every unfinished step; the properties keep their current values."
  }
  hmethod "Then" handle="aego/action.Action" {
    params=["Handle<aego/tween.Tween>"]
    result="Handle<aego/action.Action>"
    names=["tween"]
    doc="Then adds a tween created in this frame; it waits for its turn."
  }
  hmethod "ThenAction" handle="aego/action.Action" {
    params=["Handle<aego/action.Action>"]
    result="Handle<aego/action.Action>"
    names=["action"]
    doc="ThenAction adds another action that has not started."
  }
  hmethod "ThenTimer" handle="aego/action.Action" {
    params=["Handle<aego/timer.Timer>"]
    result="Handle<aego/action.Action>"
    names=["timer"]
    doc="ThenTimer adds a timer created in this frame; the step ends when the timer ends."
  }
  hmethod "Wait" handle="aego/action.Action" {
    params=["float"]
    result="Handle<aego/action.Action>"
    names=["seconds"]
    doc="Wait adds a pause in game seconds."
  }
  hmethod "Cancel" handle="aego/timer.Timer" {
    params=[]
    result="void"
    doc="Cancel ends the timer without firing."
  }
  hmethod "Count" handle="aego/timer.Timer" {
    params=[]
    result="int"
    doc="Count returns how many times the timer has fired."
  }
  hmethod "Done" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Done reports whether the timer ended, was cancelled or is nil."
  }
  hmethod "Pause" handle="aego/timer.Timer" {
    params=[]
    result="void"
    doc="Pause stops the countdown."
  }
  hmethod "Ready" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Ready reports whether a cooldown can be used."
  }
  hmethod "Remaining" handle="aego/timer.Timer" {
    params=[]
    result="float"
    doc="Remaining returns the seconds left until the next fire."
  }
  hmethod "Repeat" handle="aego/timer.Timer" {
    params=["int"]
    result="Handle<aego/timer.Timer>"
    names=["count"]
    doc="Repeat makes the timer fire n times; -1 repeats until Cancel."
  }
  hmethod "Restart" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Restart starts the countdown again; it does nothing on a one-shot timer that already fired."
  }
  hmethod "Resume" handle="aego/timer.Timer" {
    params=[]
    result="void"
    doc="Resume continues a paused countdown."
  }
  hmethod "Unscaled" handle="aego/timer.Timer" {
    params=[]
    result="Handle<aego/timer.Timer>"
    doc="Unscaled counts real time, also while the game is paused."
  }
  hmethod "Use" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Use takes a ready cooldown and starts its wait; it returns false while the cooldown runs."
  }
  hmethod "Curve" handle="aego/tween.Tween" {
    params=["Curve"]
    result="Handle<aego/tween.Tween>"
    names=["curve"]
    doc="Curve replaces the easing with a curve field; its time range is stretched over the duration."
  }
  hmethod "Delay" handle="aego/tween.Tween" {
    params=["float"]
    result="Handle<aego/tween.Tween>"
    names=["seconds"]
    doc="Delay waits before the tween starts; the start value is read when the delay ends. Call it right after creating the tween."
    example="tween.ToFloat(node, \"Light.Range\", 4, 1, curve.Linear).Delay(0.5)"
  }
  hmethod "Done" handle="aego/tween.Tween" {
    params=[]
    result="bool"
    doc="Done reports whether the tween finished, was stopped or is nil."
  }
  hmethod "Loop" handle="aego/tween.Tween" {
    params=["int"]
    result="Handle<aego/tween.Tween>"
    names=["count"]
    doc="Loop plays the tween n times from the start; -1 repeats until Stop."
  }
  hmethod "PingPong" handle="aego/tween.Tween" {
    params=["int"]
    result="Handle<aego/tween.Tween>"
    names=["legs"]
    doc="PingPong plays n legs, every second one backwards; 2 goes there and back, -1 repeats until Stop."
  }
  hmethod "Running" handle="aego/tween.Tween" {
    params=[]
    result="bool"
    doc="Running is the opposite of Done."
  }
  hmethod "Stop" handle="aego/tween.Tween" {
    params=[]
    result="void"
    doc="Stop ends the tween where it is; the property keeps its current value."
  }
  hmethod "Unscaled" handle="aego/tween.Tween" {
    params=[]
    result="Handle<aego/tween.Tween>"
    doc="Unscaled runs the tween in real time, also while the game is paused."
  }
  hsignal "Completed" handle="aego/action.Action" {
    params=["bool"]
    names=["finished"]
    doc="Completed runs once when the action ends; finished is false after Stop or when the node of its script died."
  }
  hsignal "Fired" handle="aego/timer.Timer" {
    params=["int"]
    names=["count"]
    doc="Fired runs on every fire of the timer; count is the number of fires so far."
  }
  hsignal "Completed" handle="aego/tween.Tween" {
    params=["bool"]
    names=["finished"]
    doc="Completed runs once when the tween ends: finished is true at its natural end, false after Stop, when a new tween on the same property replaced it, or when its node or target is gone."
  }
  component "engine.PrefabInstance" {
    short="PrefabInstance"
    category="engine"
    doc="links a node to the prefab it was created from"
  }
  component "engine.Tags" {
    short="Tags"
    category="engine"
    doc="Tags names groups this node belongs to; scripts find them with scene.WithTag."
  }
  component "engine.SpriteRenderer" {
    short="SpriteRenderer"
    category="engine"
    doc="Draws a texture region at the node transform."
    field "Sprite" {
      type="AssetRef<texture>"
      readonly=false
      doc="Texture or atlas region to draw. Empty draws a solid rectangle in the tint color."
    }
    field "Layer" {
      type="int"
      readonly=false
      doc="Sorting layer. Higher layers are drawn on top of lower ones."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Order inside the layer. Higher values are drawn later, on top."
    }
    field "Tint" {
      type="Color"
      readonly=false
      doc="Color multiplied with the texture. Alpha controls transparency."
    }
    field "Origin" {
      type="Vec2"
      readonly=false
      doc="Pivot in normalized sprite space. (0.5, 0.5) is the center, (0, 0) the top-left corner."
    }
    field "Size" {
      type="Vec2"
      readonly=false
      doc="Size in world units. Zero uses the texture size divided by the camera zoom."
    }
    field "FlipX" {
      type="bool"
      readonly=false
      doc="Mirrors the sprite horizontally."
    }
    field "FlipY" {
      type="bool"
      readonly=false
      doc="Mirrors the sprite vertically."
    }
    field "Blend" {
      type="int"
      readonly=false
      doc="How the sprite blends with what is behind it: premultiplied alpha, opaque or additive."
    }
    field "Filter" {
      type="int"
      readonly=false
      doc="Texture sampling: nearest keeps pixel art sharp, linear smooths it."
    }
  }
  component "engine.Camera2D" {
    short="Camera2D"
    category="engine"
    doc="Renders an orthographic view from the node transform."
    field "Zoom" {
      type="float"
      readonly=false
      doc="Pixels per world unit. Larger values show a smaller part of the world."
    }
    field "Viewport" {
      type="Rect"
      readonly=false
      doc="Part of the screen the camera draws into, in normalized coordinates."
    }
    field "Mask" {
      type="int"
      readonly=false
      doc="Visibility layers this camera renders. -1 renders every layer."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Cameras with a lower order render first."
    }
    field "Clear" {
      type="bool"
      readonly=false
      doc="Clears the viewport before drawing."
    }
    field "ClearColor" {
      type="Color"
      readonly=false
      doc="Background color used when clear is on."
    }
    field "Scale" {
      type="int"
      readonly=false
      doc="How the view adapts to the window: free, pixelPerfect or fitVirtual."
    }
    field "Virtual" {
      type="Vec2"
      readonly=false
      doc="Virtual resolution used by fitVirtual and pixelPerfect."
    }
    field "Active" {
      type="bool"
      readonly=false
      doc="Only active cameras render."
    }
  }
  component "engine.Camera3D" {
    short="Camera3D"
    category="engine"
    doc="Renders a perspective view looking down the node -Z axis."
    field "Fov" {
      type="float"
      readonly=false
      doc="Vertical field of view in degrees."
    }
    field "Near" {
      type="float"
      readonly=false
      doc="Distance to the near clipping plane."
    }
    field "Far" {
      type="float"
      readonly=false
      doc="Distance to the far clipping plane."
    }
    field "Viewport" {
      type="Rect"
      readonly=false
      doc="Part of the screen the camera draws into, in normalized coordinates."
    }
    field "Mask" {
      type="int"
      readonly=false
      doc="Visibility layers this camera renders. -1 renders every layer."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Cameras with a lower order render first."
    }
    field "Clear" {
      type="bool"
      readonly=false
      doc="Clears the viewport before drawing."
    }
    field "ClearColor" {
      type="Color"
      readonly=false
      doc="Background color used when clear is on."
    }
    field "Active" {
      type="bool"
      readonly=false
      doc="Only active cameras render."
    }
    field "Orthographic" {
      type="bool"
      readonly=false
      doc="Projects without perspective; sprites and meshes keep their size at any depth."
    }
    field "OrthoSize" {
      type="float"
      readonly=false
      doc="Half of the vertical extent in world units when orthographic is on."
    }
  }
  component "engine.MeshRenderer" {
    short="MeshRenderer"
    category="engine"
    doc="Draws an unlit mesh at the node transform."
    field "Mesh" {
      type="AssetRef<mesh>"
      readonly=false
      doc="Mesh to draw: an imported .obj or a builtin Cube, Plane, Sphere or Cylinder."
    }
    field "Texture" {
      type="AssetRef<texture>"
      readonly=false
      doc="Texture mapped onto the mesh. Empty uses white."
    }
    field "Color" {
      type="Color"
      readonly=false
      doc="Color multiplied with the texture."
    }
    field "Blend" {
      type="int"
      readonly=false
      doc="Opaque writes depth. Premultiplied and additive are drawn after opaque meshes."
    }
    field "DoubleSided" {
      type="bool"
      readonly=false
      doc="Draws the back faces too."
    }
    field "Layer" {
      type="int"
      readonly=false
      doc="Sorting layer for transparent meshes."
    }
    field "Filter" {
      type="int"
      readonly=false
      doc="Texture sampling: nearest or linear."
    }
  }
  component "physics.Body2D" {
    short="Body2D"
    category="physics"
    doc="Simulates the node as a rigid body. Colliders on the node and its children form its shape."
    field "Type" {
      type="int"
      readonly=false
      doc="static never moves, kinematic moves by velocity, dynamic reacts to forces and contacts."
    }
    field "MassMode" {
      type="int"
      readonly=false
      doc="auto takes the mass from collider density, override uses Mass."
    }
    field "Mass" {
      type="float"
      readonly=false
    }
    field "GravityScale" {
      type="float"
      readonly=false
      doc="Multiplier of the project gravity for this body."
    }
    field "LinearDamping" {
      type="float"
      readonly=false
    }
    field "AngularDamping" {
      type="float"
      readonly=false
    }
    field "FixedRotation" {
      type="bool"
      readonly=false
    }
    field "Bullet" {
      type="bool"
      readonly=false
    }
    field "AllowSleep" {
      type="bool"
      readonly=false
    }
