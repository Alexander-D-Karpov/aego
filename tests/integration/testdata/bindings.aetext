      type="float"
      readonly=false
      doc="Seconds of game time before the node comes back."
    }
    field "RestoreHealth" {
      type="bool"
      readonly=false
      doc="Revives Health with full hit points."
    }
    field "ResetVelocity" {
      type="bool"
      readonly=false
      doc="Stops a Motion 2D on respawn."
    }
    field "Persist" {
      type="bool"
      readonly=false
      doc="Saves the respawn point with the game."
    }
  }
  component "gameplay.Pickup2D" {
    short="Pickup2D"
    category="gameplay"
    doc="Fires Collected when a node enters the area; with Once the pickup then disappears."
    builtin=true
    field "Area" {
      type="Rect"
      readonly=false
      doc="Rectangle in this node's space."
    }
    field "Tag" {
      type="string"
      readonly=false
      doc="Only nodes with this tag; empty accepts every node with Motion 2D."
    }
    field "Once" {
      type="bool"
      readonly=false
      doc="Removes the pickup after the first collection."
    }
    field "Despawn" {
      type="bool"
      readonly=false
      doc="Returns the pickup to its pool instead of destroying it."
    }
  }
  component "gameplay.StateMachine" {
    short="StateMachine"
    category="gameplay"
    doc="Named states with Enter, Exit, Fixed and Update hooks found by name on the node's scripts: EnterRun(), ExitRun(), FixedRun(dt), UpdateRun(dt). Scripts change the state with Go."
    builtin=true
    field "Initial" {
      type="string"
      readonly=false
      doc="State entered when the node starts, after the scripts' Ready. Empty uses the first state."
    }
    field "Current" {
      type="string"
      readonly=true
      doc="State now."
    }
    field "Previous" {
      type="string"
      readonly=true
      doc="State before the last change."
    }
    field "Time" {
      type="float"
      readonly=true
      doc="Seconds of fixed steps spent in the current state."
    }
    field "Index" {
      type="int"
      readonly=true
      doc="Index of the current state in States."
    }
  }
  component "save.Persist" {
    short="Persist"
    category="save"
    doc="Saves the node's transform and enabled flag in save games."
    builtin=true
    field "NoTransform" {
      type="bool"
      readonly=false
      doc="Leaves the transform out of save games, for nodes whose position comes from elsewhere."
    }
    field "NoEnabled" {
      type="bool"
      readonly=false
      doc="Leaves the enabled flag out of save games."
    }
  }
  component "particles.ParticleSystem2D" {
    short="ParticleSystem2D"
    category="particles"
    doc="Emits visual sprites from a bounded CPU pool. World-space particles stay at their birth location when the emitter moves."
    builtin=true
    field "Prewarm" {
      type="float"
      readonly=false
      doc="Seconds of bounded preparation for a looping effect, up to two."
    }
    field "EdgeA" {
      type="Vec2"
      readonly=false
      doc="First endpoint in emitter coordinates."
    }
    field "EdgeB" {
      type="Vec2"
      readonly=false
      doc="Second endpoint in emitter coordinates."
    }
    field "Mask" {
      type="AssetRef<texture>"
      readonly=false
      doc="Source sprite frame. Its prepared alpha mask is independent of atlas packing."
    }
    field "MaskThreshold" {
      type="float"
      readonly=false
      doc="Minimum source alpha used by the sprite mask, from zero to one."
    }
    field "FrameFPS" {
      type="float"
      readonly=false
      doc="Flipbook playback speed in frames per second."
    }
    field "FrameLoop" {
      type="bool"
      readonly=false
      doc="Repeat the flipbook; otherwise hold its last frame."
    }
    field "SortMode" {
      type="int"
      readonly=false
      doc="Oldest first, youngest first or farthest first for each camera."
    }
    field "ReducedMotion" {
      type="int"
      readonly=false
      doc="Keep, reduce or hide this effect when Reduce Motion is enabled."
    }
    field "ReducedRate" {
      type="float"
      readonly=false
      doc="Fraction of births kept under the Reduce policy."
    }
    field "Drag" {
      type="float"
      readonly=false
      doc="Nonnegative damping coefficient per second."
    }
    field "NoiseStrength" {
      type="float"
      readonly=false
      doc="Magnitude of deterministic presentation noise."
    }
    field "NoiseFrequency" {
      type="float"
      readonly=false
      doc="How fast the noise field changes."
    }
    field "KillYEnabled" {
      type="bool"
      readonly=false
      doc="Remove particles on the side of increasing Y past Kill Y."
    }
    field "KillY" {
      type="float"
      readonly=false
      doc="Threshold in simulation space, in world units."
    }
    field "PlaneEnabled" {
      type="bool"
      readonly=false
      doc="Remove particles past the configured clipping plane."
    }
    field "PlaneNormal" {
      type="Vec2"
      readonly=false
      doc="Outward normal of the clipping plane in simulation space."
    }
    field "PlaneDistance" {
      type="float"
      readonly=false
      doc="Plane offset along its normalized normal."
    }
    field "VelocityOverLife" {
      type="Curve"
      readonly=true
      doc="Speed multiplier by normalized age, applied without compounding."
    }
    field "PlayOnStart" {
      type="bool"
      readonly=false
      doc="Starts the emission schedule when this emitter becomes active."
    }
    field "Loop" {
      type="bool"
      readonly=false
      doc="Repeats the schedule at the end of each cycle."
    }
    field "Duration" {
      type="float"
      readonly=false
      doc="Length of one emission cycle in seconds."
    }
    field "TimeDomain" {
      type="int"
      readonly=false
      doc="Game pauses with the world; unscaled uses real presentation time."
    }
    field "Seed" {
      type="int"
      readonly=false
      doc="Nonzero locks the seed. Zero derives it from the session, stable node ID and activation."
    }
    field "MaxParticles" {
      type="int"
      readonly=false
      doc="Maximum live particles. When full, keep living particles and drop excess births."
    }
    field "Rate" {
      type="float"
      readonly=false
      doc="Continuous births per second. Zero allows manual bursts without a continuous stream."
    }
    field "Bursts" {
      type="[]Vec2"
      readonly=true
      doc="Cycle keys as (time in seconds, birth count). Times must be in [0, duration)."
    }
    field "Shape" {
      type="int"
      readonly=false
      doc="Birth positions come from a point, disk, rectangle, line segment or sprite alpha mask."
    }
    field "Offset" {
      type="Vec2"
      readonly=false
      doc="Local offset of the emitter shape."
    }
    field "RectSize" {
      type="Vec2"
      readonly=false
      doc="Full rectangle dimensions in world units."
    }
    field "Radius" {
      type="float"
      readonly=false
      doc="Circle radius in world units."
    }
    field "Lifetime" {
      type="Vec2"
      readonly=false
      doc="Minimum and maximum particle lifetime in seconds."
    }
    field "Speed" {
      type="Vec2"
      readonly=false
      doc="Minimum and maximum initial speed in units per second."
    }
    field "Size" {
      type="Vec2"
      readonly=false
      doc="Minimum and maximum starting side length in world units."
    }
    field "Rotation" {
      type="Vec2"
      readonly=false
      doc="Minimum and maximum initial rotation in radians."
    }
    field "Direction" {
      type="float"
      readonly=false
      doc="Central angle of launch in radians."
    }
    field "Spread" {
      type="float"
      readonly=false
      doc="Full angular width around direction, in radians."
    }
    field "Color" {
      type="Color"
      readonly=false
      doc="Straight linear tint and opacity at birth."
    }
    field "Gravity" {
      type="Vec2"
      readonly=false
      doc="Acceleration in units per second squared."
    }
    field "SizeOverLife" {
      type="Curve"
      readonly=true
      doc="Size multiplier sampled at normalized particle age."
    }
    field "AlphaOverLife" {
      type="Curve"
      readonly=true
      doc="Opacity multiplier sampled at normalized particle age."
    }
    field "RotationSpeed" {
      type="float"
      readonly=false
      doc="Angular speed in radians per second."
    }
    field "Space" {
      type="int"
      readonly=false
      doc="Local particles follow the emitter; world particles keep their birth transform."
    }
    field "Sprite" {
      type="AssetRef<texture>"
      readonly=false
      doc="Texture region to draw. Empty uses the built-in white texture."
    }
    field "Material" {
      type="AssetRef<material>"
      readonly=false
      doc="Optional unlit sprite-domain material. Its shader controls the blend mode."
    }
    field "Layer" {
      type="int"
      readonly=false
      doc="Painter layer shared with SpriteRenderer and Mesh2D."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Painter order within the layer."
    }
  }
}

