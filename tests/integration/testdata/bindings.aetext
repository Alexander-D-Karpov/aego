      readonly=false
      doc="Pushes away from the hitbox centre instead, with the length of Knockback."
    }
    field "Team" {
      type="int"
      readonly=false
      doc="Team of the attack; -1 takes the team of the nearest Health above."
    }
    field "FriendlyFire" {
      type="bool"
      readonly=false
      doc="Also hits targets of the same team."
    }
    field "Policy" {
      type="int"
      readonly=false
