manifest version=4 {
  abi="9a01680400b00c41cb6546a114e4cbeb17fc6b42555a5d24b8749a8f28293666"
  module "aego/debug" {
    func "Arrow" {
      params=["Vec2", "Vec2", "Color"]
      result="void"
      names=["from", "to", "color"]
      doc="Arrow draws an arrow from one point to another."
      example="debug.Arrow(p, p + body.Velocity * 0.2, Color{0, 1, 0, 1})"
    }
    func "Circle" {
      params=["Vec2", "float", "Color"]
      result="void"
      names=["center", "radius", "color"]
      doc="Circle draws a circle outline with radius r in world units."
      example="debug.Circle(node.WorldPosition(), SightRange, Color{0, 0.6, 1, 1})"
    }
    func "Clear" {
      params=["string"]
      result="void"
      names=["channel"]
      doc="Clear removes every primitive whose channel starts with prefix."
      example="debug.Clear(\"ai\")"
    }
    func "Cross" {
      params=["Vec2", "float", "Color"]
      result="void"
      names=["p", "size", "color"]
      doc="Cross draws a cross of the given size in world units."
      example="debug.Cross(goal, 0.5, Color{1, 0, 1, 1})"
    }
    func "Line" {
      params=["Vec2", "Vec2", "Color"]
      result="void"
      names=["a", "b", "color"]
      doc="Line draws a line in world units. It lasts one frame unless Pen sets a lifetime."
      example="debug.Line(node.WorldPosition(), Target.WorldPosition(), Color{1, 0, 0, 1})"
    }
    func "Pen" {
      params=["string", "float"]
      result="void"
      names=["channel", "ttl"]
      doc="Pen sets the channel and the lifetime of the next primitives this script draws: ttl 0 lasts one frame, a positive ttl lasts that many game seconds, a negative ttl lasts until Clear."
      example="debug.Pen(\"ai.path\", 2)"
    }
    func "PenUnscaled" {
      params=["string", "float"]
      result="void"
      names=["channel", "ttl"]
      doc="PenUnscaled is Pen with a lifetime in real seconds; such primitives fade out while the game is paused."
      example="debug.PenUnscaled(\"ui\", 1)"
    }
    func "Point" {
      params=["Vec2", "Color"]
      result="void"
      names=["p", "color"]
      doc="Point marks a point with a small cross of constant screen size."
      example="debug.Point(hit.Point, Color{1, 0, 0, 1})"
    }
    func "Ray" {
      params=["Vec2", "Vec2", "Color"]
      result="void"
      names=["origin", "dir", "color"]
      doc="Ray draws an arrow from origin along dir; the length of dir is the length of the arrow."
      example="debug.Ray(node.WorldPosition(), Vec2{0, 2}, Color{1, 1, 0, 1})"
    }
    func "Rect" {
      params=["Rect", "Color"]
      result="void"
      names=["rect", "color"]
      doc="Rect draws a rectangle outline."
      example="debug.Rect(Rect{0, 0, 4, 2}, Color{1, 1, 1, 1})"
    }
    func "Text" {
      params=["Vec2", "string", "Color"]
      result="void"
      names=["p", "text", "color"]
      doc="Text draws a label at a world position; it keeps its screen size at any zoom."
      example="debug.Text(node.WorldPosition(), string(state), Color{1, 1, 1, 1})"
    }
  }
  module "aego/input" {
    func "Axis" {
      params=["string"]
      result="float"
      names=["name"]
      doc="Axis returns -1, 0 or 1 for a named axis.\nAxes are declared in project.aego → input → axes; horizontal and vertical exist by default."
      example="x := input.Axis(\"horizontal\")"
    }
    func "Down" {
      params=["enum:aego/input.Key"]
      result="bool"
      names=["key"]
      doc="Down reports whether the key is held this frame."
      example="if input.Down(input.KeyShift) {\n\tspeed *= 2\n}"
    }
    func "MouseDown" {
      params=["enum:aego/input.Button"]
      result="bool"
      names=["button"]
      doc="MouseDown reports whether the mouse button is held."
      example="if input.MouseDown(input.MouseLeft) {\n\tfire()\n}"
    }
    func "MousePos" {
      params=[]
      result="Vec2"
      doc="MousePos returns the cursor position in logical pixels of the game area, (0, 0) at its top-left corner. Use MouseWorld for world coordinates."
      example="p := input.MousePos()"
    }
    func "MousePressed" {
      params=["enum:aego/input.Button"]
      result="bool"
      names=["button"]
      doc="MousePressed reports whether the mouse button went down this frame."
      example="if input.MousePressed(input.MouseRight) {\n\taim()\n}"
    }
    func "MouseWorld" {
      params=[]
      result="Vec2"
      doc="MouseWorld returns the cursor position in world units, seen through the camera under the cursor. Letterboxing and window or panel resizes are accounted for."
      example="target := input.MouseWorld()"
    }
    func "Pressed" {
      params=["enum:aego/input.Key"]
      result="bool"
      names=["key"]
      doc="Pressed reports whether the key went down this frame. It is true for exactly one frame per press."
      example="if input.Pressed(input.KeySpace) {\n\tjump()\n}"
    }
    func "Released" {
      params=["enum:aego/input.Key"]
      result="bool"
      names=["key"]
      doc="Released reports whether the key went up this frame."
      example="if input.Released(input.KeySpace) {\n\tcutJump()\n}"
    }
