    }
    field "Period" {
      type="float"
      readonly=false
      doc="Seconds between hits for the periodic policy."
    }
    field "Active" {
      type="bool"
      readonly=false
      doc="Off deals no damage."
    }
  }
  component "gameplay.Lifetime" {
    short="Lifetime"
    category="gameplay"
    doc="Removes the node after some seconds: back to its pool or destroyed."
