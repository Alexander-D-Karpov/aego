  }
  cmethod "SetInt" comp="render2d.PostProcess" {
    params=["string", "int"]
    result="void"
    doc="Sets a signed int32 parameter by instanceID:Field."
  }
  cmethod "SetVec2" comp="render2d.PostProcess" {
    params=["string", "Vec2"]
    result="void"
    doc="Sets a vec2 parameter using instanceID:Field."
  }
  cmethod "SetVec3" comp="render2d.PostProcess" {
    params=["string", "Vec3"]
    result="void"
    doc="Sets a vec3 parameter by instanceID:Field."
  }
  cmethod "SetVec4" comp="render2d.PostProcess" {
    params=["string", "struct:aego/material.Vec4"]
    result="void"
    doc="Sets a vec4 parameter by instanceID:Field."
  }
  hmethod "Done" handle="aego/action.Action" {
    params=[]
    result="bool"
    doc="Done reports whether the action ended, was stopped or is nil."
  }
  hmethod "Running" handle="aego/action.Action" {
    params=[]
    result="bool"
    doc="Running is the opposite of Done."
  }
  hmethod "Stop" handle="aego/action.Action" {
    params=[]
    result="void"
    doc="Stop stops every unfinished step; the properties keep their current values."
  }
  hmethod "Then" handle="aego/action.Action" {
    params=["Handle<aego/tween.Tween>"]
    result="Handle<aego/action.Action>"
    names=["tween"]
    doc="Then adds a tween created in this frame; it waits for its turn."
  }
  hmethod "ThenAction" handle="aego/action.Action" {
    params=["Handle<aego/action.Action>"]
    result="Handle<aego/action.Action>"
    names=["action"]
    doc="ThenAction adds another action that has not started."
  }
  hmethod "ThenTimer" handle="aego/action.Action" {
    params=["Handle<aego/timer.Timer>"]
    result="Handle<aego/action.Action>"
    names=["timer"]
    doc="ThenTimer adds a timer created in this frame; the step ends when the timer ends."
  }
  hmethod "Wait" handle="aego/action.Action" {
    params=["float"]
    result="Handle<aego/action.Action>"
    names=["seconds"]
    doc="Wait adds a pause in game seconds."
  }
  hmethod "Done" handle="aego/audio.Sound" {
    params=[]
    result="bool"
    doc="Done reports whether the sound ended, was stopped or is nil."
  }
  hmethod "Pause" handle="aego/audio.Sound" {
    params=[]
    result="void"
    doc="Pause holds the sound where it is."
  }
  hmethod "Playing" handle="aego/audio.Sound" {
    params=[]
    result="bool"
    doc="Playing reports whether the sound is audible now: not done, not stopping and not paused."
  }
  hmethod "Position" handle="aego/audio.Sound" {
    params=[]
    result="float"
    doc="Position returns the seconds played, within the loop for a looping sound."
  }
  hmethod "Resume" handle="aego/audio.Sound" {
    params=[]
    result="void"
    doc="Resume continues a paused sound."
  }
  hmethod "SetPan" handle="aego/audio.Sound" {
    params=["float"]
    result="void"
    names=["pan"]
    doc="SetPan pans a sound that is not spatial, -1 to 1."
  }
  hmethod "SetPitch" handle="aego/audio.Sound" {
    params=["float"]
    result="void"
    names=["pitch"]
    doc="SetPitch changes speed and pitch, 0.25 to 4."
  }
  hmethod "SetVolume" handle="aego/audio.Sound" {
    params=["float"]
    result="void"
    names=["volume"]
    doc="SetVolume changes the volume with a short ramp."
  }
  hmethod "Stop" handle="aego/audio.Sound" {
    params=[]
    result="void"
    doc="Stop ends the sound with a short fade."
  }
  hmethod "StopFade" handle="aego/audio.Sound" {
    params=["float"]
    result="void"
    names=["seconds"]
    doc="StopFade fades the sound out over seconds."
  }
  hmethod "Done" handle="aego/camera.Blend" {
    params=[]
    result="bool"
    doc="Done reports whether the blend ended, was replaced or is nil."
  }
  hmethod "Running" handle="aego/camera.Blend" {
    params=[]
    result="bool"
    doc="Running is the opposite of Done."
  }
  hmethod "Stop" handle="aego/camera.Blend" {
    params=[]
    result="void"
    doc="Stop ends the blend at the target camera."
  }
  hmethod "Cancel" handle="aego/timer.Timer" {
    params=[]
    result="void"
    doc="Cancel ends the timer without firing."
  }
  hmethod "Count" handle="aego/timer.Timer" {
    params=[]
    result="int"
    doc="Count returns how many times the timer has fired."
  }
  hmethod "Done" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Done reports whether the timer ended, was cancelled or is nil."
  }
  hmethod "Pause" handle="aego/timer.Timer" {
    params=[]
    result="void"
    doc="Pause stops the countdown."
  }
  hmethod "Ready" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Ready reports whether a cooldown can be used."
  }
  hmethod "Remaining" handle="aego/timer.Timer" {
    params=[]
    result="float"
    doc="Remaining returns the seconds left until the next fire."
  }
  hmethod "Repeat" handle="aego/timer.Timer" {
    params=["int"]
    result="Handle<aego/timer.Timer>"
    names=["count"]
    doc="Repeat makes the timer fire n times; -1 repeats until Cancel."
  }
  hmethod "Restart" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Restart starts the countdown again; it does nothing on a one-shot timer that already fired."
  }
  hmethod "Resume" handle="aego/timer.Timer" {
    params=[]
    result="void"
    doc="Resume continues a paused countdown."
  }
  hmethod "Unscaled" handle="aego/timer.Timer" {
    params=[]
    result="Handle<aego/timer.Timer>"
    doc="Unscaled counts real time, also while the game is paused."
  }
  hmethod "Use" handle="aego/timer.Timer" {
    params=[]
    result="bool"
    doc="Use takes a ready cooldown and starts its wait; it returns false while the cooldown runs."
  }
  hmethod "Curve" handle="aego/tween.Tween" {
    params=["Curve"]
    result="Handle<aego/tween.Tween>"
    names=["curve"]
    doc="Curve replaces the easing with a curve field; its time range is stretched over the duration."
  }
  hmethod "Delay" handle="aego/tween.Tween" {
    params=["float"]
    result="Handle<aego/tween.Tween>"
    names=["seconds"]
    doc="Delay waits before the tween starts; the start value is read when the delay ends. Call it right after creating the tween."
    example="tween.ToFloat(node, \"Light.Range\", 4, 1, curve.Linear).Delay(0.5)"
  }
  hmethod "Done" handle="aego/tween.Tween" {
    params=[]
    result="bool"
    doc="Done reports whether the tween finished, was stopped or is nil."
  }
  hmethod "Loop" handle="aego/tween.Tween" {
    params=["int"]
    result="Handle<aego/tween.Tween>"
    names=["count"]
    doc="Loop plays the tween n times from the start; -1 repeats until Stop."
  }
  hmethod "PingPong" handle="aego/tween.Tween" {
    params=["int"]
    result="Handle<aego/tween.Tween>"
    names=["legs"]
    doc="PingPong plays n legs, every second one backwards; 2 goes there and back, -1 repeats until Stop."
  }
  hmethod "Running" handle="aego/tween.Tween" {
    params=[]
    result="bool"
    doc="Running is the opposite of Done."
  }
  hmethod "Stop" handle="aego/tween.Tween" {
    params=[]
    result="void"
    doc="Stop ends the tween where it is; the property keeps its current value."
  }
  hmethod "Unscaled" handle="aego/tween.Tween" {
    params=[]
    result="Handle<aego/tween.Tween>"
    doc="Unscaled runs the tween in real time, also while the game is paused."
  }
  csignal "Started" comp="audio.AudioSource2D" {
    params=[]
    doc="Started runs when the source starts a sound."
  }
  csignal "Finished" comp="audio.AudioSource2D" {
    params=["bool"]
    names=["finished"]
    doc="Finished runs when the sound of the source ends; finished is false after Stop or when it was cut off."
  }
  csignal "Finished" comp="animation.AnimationPlayer" {
    params=["int"]
    names=["cycle"]
    doc="Finished runs when a clip that does not loop ends, with cycle 0, or after Stop, with cycle -1."
  }
  csignal "Event" comp="animation.AnimationPlayer" {
    params=["int", "float"]
    names=["id", "payload"]
    doc="Event runs when the clip reaches an event; anim.EventName(id) gives its name."
  }
  csignal "StateEntered" comp="animation.Animator" {
    params=["int"]
    names=["state"]
    doc="StateEntered runs when the animator enters a state, at the start of the transition."
  }
  csignal "StateExited" comp="animation.Animator" {
    params=["int"]
    names=["state"]
    doc="StateExited runs when a state stops playing, at the end of the transition."
  }
  csignal "Event" comp="animation.Animator" {
    params=["int", "float"]
    names=["id", "payload"]
    doc="Event runs when a state reaches an event of its clip; during a blend the state's event policy decides which side reports."
  }
  csignal "Landed" comp="gameplay.Motion2D" {
    params=["float"]
    names=["speed"]
    doc="Landed fires when the character touches a floor, with the falling speed."
  }
  csignal "LeftGround" comp="gameplay.Motion2D" {
    params=[]
    doc="LeftGround fires when the character walks off a floor without jumping."
  }
  csignal "Jumped" comp="gameplay.Motion2D" {
    params=[]
    doc="Jumped fires when a jump starts."
  }
  csignal "HitWall" comp="gameplay.Motion2D" {
    params=["Vec2"]
    names=["normal"]
    doc="HitWall fires when the character starts touching a wall."
  }
  csignal "HitCeiling" comp="gameplay.Motion2D" {
    params=[]
    doc="HitCeiling fires when the character bumps into a ceiling."
  }
  csignal "Climbed" comp="gameplay.Motion2D" {
    params=[]
    doc="Climbed fires when the character starts climbing onto a ledge."
  }
  csignal "Damaged" comp="gameplay.Health" {
    params=["int", "NodeRef"]
    names=["amount", "source"]
    doc="Damaged fires once per step with the damage taken in it."
  }
  csignal "Healed" comp="gameplay.Health" {
    params=["int"]
    names=["amount"]
    doc="Healed fires with the hit points restored."
  }
  csignal "Died" comp="gameplay.Health" {
    params=["NodeRef"]
    names=["source"]
    doc="Died fires once when the hit points reach zero."
  }
  csignal "Revived" comp="gameplay.Health" {
    params=[]
    doc="Revived fires after Revive."
  }
  csignal "Hit" comp="gameplay.Hitbox2D" {
    params=["NodeRef", "int"]
    names=["target", "damage"]
    doc="Hit fires for each target damaged."
  }
  csignal "Reached" comp="gameplay.Checkpoint2D" {
    params=["NodeRef"]
    names=["by"]
    doc="Reached fires when a node takes this checkpoint."
  }
  csignal "Respawned" comp="gameplay.Respawn" {
    params=[]
    doc="Respawned fires when the node is back at its point."
  }
  csignal "Collected" comp="gameplay.Pickup2D" {
    params=["NodeRef"]
    names=["by"]
    doc="Collected fires with the node that took the pickup."
  }
  csignal "Changed" comp="gameplay.StateMachine" {
    params=["int", "int"]
    names=["from", "to"]
    doc="Changed fires after a state change with the indices of the old and the new state."
  }
  csignal "Completed" comp="particles.ParticleSystem2D" {
    params=[]
    doc="A finite emission schedule has ended and its last particle expired. A presentation signal, not a gameplay timer."
  }
  hsignal "Completed" handle="aego/action.Action" {
    params=["bool"]
    names=["finished"]
    doc="Completed runs once when the action ends; finished is false after Stop or when the node of its script died."
  }
  hsignal "Completed" handle="aego/audio.Sound" {
    params=["bool"]
    names=["finished"]
    doc="Completed runs once when the sound ends: finished is false after Stop, when it was cut off, or when its node died."
  }
  hsignal "Completed" handle="aego/camera.Blend" {
    params=["bool"]
    names=["finished"]
    doc="Completed runs once when the blend ends: finished is false after Stop or when another camera became active first."
  }
  hsignal "Fired" handle="aego/timer.Timer" {
    params=["int"]
    names=["count"]
    doc="Fired runs on every fire of the timer; count is the number of fires so far."
  }
  hsignal "Completed" handle="aego/tween.Tween" {
    params=["bool"]
    names=["finished"]
    doc="Completed runs once when the tween ends. Its finished parameter is true at the natural end, false after Stop, when a new tween on the same property replaced it, or when its node or target is gone."
  }
  component "engine.PrefabInstance" {
    short="PrefabInstance"
    category="engine"
    doc="Links a node to the prefab it was created from."
  }
  component "engine.Tags" {
    short="Tags"
    category="engine"
    doc="Tags names groups this node belongs to; scripts find them with scene.WithTag."
    builtin=true
  }
  component "engine.SpriteRenderer" {
    short="SpriteRenderer"
    category="engine"
    doc="Draws a texture region at the node transform."
    builtin=true
    field "Sprite" {
      type="AssetRef<texture>"
      readonly=false
      doc="Texture or atlas region to draw. Empty draws a solid rectangle in the tint color."
    }
    field "Material" {
      type="AssetRef<material>"
      readonly=false
      doc="Shared sprite-domain material. Per-node changes belong to MaterialOverride."
    }
    field "Layer" {
      type="int"
      readonly=false
      doc="Sorting layer. Higher layers are drawn on top of lower ones."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Order inside the layer. Higher values are drawn later, on top."
    }
    field "Tint" {
      type="Color"
      readonly=false
      doc="Color multiplied with the texture. Alpha controls transparency."
    }
    field "Origin" {
      type="Vec2"
      readonly=false
      doc="Pivot in normalized sprite space. (0.5, 0.5) is the center, (0, 0) the top-left corner."
    }
    field "Size" {
      type="Vec2"
      readonly=false
      doc="Size in world units. Zero uses the texture size divided by the camera zoom."
    }
    field "FlipX" {
      type="bool"
      readonly=false
      doc="Mirrors the sprite horizontally."
    }
    field "FlipY" {
      type="bool"
      readonly=false
      doc="Mirrors the sprite vertically."
    }
    field "Blend" {
      type="int"
      readonly=false
      doc="How the sprite blends with what is behind it: premultiplied alpha, opaque or additive."
    }
    field "Filter" {
      type="int"
      readonly=false
      doc="Texture sampling: nearest keeps pixel art sharp, linear smooths it."
    }
  }
  component "engine.Camera2D" {
    short="Camera2D"
    category="engine"
    doc="Renders an orthographic view from the node transform."
    builtin=true
    field "Zoom" {
      type="float"
      readonly=false
      doc="Pixels per world unit. Larger values show a smaller part of the world."
    }
    field "Viewport" {
      type="Rect"
      readonly=false
      doc="Part of the screen the camera draws into, in normalized coordinates."
    }
    field "Mask" {
      type="int"
      readonly=false
      doc="Visibility layers this camera renders. -1 renders every layer."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Cameras with a lower order render first."
    }
    field "Clear" {
      type="bool"
      readonly=false
      doc="Clears the viewport before drawing."
    }
    field "ClearColor" {
      type="Color"
      readonly=false
      doc="Background color used when clear is on."
    }
    field "Scale" {
      type="int"
      readonly=false
      doc="How the view adapts to the window: free, pixelPerfect or fitVirtual."
    }
    field "Virtual" {
      type="Vec2"
      readonly=false
      doc="Virtual resolution used by fitVirtual and pixelPerfect."
    }
    field "Active" {
      type="bool"
      readonly=false
      doc="Only active cameras render."
    }
  }
  component "engine.Mesh2D" {
    short="Mesh2D"
    category="engine"
    doc="Draws the standard mesh vertex layout in a 2D camera with a compatible Mesh2D material."
    builtin=true
    field "Mesh" {
      type="AssetRef<mesh>"
      readonly=false
      doc="Mesh asset with the standard position, normal, UV and vertex color layout."
    }
    field "Texture" {
      type="AssetRef<texture>"
      readonly=false
      doc="Main texture sampled in mesh UV coordinates. Empty uses white."
    }
    field "Material" {
      type="AssetRef<material>"
      readonly=false
      doc="Shared material asset. The shader domain must be mesh2d."
    }
    field "Tint" {
      type="Color"
      readonly=false
      doc="Linear color multiplied with the texture; alpha controls transparency."
    }
    field "Layer" {
      type="int"
      readonly=false
      doc="Visual layer for this 2D mesh."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Painter order among sprites and meshes in the same layer; higher values draw later."
    }
  }
  component "engine.MaterialOverride" {
    short="MaterialOverride"
    category="engine"
    doc="Overrides up to eight numeric shader parameters on this node. Removed parameters remain in the values list."
    builtin=true
  }
  component "render2d.PostProcess" {
    short="PostProcess"
    category="render2d"
    doc="Applies an ordered effect stack after all cameras sharing this camera's logical output, before UI."
    builtin=true
    field "Enabled" {
      type="bool"
      readonly=false
      doc="Enable this camera's output stack. Disabled stacks do not claim the output."
    }
  }
  component "engine.Light2D" {
    short="Light2D"
    category="engine"
    doc="Forward 2D diffuse light. Local +X defines Spot and Directional azimuth; presentation transforms also drive shadows."
    builtin=true
    field "Type" {
      type="int"
      readonly=false
      doc="Point, Spot, Directional or Sprite/cookie. Directional shadows are not supported."
    }
    field "Color" {
      type="Color"
      readonly=false
      doc="Linear light color; the color picker handles display conversion."
    }
    field "Intensity" {
      type="float"
      readonly=false
      doc="Nonnegative energy multiplier; zero disables this light's contribution."
    }
    field "Range" {
      type="float"
      readonly=false
      doc="Local light radius in world units, independent of node scale."
    }
    field "Height" {
      type="float"
      readonly=false
      doc="Virtual distance above the sprite surface for diffuse normal mapping; shadows remain planar."
    }
    field "InnerAngle" {
      type="float"
      readonly=false
      doc="Full Spot inner cone angle in radians, centered on local +X."
    }
    field "OuterAngle" {
      type="float"
      readonly=false
      doc="Full Spot outer cone angle in radians, no smaller than innerAngle."
    }
    field "Elevation" {
      type="float"
      readonly=false
      doc="Directional elevation above the surface in radians, greater than zero."
    }
    field "Falloff" {
      type="float"
      readonly=false
      doc="Nonnegative falloff exponent over normalized local-light distance."
    }
    field "Cookie" {
      type="AssetRef<texture>"
      readonly=false
      doc="Sprite light mask texture. Its own region and trim map to the light square."
    }
    field "Layers" {
      type="int"
      readonly=false
      doc="64-bit receiver visibility mask. -1 means all bits; zero receives no objects."
    }
    field "ShadowCasterMask" {
      type="int"
      readonly=false
      doc="64-bit shadow-occluder mask, independent of visibility and collision masks."
    }
    field "Shadows" {
      type="bool"
      readonly=false
      doc="Enable cached local-light shadow masks for Point, Spot and Sprite lights."
    }
    field "ShadowSoftness" {
      type="float"
      readonly=false
      doc="Bounded mask filtering radius; this is not a physical area-light penumbra."
    }
    field "Priority" {
      type="int"
      readonly=false
      doc="Higher priority is selected first when the per-draw light budget is exceeded."
    }
  }
  component "engine.LightOccluder2D" {
    short="LightOccluder2D"
    category="engine"
    doc="A planar shadow contour. Manual polygons require no Physics module; ShapeProvider reads local geometry through the shapes2d contract."
    builtin=true
    field "Source" {
      type="int"
      readonly=false
      doc="Use a manual polygon/chain or a registered local-shape provider."
    }
    field "Polygon" {
      type="[]Vec2"
      readonly=true
      doc="Simple local-space contour without holes; points follow the owner's presentation transform once."
    }
    field "Closed" {
      type="bool"
      readonly=false
      doc="Close the manual polygon. A ShapeProvider supplies each contour's closed state."
    }
    field "CullMode" {
      type="int"
      readonly=false
      doc="Shadow edge winding policy; independent of any physics one-sided setting."
    }
    field "Layers" {
      type="int"
      readonly=false
      doc="64-bit shadow participation mask. -1 is all bits; zero casts no shadows."
    }
    field "ShapeNode" {
      type="NodeRef"
      readonly=false
      doc="Source node for ShapeProvider. Empty uses this node; unresolved IDs are preserved."
    }
    field "Shape" {
      type="string"
      readonly=false
      doc="Stable provider shape key, such as physics.BoxCollider2D. Empty selects all of the source node's shapes."
    }
  }
  component "engine.LightingEnvironment2D" {
    short="LightingEnvironment2D"
    category="engine"
    doc="Lighting and output policy for a camera. An empty camera applies to the current output; overlapping environments are an error."
    builtin=true
    field "Camera" {
      type="NodeRef"
      readonly=false
      doc="Optional Camera2D node. Empty applies to all 2D views of this world."
    }
    field "AmbientColor" {
      type="Color"
      readonly=false
      doc="Linear ambient surface illumination. Default white preserves unlit-looking Lit scenes with no lights."
    }
    field "AmbientIntensity" {
      type="float"
      readonly=false
      doc="Nonnegative ambient energy multiplier."
    }
    field "ColorMode" {
      type="int"
      readonly=false
      doc="Auto chooses supported HDR for Lit output; LDR uses RGBA8 and HDR requests RGBA16F."
    }
    field "Exposure" {
      type="float"
      readonly=false
      doc="Positive display-resolve exposure, without changing UI or simulation."
    }
    field "ShadowResolution" {
      type="int"
      readonly=false
      doc="Power-of-two mask dimension between 64 and 2048. Initial profile uses 256."
    }
    field "MaxShadowedLights" {
      type="int"
      readonly=false
      doc="Per-camera local-shadow budget from 0 through 16; actual performance depends on the GPU."
    }
  }
  component "engine.Camera3D" {
    short="Camera3D"
    category="engine"
    doc="Renders a perspective view looking down the node -Z axis."
    builtin=true
    field "Fov" {
      type="float"
      readonly=false
      doc="Vertical field of view in degrees."
    }
    field "Near" {
      type="float"
      readonly=false
      doc="Distance to the near clipping plane."
    }
    field "Far" {
      type="float"
      readonly=false
      doc="Distance to the far clipping plane."
    }
    field "Viewport" {
      type="Rect"
      readonly=false
      doc="Part of the screen the camera draws into, in normalized coordinates."
    }
    field "Mask" {
      type="int"
      readonly=false
      doc="Visibility layers this camera renders. -1 renders every layer."
    }
    field "Order" {
      type="int"
      readonly=false
      doc="Cameras with a lower order render first."
    }
    field "Clear" {
      type="bool"
      readonly=false
      doc="Clears the viewport before drawing."
    }
    field "ClearColor" {
      type="Color"
      readonly=false
      doc="Background color used when clear is on."
    }
    field "Active" {
      type="bool"
      readonly=false
      doc="Only active cameras render."
    }
    field "Orthographic" {
      type="bool"
      readonly=false
      doc="Projects without perspective; sprites and meshes keep their size at any depth."
    }
    field "OrthoSize" {
      type="float"
      readonly=false
      doc="Half of the vertical extent in world units when orthographic is on."
    }
  }
  component "engine.MeshRenderer" {
    short="MeshRenderer"
    category="engine"
    doc="Draws an unlit mesh at the node transform."
    builtin=true
    field "Mesh" {
      type="AssetRef<mesh>"
      readonly=false
      doc="Mesh to draw: an imported .obj or a builtin Cube, Plane, Sphere or Cylinder."
    }
    field "Texture" {
      type="AssetRef<texture>"
      readonly=false
      doc="Texture mapped onto the mesh. Empty uses white."
    }
    field "Color" {
      type="Color"
      readonly=false
      doc="Color multiplied with the texture."
    }
    field "Blend" {
      type="int"
      readonly=false
      doc="Opaque writes depth. Premultiplied and additive are drawn after opaque meshes."
    }
    field "DoubleSided" {
      type="bool"
      readonly=false
      doc="Draws the back faces too."
    }
    field "Layer" {
      type="int"
      readonly=false
      doc="Sorting layer for transparent meshes."
    }
    field "Filter" {
      type="int"
      readonly=false
      doc="Texture sampling: nearest or linear."
    }
  }
  component "physics.Body2D" {
    short="Body2D"
    category="physics"
    doc="Simulates the node as a rigid body. Colliders on the node and its children form its shape."
    builtin=true
    field "Type" {
      type="int"
      readonly=false
      doc="static never moves, kinematic moves by velocity, dynamic reacts to forces and contacts."
    }
    field "MassMode" {
      type="int"
      readonly=false
      doc="auto takes the mass from collider density, override uses Mass."
    }
    field "Mass" {
      type="float"
      readonly=false
      doc="Mass in kilograms when Mass Mode is override."
    }
    field "GravityScale" {
      type="float"
      readonly=false
      doc="Multiplier of the project gravity for this body; 0 makes it float."
    }
    field "LinearDamping" {
      type="float"
      readonly=false
      doc="Slows the movement every step, like air resistance; 0 keeps the speed."
    }
    field "AngularDamping" {
      type="float"
      readonly=false
      doc="Slows the rotation every step; 0 keeps spinning."
    }
    field "FixedRotation" {
      type="bool"
      readonly=false
      doc="Keeps the body upright: contacts and torque never rotate it."
    }
    field "Bullet" {
      type="bool"
      readonly=false
      doc="Continuous collision against other dynamic bodies, so a fast body cannot pass through them. Costs more."
    }
    field "AllowSleep" {
      type="bool"
      readonly=false
      doc="Lets the body sleep after it comes to rest, which saves time; contacts and scripts wake it."
    }
    field "Interpolate" {
      type="bool"
      readonly=false
      doc="Draws the body between physics steps for smooth motion; scripts still see the exact pose."
    }
    field "Layer" {
      type="int"
      readonly=false
      doc="Collision layer, see Project Settings → Physics."
    }
    field "Mask" {
      type="int"
      readonly=false
      doc="Layers this body collides with."
    }
    field "Velocity" {
      type="Vec2"
      readonly=true
      doc="Velocity in units per second."
    }
    field "AngularVelocity" {
      type="float"
      readonly=true
      doc="Rotation speed in radians per second."
    }
    field "Awake" {
      type="bool"
      readonly=true
      doc="Whether the body is simulated this step or sleeping."
    }
  }
  component "physics.BoxCollider2D" {
    short="BoxCollider2D"
    category="physics"
    doc="Box shape in node space."
    builtin=true
    field "Offset" {
      type="Vec2"
      readonly=false
      doc="Position of the shape in node space."
    }
    field "IsTrigger" {
      type="bool"
      readonly=false
      doc="Detects overlaps and sends trigger events without pushing bodies apart."
    }
    field "Friction" {
      type="float"
      readonly=false
      doc="Resistance to sliding along other shapes; 0 is ice. Two shapes use the square root of the product."
    }
    field "Restitution" {
      type="float"
      readonly=false
      doc="Bounciness: 0 stops on impact, 1 bounces back at the same speed. Two shapes use the larger value."
    }
    field "Density" {
      type="float"
      readonly=false
      doc="Mass per square unit; gives the body its mass when Mass Mode is auto."
    }
    field "Size" {
      type="Vec2"
      readonly=false
      doc="Width and height in units, before the node scale."
    }
  }
  component "physics.CircleCollider2D" {
    short="CircleCollider2D"
    category="physics"
    doc="Circle shape. Needs a uniform node scale."
    builtin=true
    field "Offset" {
      type="Vec2"
      readonly=false
      doc="Position of the shape in node space."
    }
    field "IsTrigger" {
      type="bool"
      readonly=false
      doc="Detects overlaps and sends trigger events without pushing bodies apart."
    }
    field "Friction" {
      type="float"
      readonly=false
      doc="Resistance to sliding along other shapes; 0 is ice. Two shapes use the square root of the product."
    }
    field "Restitution" {
      type="float"
      readonly=false
      doc="Bounciness: 0 stops on impact, 1 bounces back at the same speed. Two shapes use the larger value."
    }
    field "Density" {
      type="float"
      readonly=false
      doc="Mass per square unit; gives the body its mass when Mass Mode is auto."
    }
    field "Radius" {
      type="float"
      readonly=false
      doc="Radius in units, before the node scale."
    }
  }
  component "physics.CapsuleCollider2D" {
    short="CapsuleCollider2D"
    category="physics"
    doc="Capsule along the local X axis; Length is the full extent including the caps."
    builtin=true
    field "Offset" {
      type="Vec2"
      readonly=false
      doc="Position of the shape in node space."
    }
    field "IsTrigger" {
      type="bool"
      readonly=false
      doc="Detects overlaps and sends trigger events without pushing bodies apart."
    }
    field "Friction" {
      type="float"
      readonly=false
      doc="Resistance to sliding along other shapes; 0 is ice. Two shapes use the square root of the product."
    }
    field "Restitution" {
      type="float"
      readonly=false
      doc="Bounciness: 0 stops on impact, 1 bounces back at the same speed. Two shapes use the larger value."
    }
    field "Density" {
      type="float"
      readonly=false
      doc="Mass per square unit; gives the body its mass when Mass Mode is auto."
    }
    field "Length" {
      type="float"
      readonly=false
      doc="Full length along the local X axis, caps included."
    }
    field "Radius" {
      type="float"
      readonly=false
      doc="Radius of the caps and half the thickness."
    }
  }
  component "physics.PolygonCollider2D" {
    short="PolygonCollider2D"
    category="physics"
    doc="Convex polygon of 3 to 8 points."
    builtin=true
    field "Offset" {
      type="Vec2"
      readonly=false
      doc="Position of the shape in node space."
    }
    field "IsTrigger" {
      type="bool"
      readonly=false
      doc="Detects overlaps and sends trigger events without pushing bodies apart."
    }
    field "Friction" {
      type="float"
      readonly=false
      doc="Resistance to sliding along other shapes; 0 is ice. Two shapes use the square root of the product."
    }
    field "Restitution" {
      type="float"
      readonly=false
      doc="Bounciness: 0 stops on impact, 1 bounces back at the same speed. Two shapes use the larger value."
    }
    field "Density" {
      type="float"
      readonly=false
      doc="Mass per square unit; gives the body its mass when Mass Mode is auto."
    }
    field "Points" {
      type="[]Vec2"
      readonly=true
      doc="Corners in node space, 3 to 8, forming a convex shape; edit them in the Scene View."
    }
  }
  component "physics.EdgeCollider2D" {
    short="EdgeCollider2D"
    category="physics"
    doc="Polyline for level geometry. OneSided lets bodies pass from below."
    builtin=true
    field "Offset" {
      type="Vec2"
      readonly=false
      doc="Position of the shape in node space."
    }
    field "IsTrigger" {
      type="bool"
      readonly=false
      doc="Detects overlaps and sends trigger events without pushing bodies apart."
    }
    field "Friction" {
      type="float"
      readonly=false
      doc="Resistance to sliding along other shapes; 0 is ice. Two shapes use the square root of the product."
    }
    field "Restitution" {
      type="float"
      readonly=false
      doc="Bounciness: 0 stops on impact, 1 bounces back at the same speed. Two shapes use the larger value."
    }
    field "Density" {
      type="float"
      readonly=false
      doc="Mass per square unit; gives the body its mass when Mass Mode is auto."
    }
    field "Points" {
      type="[]Vec2"
      readonly=true
      doc="Points of the line in node space, at least 2; edit them in the Scene View."
    }
    field "Loop" {
      type="bool"
      readonly=false
      doc="Joins the last point to the first, for closed outlines; needs at least 3 points."
    }
    field "OneSided" {
      type="bool"
      readonly=false
      doc="Collides only from above, so bodies can jump through from below, as on a platform."
    }
  }
  component "physics.DistanceJoint2D" {
    short="DistanceJoint2D"
    category="physics"
    doc="Keeps a distance between this body and the Target body. Length 0 uses the distance at start."
    builtin=true
    field "Target" {
      type="NodeRef"
      readonly=false
      doc="The other body; both nodes need a Rigid Body 2D."
    }
    field "AnchorA" {
      type="Vec2"
      readonly=false
      doc="Attachment point on this node, in node space."
    }
    field "AnchorB" {
      type="Vec2"
      readonly=false
      doc="Attachment point on the Target node, in its node space."
    }
    field "Length" {
      type="float"
      readonly=false
      doc="Rest length in units; 0 takes the distance between the anchors at start."
    }
    field "MinLength" {
      type="float"
      readonly=false
      doc="Shortest allowed length. With Min and Max both 0 the joint is a rigid rod, or a spring without a lower limit when Stiffness is set."
    }
    field "MaxLength" {
      type="float"
      readonly=false
      doc="Longest allowed length; a rope has Min 0 and Max at the rope length."
    }
    field "Stiffness" {
      type="float"
      readonly=false
      doc="Spring stiffness in newtons per unit; 0 makes the length rigid within Min and Max."
    }
    field "Damping" {
      type="float"
      readonly=false
      doc="Spring damping; 0 never damps, higher values stop the oscillation sooner."
    }
    field "CollideConnected" {
      type="bool"
      readonly=false
      doc="Lets the two connected bodies collide with each other."
    }
  }
  component "physics.RevoluteJoint2D" {
    short="RevoluteJoint2D"
    category="physics"
    doc="Pins this body to the Target body at Anchor, with an optional limit and motor."
    builtin=true
    field "Target" {
      type="NodeRef"
      readonly=false
      doc="The body this one turns around; both nodes need a Rigid Body 2D."
    }
    field "Anchor" {
      type="Vec2"
      readonly=false
      doc="Pivot point in this node's space; both bodies turn around it."
    }
    field "EnableLimit" {
      type="bool"
      readonly=false
      doc="Keeps the angle between Lower and Upper."
    }
    field "Lower" {
      type="float"
      readonly=false
      doc="Smallest angle in radians, relative to the angle at start."
    }
    field "Upper" {
      type="float"
      readonly=false
      doc="Largest angle in radians, relative to the angle at start."
    }
    field "EnableMotor" {
      type="bool"
      readonly=false
      doc="Drives the joint at Speed, up to Max Torque."
    }
    field "Speed" {
      type="float"
      readonly=false
      doc="Motor speed in radians per second; negative turns the other way."
    }
    field "MaxTorque" {
      type="float"
      readonly=false
      doc="Strongest torque the motor may apply; with 0 the motor does nothing."
    }
    field "CollideConnected" {
      type="bool"
      readonly=false
      doc="Lets the two connected bodies collide with each other."
    }
  }
  component "audio.AudioListener2D" {
    short="AudioListener2D"
    category="audio"
    doc="Hears spatial sound from its node. Without one the camera of the main output listens."
    builtin=true
    field "Active" {
      type="bool"
      readonly=false
      doc="The first active listener in the hierarchy is used."
    }
  }
  component "audio.AudioSource2D" {
    short="AudioSource2D"
    category="audio"
    doc="Plays a clip or an audio event from its node."
    builtin=true
    field "Clip" {
      type="AssetRef<audio>"
      readonly=false
      doc="Sound to play; ignored when Event is set."
    }
    field "Event" {
      type="AssetRef<data>"
      readonly=false
      doc="Audio event to play instead of Clip; its settings replace the fields below."
    }
    field "Volume" {
      type="float"
      readonly=false
      doc="Volume before the bus: 0 is silent, 1 is the clip as recorded."
    }
    field "Pitch" {
      type="float"
      readonly=false
      doc="Playback speed and pitch together: 1 is normal, 2 an octave higher and twice as fast."
    }
    field "Pan" {
      type="float"
      readonly=false
      doc="Left -1 to right 1, for a sound that is not spatial."
    }
    field "Bus" {
      type="int"
      readonly=false
      doc="Mixer bus."
    }
    field "Loop" {
      type="bool"
      readonly=false
      doc="Loops until stopped."
    }
    field "PlayOnStart" {
      type="bool"
      readonly=false
      doc="Plays when Play starts."
    }
    field "Spatial" {
      type="bool"
      readonly=false
      doc="Fades and pans with the distance to the listener."
    }
    field "MinDistance" {
      type="float"
      readonly=false
      doc="Full volume up to this distance, in world units."
    }
    field "MaxDistance" {
      type="float"
      readonly=false
      doc="Silent from this distance, in world units."
    }
    field "Rolloff" {
      type="Curve"
      readonly=true
      doc="Volume from Min Distance (time 0) to Max Distance (time 1)."
    }
    field "PanWidth" {
      type="float"
      readonly=false
      doc="How far a spatial sound pans when it is at Max Distance to the side: 0 stays centred, 1 is fully left or right."
    }
    field "PauseWith" {
      type="int"
      readonly=false
      doc="game pauses with the world, never keeps playing."
    }
    field "Playing" {
      type="bool"
      readonly=true
      doc="True while a sound of this source plays."
    }
    field "Position" {
      type="float"
      readonly=true
      doc="Seconds into the sound."
    }
  }
  component "audio.AudioZone2D" {
    short="AudioZone2D"
    category="audio"
    doc="While the listener is inside Area, Bus is turned to Gain."
    builtin=true
    field "Area" {
      type="Rect"
      readonly=false
      doc="Rectangle in this node's space."
    }
    field "Bus" {
      type="int"
      readonly=false
      doc="Bus the zone turns down or up."
    }
    field "Gain" {
      type="float"
      readonly=false
      doc="Volume of the bus inside the zone, 0 to 1."
    }
    field "Priority" {
      type="int"
      readonly=false
      doc="Among overlapping zones on one bus the highest priority wins, then the one entered later."
    }
    field "FadeTime" {
      type="float"
      readonly=false
      doc="Seconds to fade in and out of the zone."
    }
  }
  component "animation.AnimationPlayer" {
    short="AnimationPlayer"
    category="animation"
    doc="Plays an animation clip on its node and the nodes below it: property tracks, sprite frames and events. Clip time, gameplay events and tracks other than the transform pose advance on fixed steps, so a replay gives the same result at any frame rate."
    builtin=true
    field "Clip" {
      type="AssetRef<anim>"
      readonly=false
      doc="Clip to play."
    }
    field "PlayOnStart" {
      type="bool"
      readonly=false
      doc="Starts the clip when Play starts."
    }
    field "Speed" {
      type="float"
      readonly=false
      doc="Playback speed: 1 is normal, 2 twice as fast; a negative speed plays backwards."
    }
    field "Loop" {
      type="int"
      readonly=false
      doc="clip keeps the loop mode of the clip; once, loop and pingPong override it."
    }
    field "TimeDomain" {
      type="int"
      readonly=false
      doc="game follows game time and pauses with it; unscaled runs in real time while paused, for menus and other presentation."
    }
    field "Time" {
      type="float"
      readonly=true
      doc="Time inside the clip, in seconds."
    }
    field "Playing" {
      type="bool"
      readonly=true
      doc="Whether the clip plays."
    }
    field "Cycle" {
      type="int"
      readonly=true
      doc="Cycles of a looping clip so far."
    }
  }
  component "animation.Animator" {
    short="Animator"
    category="animation"
    doc="Plays the states of an animation controller and blends between them when its parameters change. The graph, the blends, root motion and gameplay events run on fixed steps, so replays match at any frame rate."
    builtin=true
    field "Controller" {
      type="AssetRef<animctrl>"
      readonly=false
      doc="Controller with the states, parameters and transitions."
    }
    field "PlayOnStart" {
      type="bool"
      readonly=false
      doc="Enters the entry state when Play starts."
    }
    field "Speed" {
      type="float"
      readonly=false
      doc="Multiplies the speed of every state; 1 is normal speed."
    }
    field "TimeDomain" {
      type="int"
      readonly=false
      doc="game follows game time and pauses with it; unscaled runs in real time while paused, for presentation only."
    }
    field "RootMotion" {
      type="int"
      readonly=false
      doc="What the root track moves: none ignores it, toMotion moves the node through Motion 2D so walls stop it, toTransform sets its position."
    }
    field "RootFallback" {
      type="bool"
      readonly=false
      doc="toMotion moves the transform instead when the node has no Motion 2D."
    }
    field "RootScale" {
      type="Vec2"
      readonly=false
      doc="Multiplies root motion in the node's parent space; set X to -1 while the character faces left."
    }
    field "State" {
      type="string"
      readonly=true
      doc="Current state."
    }
    field "Time" {
      type="float"
      readonly=true
      doc="Seconds in the current state."
    }
    field "Progress" {
      type="float"
      readonly=true
      doc="Time in the current state divided by the length of its clip; 1 is one full clip."
    }
    field "Blending" {
      type="bool"
      readonly=true
      doc="Whether a transition is blending."
    }
  }
  component "camera.VirtualCamera2D" {
    short="VirtualCamera2D"
    category="camera"
    doc="A camera pose the brain can pick. The highest priority wins; switching blends from the current view."
    builtin=true
    field "Priority" {
      type="int"
      readonly=false
      doc="The enabled virtual camera with the highest priority drives its output."
    }
    field "Output" {
      type="string"
      readonly=false
      doc="Output this camera drives. Empty is the main output; a Camera 2D picks another one with Camera Output Selector 2D."
    }
    field "Zoom" {
      type="float"
      readonly=false
      doc="Pixels per world unit while this camera is active. 0 keeps the zoom of the Camera 2D."
    }
    field "BlendTime" {
      type="float"
      readonly=false
      doc="Seconds to blend into this camera when it becomes active. 0 cuts."
    }
    field "BlendCurve" {
      type="Curve"
      readonly=true
      doc="Shape of the blend; its time range is stretched over Blend Time."
    }
    field "TimeDomain" {
      type="int"
      readonly=false
      doc="unscaled blends and shakes in real time, also during hit-stop and pause; game follows the time scale."
    }
    field "UseBounds" {
      type="bool"
      readonly=false
      doc="Keeps the visible area inside Bounds."
    }
    field "Bounds" {
      type="Rect"
      readonly=false
      doc="World rectangle the view stays inside. A smaller area centres the view on it."
    }
    field "SnapToPixels" {
      type="bool"
      readonly=false
      doc="Rounds the final position to whole screen pixels. pixelPerfect cameras already do this."
    }
  }
  component "camera.CameraFollow2D" {
    short="CameraFollow2D"
    category="camera"
    doc="Moves its virtual camera after Target, with a deadzone, damping and lookahead."
    builtin=true
    field "Target" {
      type="NodeRef"
      readonly=false
      doc="Node to follow; its interpolated position is used."
    }
    field "Deadzone" {
      type="Rect"
      readonly=false
      doc="Area of the view, in 0..1 of its width and height, where the target moves without moving the camera."
    }
    field "Damping" {
      type="Vec2"
      readonly=false
      doc="How fast the camera catches up, per second on each axis. 0 follows rigidly."
    }
    field "Lookahead" {
      type="Vec2"
      readonly=false
      doc="Seconds of target velocity the camera looks ahead on each axis."
    }
    field "MaxLookahead" {
      type="Vec2"
      readonly=false
      doc="Largest lookahead in world units on each axis. 0 is unlimited."
    }
    field "LookaheadSmoothing" {
      type="float"
      readonly=false
      doc="How fast the lookahead changes, per second. 0 changes at once."
    }
    field "SnapDistance" {
      type="float"
      readonly=false
      doc="A target jump longer than this, in world units, moves the camera at once. 0 never snaps."
    }
  }
  component "camera.CameraShake2D" {
    short="CameraShake2D"
    category="camera"
    doc="Tunes the shake of its virtual camera. Shake grows with trauma and fades over time."
    builtin=true
    field "Decay" {
      type="float"
      readonly=false
      doc="Trauma lost per second."
    }
    field "MaxOffset" {
      type="Vec2"
      readonly=false
      doc="Largest offset in world units at full trauma."
    }
    field "MaxAngle" {
      type="float"
      readonly=false
      doc="Largest rotation in radians at full trauma."
    }
    field "Frequency" {
      type="float"
      readonly=false
      doc="How fast the shake changes, in noise steps per second."
    }
    field "Exponent" {
      type="float"
      readonly=false
      doc="Shake is trauma to this power: 2 keeps small hits subtle."
    }
  }
  component "camera.CameraZone2D" {
    short="CameraZone2D"
    category="camera"
    doc="While Target is inside Area, Camera gets Priority and the zone's zoom and bounds."
    builtin=true
    field "Target" {
      type="NodeRef"
      readonly=false
      doc="Node that triggers the zone. Empty uses the follow target of the zone's camera."
    }
    field "Camera" {
      type="NodeRef"
      readonly=false
      doc="Virtual camera the zone activates. Empty uses the one on this node."
    }
    field "Priority" {
      type="int"
      readonly=false
      doc="Priority of the camera while the target is inside."
    }
    field "Zoom" {
      type="float"
      readonly=false
      doc="Zoom while the zone is in effect. 0 keeps the camera's zoom."
    }
    field "UseBounds" {
      type="bool"
      readonly=false
      doc="Replaces the camera's bounds while the zone is in effect."
    }
    field "Bounds" {
      type="Rect"
      readonly=false
      doc="World rectangle used instead of the camera's bounds."
    }
    field "Area" {
      type="Rect"
      readonly=false
      doc="Trigger rectangle in this node's space."
    }
  }
  component "camera.CameraBrain2D" {
    short="CameraBrain2D"
    category="camera"
    doc="Picks which output of virtual cameras drives this Camera 2D. Without it the camera shows the main output."
    builtin=true
    field "Output" {
      type="string"
      readonly=false
      doc="Output name; virtual cameras with the same Output drive this camera."
    }
  }
  component "gameplay.Motion2D" {
    short="Motion2D"
    category="gameplay"
    doc="Moves a kinematic Body2D by casting its colliders: walking, jumping, slopes, steps and moving platforms, or free top-down movement. Call Move and Jump from a script; the controller acts on the next fixed step."
    builtin=true
    field "Mode" {
      type="int"
      readonly=false
      doc="platformer walks on floors under gravity; topDown moves freely in the plane."
    }
    field "UpDirection" {
      type="Vec2"
      readonly=false
      doc="Up for floors, jumps and gravity. (0, -1) is up on screen."
    }
    field "MaxSpeed" {
      type="float"
      readonly=false
      doc="Top speed in units per second."
    }
    field "Accel" {
      type="float"
      readonly=false
      doc="How fast the speed grows towards the target, units per second squared."
    }
    field "Decel" {
      type="float"
      readonly=false
      doc="How fast the speed falls without input, in units per second squared."
    }
    field "AirControl" {
      type="float"
      readonly=false
      doc="Share of Accel and Decel available in the air: 0 cannot steer, 1 steers as on the ground."
    }
    field "GravityScale" {
      type="float"
      readonly=false
      doc="Multiplies the physics gravity; 0 turns gravity off for the character."
    }
    field "MaxFallSpeed" {
      type="float"
      readonly=false
      doc="Fastest fall in units per second. 0 is unlimited."
    }
    field "JumpHeight" {
      type="float"
      readonly=false
      doc="Height of a full jump in units; sets the jump speed unless Jump Speed is set."
    }
    field "JumpSpeed" {
      type="float"
      readonly=false
      doc="Upward speed of a jump. 0 derives it from Jump Height and gravity."
    }
    field "JumpCutMultiplier" {
      type="float"
      readonly=false
      doc="Upward speed is multiplied by this when the jump button is released early."
    }
    field "CoyoteTime" {
      type="float"
      readonly=false
      doc="Seconds after leaving a ledge during which a jump still works."
    }
    field "JumpBuffer" {
      type="float"
      readonly=false
      doc="Seconds a jump pressed in the air is remembered until landing."
    }
    field "MaxSlope" {
      type="float"
      readonly=false
      doc="Steepest floor in degrees; steeper surfaces are walls."
    }
    field "StepHeight" {
      type="float"
      readonly=false
      doc="Steps up to this height, in units, are climbed without jumping. 0 never steps up."
    }
    field "SnapToGround" {
      type="float"
      readonly=false
      doc="Keeps the character on slopes and steps down by up to this distance, in units. 0 never snaps."
    }
    field "SafeMargin" {
      type="float"
      readonly=false
      doc="Gap in units kept to surfaces so casts never start inside them."
    }
    field "MaxSlides" {
      type="int"
      readonly=false
      doc="How many surfaces one step may slide along."
    }
    field "CollisionMask" {
      type="int"
      readonly=false
      doc="Layers the character collides with."
    }
    field "PushBodies" {
      type="bool"
      readonly=false
      doc="Moves through dynamic bodies and pushes them instead of stopping at them."
    }
    field "MovingPlatforms" {
      type="bool"
      readonly=false
      doc="Carries the character with the body it stands on."
    }
    field "PlatformOnLeave" {
      type="int"
      readonly=false
      doc="keep keeps the platform's velocity after leaving it, drop loses it, add keeps only its horizontal part."
    }
    field "FaceMovement" {
      type="bool"
      readonly=false
      doc="topDown: turns the node towards the movement."
    }
    field "DashGravity" {
      type="bool"
      readonly=false
      doc="Applies gravity during a dash."
    }
    field "LedgeClimb" {
      type="float"
      readonly=false
      doc="platformer: in the air, moving into a wall whose top is at most this far above the feet climbs onto it. 0 never climbs."
    }
    field "ClimbTime" {
      type="float"
      readonly=false
      doc="Seconds a ledge climb takes: rising, then stepping onto the ledge."
    }
    field "Velocity" {
      type="Vec2"
      readonly=true
      doc="Velocity in units per second."
    }
    field "Grounded" {
      type="bool"
      readonly=true
      doc="Whether the character stands on a floor."
    }
    field "OnWall" {
      type="bool"
      readonly=true
      doc="Whether the character touched a wall in the last step."
    }
    field "OnCeiling" {
      type="bool"
      readonly=true
      doc="Whether the character touched a ceiling in the last step."
    }
    field "WallNormal" {
      type="Vec2"
      readonly=true
      doc="Normal of the last wall touched."
    }
    field "FloorNormal" {
      type="Vec2"
      readonly=true
      doc="Normal of the floor under the character."
    }
    field "FloorAngle" {
      type="float"
      readonly=true
      doc="Slope of the floor in degrees."
    }
    field "GroundBody" {
      type="NodeRef"
      readonly=true
      doc="Body the character stands on."
    }
    field "Climbing" {
      type="bool"
      readonly=true
      doc="Whether the character is climbing onto a ledge."
    }
  }
  component "gameplay.Health" {
    short="Health"
    category="gameplay"
    doc="Hit points of a node. Hitboxes, kill zones and scripts damage it; it dies once at zero until revived."
    builtin=true
    field "Max" {
      type="int"
      readonly=false
      doc="Hit points at the start and after a full revive."
    }
    field "Current" {
      type="int"
      readonly=true
      doc="Hit points now."
    }
    field "Team" {
      type="int"
      readonly=false
      doc="Hitboxes of the same team do not hurt this node unless they allow friendly fire."
    }
    field "InvulnTime" {
      type="float"
      readonly=false
      doc="Seconds of game time without damage after a hit. Hits in the same step all count."
    }
    field "DestroyOnDeath" {
      type="bool"
      readonly=false
      doc="Destroys the node at death, unless it has Respawn."
    }
    field "DespawnOnDeath" {
      type="bool"
      readonly=false
      doc="Returns the node to its pool at death; a node that was not spawned is destroyed."
    }
    field "Invulnerable" {
      type="bool"
      readonly=true
      doc="True while damage is ignored."
    }
    field "Dead" {
      type="bool"
      readonly=true
      doc="True from death until Revive."
    }
  }
  component "gameplay.Hurtbox2D" {
    short="Hurtbox2D"
    category="gameplay"
    doc="Area where hitboxes damage a Health: on this node or on its nearest parent with Health."
    builtin=true
    field "Area" {
      type="Rect"
      readonly=false
      doc="Rectangle in this node's space."
    }
    field "Shape" {
      type="int"
      readonly=false
      doc="box uses the rectangle; circle uses the circle inside it."
    }
    field "Multiplier" {
      type="float"
      readonly=false
      doc="Damage taken here is multiplied by this, for weak spots and armour."
    }
    field "Active" {
      type="bool"
      readonly=false
      doc="Off ignores hits."
    }
    field "Health" {
      type="NodeRef"
      readonly=false
      doc="Health that takes the damage. Empty uses this node or its nearest parent with Health."
    }
  }
  component "gameplay.Hitbox2D" {
    short="Hitbox2D"
    category="gameplay"
    doc="Damages hurtboxes inside its area, once per target per activation, on every entry or periodically."
    builtin=true
    field "Area" {
      type="Rect"
      readonly=false
      doc="Rectangle in this node's space."
    }
    field "Shape" {
      type="int"
      readonly=false
      doc="box uses the rectangle; circle uses the circle inside it."
    }
    field "Damage" {
      type="int"
      readonly=false
      doc="Damage per hit before the hurtbox multiplier."
    }
    field "Knockback" {
      type="Vec2"
      readonly=false
      doc="Push on a hit: velocity in units per second for a Motion 2D target, impulse for a dynamic body. Turns with the node."
    }
    field "KnockbackFromCenter" {
