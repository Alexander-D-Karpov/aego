  cmethod "GetVec4Lane" comp="engine.MaterialOverride" {
    params=["string", "int"]
    result="float"
    doc="Reads one lane from an ordinary vec4 parameter. The lane index must be from 0 through 3."
  }
  cmethod "Reset" comp="engine.MaterialOverride" {
    params=["string"]
    result="bool"
    doc="Removes the explicit instance value and inherits the shared material value. Returns whether an explicit value existed."
  }
  cmethod "SetBool" comp="engine.MaterialOverride" {
    params=["string", "bool"]
    result="void"
    doc="Sets an instance bool parameter on this node."
  }
  cmethod "SetColor" comp="engine.MaterialOverride" {
    params=["string", "Color"]
    result="void"
    doc="Sets a linear Color instance parameter declared with the color hint."
  }
  cmethod "SetFloat" comp="engine.MaterialOverride" {
    params=["string", "float"]
    result="void"
    doc="Sets an instance float parameter on this node. Type mismatch leaves its previous value unchanged."
  }
  cmethod "SetInt" comp="engine.MaterialOverride" {
    params=["string", "int"]
    result="void"
    doc="Sets an exact signed int32 instance parameter. Values outside the int32 range are rejected."
  }
  cmethod "SetVec2" comp="engine.MaterialOverride" {
    params=["string", "Vec2"]
    result="void"
    doc="Sets an instance vec2 parameter on this node."
  }
  cmethod "SetVec3" comp="engine.MaterialOverride" {
    params=["string", "Vec3"]
    result="void"
    doc="Sets an instance vec3 parameter on this node."
  }
  cmethod "SetVec4" comp="engine.MaterialOverride" {
    params=["string", "struct:aego/material.Vec4"]
    result="void"
    doc="Sets four numerical instance lanes using material.Vec4 without color conversion."
  }
  cmethod "Damage" comp="gameplay.Health" {
    params=["int", "NodeRef"]
    result="bool"
    names=["amount", "source"]
    doc="Damage removes hit points and reports whether they were removed: not while invulnerable, dead or for amounts below 1."
  }
  cmethod "Heal" comp="gameplay.Health" {
    params=["int"]
    result="void"
    names=["amount"]
    doc="Heal adds hit points up to Max; it does nothing while dead."
  }
  cmethod "Kill" comp="gameplay.Health" {
    params=["NodeRef"]
    result="void"
    names=["source"]
    doc="Kill sets the hit points to zero."
  }
  cmethod "Revive" comp="gameplay.Health" {
    params=["int"]
    result="void"
    names=["hp"]
    doc="Revive brings the node back with this many hit points; 0 means Max."
  }
  cmethod "SetInvulnerable" comp="gameplay.Health" {
    params=["float"]
    result="void"
    names=["seconds"]
    doc="SetInvulnerable ignores damage for some seconds of game time."
  }
  cmethod "Activate" comp="gameplay.Hitbox2D" {
    params=[]
    result="void"
    doc="Activate starts a new attack: targets hit before can be hit again."
  }
  cmethod "Deactivate" comp="gameplay.Hitbox2D" {
    params=[]
    result="void"
    doc="Deactivate stops dealing damage."
  }
  cmethod "Pulse" comp="gameplay.Hitbox2D" {
    params=[]
    result="void"
    doc="Pulse deals one round of damage in the next step, active or not."
  }
  cmethod "AddDisplacement" comp="gameplay.Motion2D" {
    params=["Vec2"]
    result="void"
    names=["offset"]
    doc="AddDisplacement moves by an offset in world units on the next step, through walls and slopes like a move, without changing the velocity; root motion of an Animator uses it."
  }
  cmethod "AddVelocity" comp="gameplay.Motion2D" {
    params=["Vec2"]
    result="void"
    names=["velocity"]
    doc="AddVelocity adds a push once, for knockback."
  }
  cmethod "Dash" comp="gameplay.Motion2D" {
    params=["Vec2", "float"]
    result="void"
    names=["velocity", "seconds"]
    doc="Dash moves at a fixed velocity for some seconds."
  }
  cmethod "Jump" comp="gameplay.Motion2D" {
    params=[]
    result="void"
    doc="Jump jumps on the next step if grounded, within coyote time or later within the jump buffer."
  }
  cmethod "JumpReleased" comp="gameplay.Motion2D" {
    params=[]
    result="void"
    doc="JumpReleased cuts a rising jump by Jump Cut Multiplier."
  }
  cmethod "Move" comp="gameplay.Motion2D" {
    params=["float"]
    result="void"
    names=["x"]
    doc="Move sets the horizontal input, -1..1; it stays until the next Move."
  }
  cmethod "MoveDir" comp="gameplay.Motion2D" {
    params=["Vec2"]
    result="void"
    names=["dir"]
    doc="MoveDir sets the top-down input; a longer vector is cut to length 1."
  }
  cmethod "Stop" comp="gameplay.Motion2D" {
    params=[]
    result="void"
    doc="Stop zeroes the velocity and ends a dash."
  }
  cmethod "Teleport" comp="gameplay.Motion2D" {
    params=["Vec2"]
    result="void"
    names=["position"]
    doc="Teleport moves to a position on the next step and resets velocity and state."
  }
  cmethod "SetPoint" comp="gameplay.Respawn" {
    params=["Vec2"]
    result="void"
    names=["position"]
    doc="SetPoint sets the respawn point."
  }
  cmethod "Trigger" comp="gameplay.Respawn" {
    params=[]
    result="void"
    doc="Trigger respawns the node after Delay."
  }
  cmethod "Go" comp="gameplay.StateMachine" {
    params=["string"]
    result="bool"
    names=["state"]
    doc="Go switches to a state after the current hook returns; Exit of the old state and Enter of the new one run in between. Returns false for an unknown state."
  }
  cmethod "Is" comp="gameplay.StateMachine" {
    params=["string"]
    result="bool"
    names=["state"]
    doc="Is reports whether the machine is in a state."
  }
  cmethod "TimeIn" comp="gameplay.StateMachine" {
    params=[]
    result="float"
    doc="TimeIn returns the seconds spent in the current state."
  }
  cmethod "Burst" comp="particles.ParticleSystem2D" {
    params=["int"]
    result="void"
    names=["count"]
    doc="Requests count births at the emitter. Does not start automatic emission."
    example="Dust.Get<ParticleSystem2D>().Burst(8)"
  }
  cmethod "Clear" comp="particles.ParticleSystem2D" {
    params=[]
    result="void"
    doc="Removes live particles without changing the emission schedule."
  }
  cmethod "Count" comp="particles.ParticleSystem2D" {
    params=[]
    result="int"
    doc="Returns the current number of living particles on the emitter."
  }
  cmethod "Emitting" comp="particles.ParticleSystem2D" {
    params=[]
    result="bool"
    doc="Reports whether automatic emission is running."
  }
  cmethod "Play" comp="particles.ParticleSystem2D" {
    params=[]
    result="void"
    doc="Starts automatic emission. Repeating Play while emitting does nothing."
  }
  cmethod "Playing" comp="particles.ParticleSystem2D" {
    params=[]
    result="bool"
    doc="Reports whether the schedule is running or particles remain."
  }
  cmethod "Restart" comp="particles.ParticleSystem2D" {
    params=[]
    result="void"
    doc="Clears live particles and starts a new emission schedule."
  }
  cmethod "Stop" comp="particles.ParticleSystem2D" {
    params=[]
    result="void"
    doc="Stops new emissions and lets live particles drain."
  }
  cmethod "StopAndClear" comp="particles.ParticleSystem2D" {
    params=[]
    result="void"
    doc="Stops automatic emission and immediately removes living particles."
  }
  cmethod "ApplyForce" comp="physics.Body2D" {
    params=["Vec2"]
    result="void"
    names=["force"]
    doc="ApplyForce pushes the body's center of mass during the next physics step. Call it from FixedUpdate."
  }
  cmethod "ApplyForceAt" comp="physics.Body2D" {
    params=["Vec2", "Vec2"]
    result="void"
    names=["force", "point"]
    doc="ApplyForceAt pushes the body at a world point, which also spins it."
  }
  cmethod "ApplyImpulse" comp="physics.Body2D" {
    params=["Vec2"]
    result="void"
    names=["impulse"]
    doc="ApplyImpulse changes the velocity at once, scaled by mass."
    example="body.ApplyImpulse(Vec2{Y: -jumpImpulse})"
  }
  cmethod "ApplyImpulseAt" comp="physics.Body2D" {
    params=["Vec2", "Vec2"]
    result="void"
    names=["impulse", "point"]
    doc="ApplyImpulseAt applies an impulse at a world point."
  }
  cmethod "ApplyTorque" comp="physics.Body2D" {
    params=["float"]
    result="void"
    names=["torque"]
    doc="ApplyTorque spins the body during the next physics step."
  }
  cmethod "Mass" comp="physics.Body2D" {
    params=[]
    result="float"
    doc="Mass returns the mass computed from the colliders or the override."
  }
  cmethod "MoveTo" comp="physics.Body2D" {
    params=["Vec2", "float"]
    result="void"
    names=["position", "angle"]
    doc="MoveTo drives a kinematic body to the pose by the end of the next physics step, pushing dynamic bodies on the way. Call it from FixedUpdate."
  }
  cmethod "SetAngularVelocity" comp="physics.Body2D" {
    params=["float"]
    result="void"
    names=["velocity"]
    doc="SetAngularVelocity sets the spin in radians per second."
  }
  cmethod "SetVelocity" comp="physics.Body2D" {
    params=["Vec2"]
    result="void"
    names=["velocity"]
    doc="SetVelocity sets the linear velocity in units per second."
  }
  cmethod "Sleep" comp="physics.Body2D" {
    params=[]
    result="void"
    doc="Sleep stops the body until something touches it."
  }
  cmethod "Teleport" comp="physics.Body2D" {
    params=["Vec2", "float"]
    result="void"
    names=["position", "angle"]
    doc="Teleport moves the body to a world pose without sweeping, keeping its velocity."
  }
  cmethod "WakeUp" comp="physics.Body2D" {
    params=[]
    result="void"
    doc="WakeUp makes a sleeping body simulate again."
  }
  cmethod "SetBool" comp="render2d.PostProcess" {
    params=["string", "bool"]
    result="void"
    doc="Sets a boolean parameter by instanceID:Field."
  }
  cmethod "SetEffectEnabled" comp="render2d.PostProcess" {
    params=["string", "bool"]
    result="void"
    doc="Enables or disables an effect by its stable instance ID."
  }
  cmethod "SetFloat" comp="render2d.PostProcess" {
    params=["string", "float"]
    result="void"
