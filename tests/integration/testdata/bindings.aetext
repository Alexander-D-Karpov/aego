    result="void"
    doc="Snap moves the camera onto the target at once, for example after a teleport."
  }
  cmethod "Add" comp="camera.CameraShake2D" {
    params=["float"]
    result="void"
    names=["trauma"]
    doc="Add adds trauma to the output of this camera; trauma is capped at 1."
  }
  cmethod "IsActive" comp="camera.VirtualCamera2D" {
    params=[]
    result="bool"
    doc="IsActive reports whether this virtual camera drives its output now."
  }
  cmethod "GetBool" comp="engine.MaterialOverride" {
    params=["string"]
    result="bool"
    doc="Reads the effective bool parameter."
  }
  cmethod "GetColor" comp="engine.MaterialOverride" {
    params=["string"]
    result="Color"
    doc="Reads the effective linear Color of a parameter declared with the color hint."
  }
  cmethod "GetFloat" comp="engine.MaterialOverride" {
    params=["string"]
    result="float"
    doc="Reads the effective float after shader default, material value and node override."
  }
  cmethod "GetInt" comp="engine.MaterialOverride" {
    params=["string"]
    result="int"
    doc="Reads the exact signed int32 effective parameter."
  }
  cmethod "GetVec2" comp="engine.MaterialOverride" {
    params=["string"]
    result="Vec2"
    doc="Reads the effective vec2 parameter."
  }
  cmethod "GetVec3" comp="engine.MaterialOverride" {
