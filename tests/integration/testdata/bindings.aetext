    result="void"
    doc="Play starts the source from the beginning, stopping a sound it already plays."
  }
  cmethod "Stop" comp="audio.AudioSource2D" {
    params=[]
    result="void"
    doc="Stop ends the sound of the source with a short fade."
  }
  cmethod "StopFade" comp="audio.AudioSource2D" {
    params=["float"]
    result="void"
    names=["seconds"]
    doc="StopFade fades the sound of the source out over seconds."
  }
  cmethod "Snap" comp="camera.CameraFollow2D" {
