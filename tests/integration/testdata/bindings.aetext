  struct "Vec4" module="aego/material" slots=4 {
    doc="Four numeric lanes, with no color-space conversion."
    field "X" {
      type="float"
    }
    field "Y" {
      type="float"
    }
    field "Z" {
      type="float"
    }
    field "W" {
      type="float"
    }
  }
  struct "Contact" module="aego/physics" slots=6 {
    doc="Contact describes a touch between two colliders from the receiver's side.\nNormal points from the other body into this one, RelativeVelocity is this body's velocity relative to the other at Point."
    field "Point" {
      type="Vec2"
    }
    field "Normal" {
      type="Vec2"
    }
    field "NormalImpulse" {
      type="float"
    }
    field "RelativeVelocity" {
      type="Vec2"
    }
    field "SelfCollider" {
      type="NodeRef"
    }
    field "OtherCollider" {
      type="NodeRef"
    }
  }
  struct "RayHit" module="aego/physics" slots=6 {
    doc="RayHit is the result of a ray query. Hit is false when nothing was found; Node is the body, Collider the node of the shape that was hit."
    field "Hit" {
      type="bool"
    }
    field "Point" {
      type="Vec2"
    }
    field "Normal" {
      type="Vec2"
    }
    field "Distance" {
      type="float"
    }
    field "Node" {
      type="NodeRef"
    }
    field "Collider" {
      type="NodeRef"
    }
  }
  handle "aego/action.Action" await=true {
    doc="Action runs tweens, timers and other actions one after another or together; yield a waits until it ends."
  }
  handle "aego/audio.Sound" await=true {
    doc="Sound is a playing sound. yield s waits until it ends; a nil or finished sound is done. It is a presentation event: wait for game logic with a timer, not a sound."
  }
  handle "aego/camera.Blend" await=true {
    doc="Blend is a running blend between virtual cameras. yield b waits until it ends; a nil blend is done."
  }
  handle "aego/timer.Timer" await=true {
    doc="Timer counts down and fires. yield t waits for the next fire or the end; a timer dies with the node of the script that made it."
  }
  handle "aego/tween.Tween" await=true {
    doc="Tween animates one property of a node. A finished, stopped or nil tween reads as done; yield t waits until it ends."
  }
  event "OnCollisionEnter" {
    params=["NodeRef", "struct:aego/physics.Contact"]
    names=["other", "contact"]
    doc="OnCollisionEnter runs after the physics step in which this body started touching other."
  }
  event "OnCollisionStay" {
    params=["NodeRef", "struct:aego/physics.Contact"]
    names=["other", "contact"]
    doc="OnCollisionStay runs after every later physics step while the bodies keep touching. It costs nothing when no script declares it."
  }
  event "OnCollisionExit" {
    params=["NodeRef", "struct:aego/physics.Contact"]
    names=["other", "contact"]
    doc="OnCollisionExit runs when the bodies stop touching, including when one of them is destroyed or disabled. Contact.Point is the last known point."
  }
  event "OnTriggerEnter" {
    params=["NodeRef"]
    names=["other"]
    doc="OnTriggerEnter runs when other's collider entered a trigger of this body, or this body entered other's trigger."
  }
  event "OnTriggerExit" {
    params=["NodeRef"]
    names=["other"]
    doc="OnTriggerExit runs when the overlap with a trigger ends."
  }
  event "OnSettingChanged" {
    params=["string"]
    names=["id"]
    doc="OnSettingChanged runs on every script with this method after a setting's effective value changed: Apply, Revert, an override or a confirmation timeout."
  }
  event "OnAnimEvent" {
    params=["int", "float"]
    names=["id", "payload"]
    doc="OnAnimEvent runs on the scripts of a node whose Animation Player reaches an event of its clip; anim.EventName(id) gives the name."
  }
  event "OnSpawned" {
    params=[]
    doc="OnSpawned runs on every script of a spawned prefab copy, after Ready for a new copy and instead of it for a copy taken from a pool."
  }
  event "OnDespawned" {
    params=[]
    doc="OnDespawned runs on every script of a pooled copy when it is despawned, before its coroutines and connections end."
  }
  event "OnSave" {
    params=[]
    doc="OnSave runs on every script that has it while a game is saved; write values with save.Put*."
  }
  event "OnLoad" {
    params=[]
    doc="OnLoad runs after Ready on every script that has it when a saved game is loaded; read values with save.Get*."
  }
  method "AddTag" recv="NodeRef" {
    params=["string"]
    result="bool"
    names=["tag"]
    doc="AddTag adds a tag and returns false when it is malformed."
    example="node.AddTag(\"Enemy.Stunned\")"
  }
  method "Child" recv="NodeRef" {
    params=["string"]
    result="NodeRef"
    names=["name"]
    doc="Child returns the direct child with this name, or nil."
    example="gun := node.Child(\"Gun\")"
  }
  method "Destroy" recv="NodeRef" {
    params=[]
    result="void"
    doc="Destroy removes the node and its children at the end of the phase."
    example="node.Destroy()"
  }
  method "Enabled" recv="NodeRef" {
    params=[]
    result="bool"
    doc="Enabled reports the node's own enabled flag, ignoring its parents."
    example="if !Door.Enabled() {"
  }
  method "Find" recv="NodeRef" {
    params=["string"]
    result="NodeRef"
    names=["path"]
    doc="Find resolves a path relative to the node: Weapon/Gun, ../Sibling or /Root/Player."
    example="muzzle := node.Find(\"Weapon/Muzzle\")"
  }
  method "HasTag" recv="NodeRef" {
    params=["string"]
    result="bool"
    names=["tag"]
    doc="HasTag reports whether the node has the tag or a tag under it: Enemy matches Enemy.Flying."
    example="if other.HasTag(\"Enemy\") {"
  }
  method "IsAlive" recv="NodeRef" {
    params=[]
    result="bool"
    doc="IsAlive reports whether the node exists. It is false right after Destroy."
    example="if Target != nil && Target.IsAlive() {"
  }
  method "IsPrefabInstance" recv="NodeRef" {
    params=[]
    result="bool"
    doc="IsPrefabInstance reports whether the node is a prefab copy or lies inside one."
    example="if node.IsPrefabInstance() {"
  }
  method "Name" recv="NodeRef" {
    params=[]
    result="string"
    doc="Name returns the node name, unique among its siblings."
    example="log.Info(node.Name())"
  }
  method "Parent" recv="NodeRef" {
    params=[]
    result="NodeRef"
    doc="Parent returns the parent node, or nil for top-level nodes."
    example="owner := node.Parent()"
  }
  method "Position" recv="NodeRef" {
    params=[]
    result="Vec2"
    doc="Position returns the local position relative to the parent."
    example="p := node.Position()"
  }
  method "Position3" recv="NodeRef" {
    params=[]
    result="Vec3"
    doc="Position3 returns the local 3D position."
    example="p := node.Position3()"
  }
  method "PrefabRoot" recv="NodeRef" {
    params=[]
    result="NodeRef"
    doc="PrefabRoot returns the root of the nearest prefab copy that holds the node, the node itself for a root, or nil."
    example="owner := node.PrefabRoot()\nowner.Destroy()"
  }
  method "RemoveTag" recv="NodeRef" {
    params=["string"]
    result="bool"
    names=["tag"]
    doc="RemoveTag removes a tag and returns whether the node had it."
  }
  method "Rotation" recv="NodeRef" {
    params=[]
    result="float"
    doc="Rotation returns the local rotation in radians, clockwise."
    example="a := node.Rotation()"
  }
  method "Rotation3" recv="NodeRef" {
    params=[]
    result="Quat"
    doc="Rotation3 returns the local 3D rotation."
    example="q := node.Rotation3()"
  }
  method "Scale" recv="NodeRef" {
    params=[]
    result="Vec2"
    doc="Scale returns the local scale."
    example="s := node.Scale()"
  }
  method "SetEnabled" recv="NodeRef" {
    params=["bool"]
    result="void"
    names=["enabled"]
    doc="SetEnabled turns the node on or off. Disabled nodes and their children are not drawn."
    example="Shield.SetEnabled(false)"
  }
  method "SetPosition" recv="NodeRef" {
    params=["Vec2"]
    result="void"
    names=["p"]
    doc="SetPosition sets the local position."
    example="node.SetPosition(node.Position() + velocity * dt)"
  }
  method "SetPosition3" recv="NodeRef" {
    params=["Vec3"]
    result="void"
    names=["p"]
    doc="SetPosition3 sets the local 3D position."
    example="node.SetPosition3(node.Position3() + Vec3{0, 0, -Speed * dt})"
  }
  method "SetRotation" recv="NodeRef" {
    params=["float"]
    result="void"
    names=["radians"]
    doc="SetRotation sets the local rotation in radians."
    example="node.SetRotation(node.Rotation() + Spin * dt)"
  }
  method "SetRotation3" recv="NodeRef" {
    params=["Quat"]
    result="void"
    names=["q"]
    doc="SetRotation3 sets the local 3D rotation."
    example="node.SetRotation3(math.QuatEuler(0, angle, 0))"
  }
  method "SetScale" recv="NodeRef" {
    params=["Vec2"]
    result="void"
    names=["scale"]
    doc="SetScale sets the local scale. A negative X mirrors the node."
    example="node.SetScale(Vec2{-1, 1})"
  }
  method "SetTransform2D" recv="NodeRef" {
    params=["Transform2D"]
    result="void"
    names=["t"]
    doc="SetTransform2D replaces the local 2D transform."
    example="node.SetTransform2D(t)"
  }
  method "SetTransform3D" recv="NodeRef" {
    params=["Transform3D"]
    result="void"
    names=["t"]
    doc="SetTransform3D replaces the local 3D transform."
    example="node.SetTransform3D(t)"
  }
  method "Space" recv="NodeRef" {
    params=[]
    result="int"
    doc="Space returns 0 for 2D nodes and 1 for 3D nodes."
    example="if node.Space() == 1 {"
  }
  method "Transform2D" recv="NodeRef" {
    params=[]
    result="Transform2D"
    doc="Transform2D returns a copy of the local 2D transform. Change it and pass it to SetTransform2D."
    example="t := node.Transform2D()\nt.Position.X += 1\nnode.SetTransform2D(t)"
  }
  method "Transform3D" recv="NodeRef" {
    params=[]
    result="Transform3D"
    doc="Transform3D returns a copy of the local 3D transform."
    example="t := node.Transform3D()\nt.Position.Y += 1\nnode.SetTransform3D(t)"
  }
  method "WorldPosition" recv="NodeRef" {
    params=[]
    result="Vec2"
    doc="WorldPosition returns the position in world space, as of the last transform pass."
    example="d := math.Dist(node.WorldPosition(), Target.WorldPosition())"
  }
  cmethod "Pause" comp="animation.AnimationPlayer" {
    params=[]
    result="void"
    doc="Pause holds the clip where it is."
  }
  cmethod "Play" comp="animation.AnimationPlayer" {
    params=["AssetRef<anim>"]
    result="void"
    names=["clip"]
    doc="Play starts a clip from its beginning on the next fixed step; nil plays the current clip again."
    example="node.Get<AnimationPlayer>().Play(Attack)"
  }
  cmethod "Resume" comp="animation.AnimationPlayer" {
    params=[]
    result="void"
    doc="Resume continues a paused clip."
  }
  cmethod "Seek" comp="animation.AnimationPlayer" {
    params=["float"]
    result="void"
    names=["time"]
    doc="Seek jumps to a time inside the clip on the next fixed step without firing the events in between."
  }
  cmethod "SetSpeed" comp="animation.AnimationPlayer" {
    params=["float"]
    result="void"
    names=["speed"]
    doc="SetSpeed changes the playback speed; a negative speed plays backwards."
  }
  cmethod "Stop" comp="animation.AnimationPlayer" {
    params=[]
    result="void"
    doc="Stop ends the clip on the next fixed step: tracks with onEnd=restore get back the values they had before Play, Finished runs with cycle -1."
  }
  cmethod "CrossFade" comp="animation.Animator" {
    params=["string", "float"]
    result="void"
    names=["state", "seconds"]
    doc="CrossFade blends into a state over some seconds, starting on the next fixed step."
  }
  cmethod "GetBool" comp="animation.Animator" {
    params=["string"]
    result="bool"
    names=["name"]
    doc="GetBool reads a bool or trigger parameter."
  }
  cmethod "GetFloat" comp="animation.Animator" {
    params=["string"]
    result="float"
    names=["name"]
    doc="GetFloat reads a float parameter."
  }
  cmethod "GetInt" comp="animation.Animator" {
    params=["string"]
    result="int"
    names=["name"]
    doc="GetInt reads an int parameter."
  }
  cmethod "IsState" comp="animation.Animator" {
    params=["string"]
    result="bool"
    names=["state"]
    doc="IsState reports whether the animator is in a state; during a blend that is the state it blends into."
  }
  cmethod "Play" comp="animation.Animator" {
    params=["string"]
    result="void"
    names=["state"]
    doc="Play switches to a state on the next fixed step, without a blend."
  }
  cmethod "ResetTrigger" comp="animation.Animator" {
    params=["string"]
    result="void"
    names=["name"]
    doc="ResetTrigger clears a trigger that has not fired yet."
  }
  cmethod "SetBool" comp="animation.Animator" {
    params=["string", "bool"]
    result="void"
    names=["name", "value"]
    doc="SetBool sets a bool parameter; transitions read it on the next fixed step."
  }
  cmethod "SetFloat" comp="animation.Animator" {
    params=["string", "float"]
    result="void"
    names=["name", "value"]
    doc="SetFloat sets a float parameter."
    example="anim.SetFloat(\"Speed\", math.Abs(motion.Velocity.X))"
  }
  cmethod "SetInt" comp="animation.Animator" {
    params=["string", "int"]
    result="void"
    names=["name", "value"]
    doc="SetInt sets an int parameter."
  }
  cmethod "SetTrigger" comp="animation.Animator" {
    params=["string"]
    result="void"
    names=["name"]
    doc="SetTrigger sets a trigger for the next fixed step; a transition that uses it, or the end of that step, clears it."
  }
  cmethod "StateName" comp="animation.Animator" {
    params=["int"]
    result="string"
    names=["index"]
    doc="StateName returns the name of a state index, as StateEntered and StateExited report it."
  }
  cmethod "IsPlaying" comp="audio.AudioSource2D" {
    params=[]
    result="bool"
    doc="IsPlaying reports whether the source plays a sound."
