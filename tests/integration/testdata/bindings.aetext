  module "aego/log" {
    func "Debug" {
      params=["string"]
      result="void"
      names=["msg"]
      doc="Debug writes a message to the Console. Debug messages are hidden unless the editor runs with -debug."
      example="log.Debug(\"state \" + string(int(state)))"
    }
    func "Error" {
      params=["string"]
      result="void"
      names=["msg"]
      doc="Error writes an error to the Console. It does not stop the script; use it for problems you can recover from."
      example="log.Error(\"spawn point missing\")"
    }
    func "Info" {
      params=["string"]
      result="void"
      names=["msg"]
      doc="Info writes a message to the Console."
      example="log.Info(\"ready \" + node.Name())"
    }
    func "Warn" {
      params=["string"]
      result="void"
      names=["msg"]
      doc="Warn writes a warning to the Console."
      example="log.Warn(\"Target is not set\")"
    }
  }
  module "aego/math" {
    func "Abs" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Abs returns the absolute value of x."
      example="dist := math.Abs(target - x)"
    }
    func "AbsInt" {
      params=["int"]
      result="int"
      names=["x"]
      doc="AbsInt returns the absolute value of an int."
      example="steps := math.AbsInt(to - from)"
    }
    func "Acos" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Acos returns the angle in radians whose cosine is x, in [0, Pi]."
      example="a := math.Acos(math.Dot(u, v))"
    }
    func "Angle" {
      params=["Vec2"]
      result="float"
      names=["v"]
      doc="Angle returns the direction of v in radians."
      example="node.SetRotation(math.Angle(velocity))"
    }
    func "Asin" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Asin returns the angle in radians whose sine is x, in [-Pi/2, Pi/2]."
      example="a := math.Asin(0.5)"
    }
    func "Atan2" {
      params=["float", "float"]
      result="float"
      names=["y", "x"]
      doc="Atan2 returns the angle in radians of the vector (x, y), in (-Pi, Pi]."
      example="angle := math.Atan2(d.Y, d.X)"
    }
    func "Ceil" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Ceil returns the least whole number greater than or equal to x."
      example="pages := math.Ceil(float(count) / 10)"
    }
    func "Clamp" {
      params=["float", "float", "float"]
      result="float"
      names=["v", "lo", "hi"]
      doc="Clamp limits v to the range [lo, hi]."
      example="x = math.Clamp(x, -10, 10)"
    }
    func "ClampInt" {
      params=["int", "int", "int"]
      result="int"
      names=["v", "lo", "hi"]
      doc="ClampInt limits an int to the range [lo, hi]."
      example="level = math.ClampInt(level, 1, 10)"
    }
    func "Cos" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Cos returns the cosine of an angle in radians."
      example="x := math.Cos(angle) * Radius"
    }
    func "Cross" {
      params=["Vec2", "Vec2"]
      result="float"
      names=["a", "b"]
      doc="Cross returns the z component of the 3D cross product; its sign tells on which side b lies."
      example="left := math.Cross(forward, toTarget) < 0"
    }
    func "Cross3" {
      params=["Vec3", "Vec3"]
      result="Vec3"
      names=["a", "b"]
      doc="Cross3 returns a vector perpendicular to a and b."
      example="right := math.Cross3(forward, Vec3{0, 1, 0})"
    }
    func "Deg2Rad" {
      params=["float"]
      result="float"
      names=["degrees"]
      doc="Deg2Rad converts degrees to radians."
      example="node.SetRotation(math.Deg2Rad(45))"
    }
    func "Dist" {
      params=["Vec2", "Vec2"]
      result="float"
      names=["a", "b"]
      doc="Dist returns the distance between two points."
      example="if math.Dist(pos, goal) < 0.1 {"
    }
    func "Dist3" {
      params=["Vec3", "Vec3"]
      result="float"
      names=["a", "b"]
      doc="Dist3 returns the distance between two 3D points."
      example="near := math.Dist3(a, b) < 2"
    }
    func "Dot" {
      params=["Vec2", "Vec2"]
      result="float"
      names=["a", "b"]
      doc="Dot returns the dot product of two Vec2."
      example="facing := math.Dot(forward, toPlayer) > 0"
    }
    func "Dot3" {
      params=["Vec3", "Vec3"]
      result="float"
      names=["a", "b"]
      doc="Dot3 returns the dot product of two Vec3."
      example="lit := math.Dot3(normal, light) > 0"
    }
    func "Exp" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Exp returns e raised to the power x."
      example="decay := math.Exp(-dt * Damping)"
    }
    func "Floor" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Floor returns the greatest whole number less than or equal to x."
      example="cell := math.Floor(pos.X / 32)"
    }
    func "Length" {
      params=["Vec2"]
      result="float"
      names=["v"]
      doc="Length returns the length of a Vec2."
      example="speed := math.Length(velocity)"
    }
    func "Length3" {
      params=["Vec3"]
      result="float"
      names=["v"]
      doc="Length3 returns the length of a Vec3."
      example="d := math.Length3(velocity)"
    }
    func "Lerp" {
      params=["float", "float", "float"]
      result="float"
      names=["a", "b", "t"]
      doc="Lerp blends from a to b. t = 0 gives a, t = 1 gives b; t is not clamped."
      example="zoom = math.Lerp(zoom, target, 5 * dt)"
    }
    func "LerpVec2" {
      params=["Vec2", "Vec2", "float"]
      result="Vec2"
      names=["a", "b", "t"]
      doc="LerpVec2 blends two Vec2 component-wise."
      example="cam = math.LerpVec2(cam, target, 4 * dt)"
    }
    func "LerpVec3" {
      params=["Vec3", "Vec3", "float"]
      result="Vec3"
      names=["a", "b", "t"]
      doc="LerpVec3 blends two Vec3 component-wise."
      example="p := math.LerpVec3(from, to, t)"
    }
    func "Log" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Log returns the natural logarithm of x."
      example="octave := math.Log(freq) / math.Log(2)"
    }
    func "Max" {
      params=["float", "float"]
      result="float"
      names=["a", "b"]
      doc="Max returns the larger of a and b."
      example="hp := math.Max(hp - damage, 0)"
    }
    func "MaxInt" {
      params=["int", "int"]
      result="int"
      names=["a", "b"]
      doc="MaxInt returns the larger of two ints."
      example="lives = math.MaxInt(lives - 1, 0)"
    }
    func "Min" {
      params=["float", "float"]
      result="float"
      names=["a", "b"]
      doc="Min returns the smaller of a and b."
      example="speed := math.Min(speed, MaxSpeed)"
    }
    func "MinInt" {
      params=["int", "int"]
      result="int"
      names=["a", "b"]
      doc="MinInt returns the smaller of two ints."
      example="ammo = math.MinInt(ammo + 10, MaxAmmo)"
    }
    func "Normalize" {
      params=["Vec2"]
      result="Vec2"
      names=["v"]
      doc="Normalize returns v scaled to length 1. A zero vector stays zero."
      example="dir := math.Normalize(target - pos)"
    }
    func "Normalize3" {
      params=["Vec3"]
      result="Vec3"
      names=["v"]
      doc="Normalize3 returns v scaled to length 1."
      example="dir := math.Normalize3(target - pos)"
    }
    func "Pow" {
      params=["float", "float"]
      result="float"
      names=["x", "y"]
      doc="Pow returns x raised to the power y."
      example="ease := math.Pow(t, 3)"
    }
    func "QuatAxisAngle" {
      params=["Vec3", "float"]
      result="Quat"
      names=["axis", "radians"]
      doc="QuatAxisAngle builds a rotation of an angle in radians around an axis."
      example="spin := math.QuatAxisAngle(Vec3{0, 1, 0}, Speed * dt)"
    }
    func "QuatEuler" {
      params=["float", "float", "float"]
      result="Quat"
      names=["x", "y", "z"]
      doc="QuatEuler builds a rotation from Euler angles in radians, applied as Z·Y·X."
      example="node.SetRotation3(math.QuatEuler(0, math.Pi, 0))"
    }
    func "QuatLookDir" {
      params=["Vec3"]
      result="Quat"
      names=["dir"]
      doc="QuatLookDir returns the rotation that points -Z along d."
      example="node.SetRotation3(math.QuatLookDir(target - pos))"
    }
    func "QuatMul" {
      params=["Quat", "Quat"]
      result="Quat"
      names=["a", "b"]
      doc="QuatMul combines two rotations: b is applied first, then a."
      example="node.SetRotation3(math.QuatMul(spin, node.Rotation3()))"
    }
    func "QuatRotate" {
      params=["Quat", "Vec3"]
      result="Vec3"
      names=["q", "v"]
      doc="QuatRotate rotates a vector by q."
      example="forward := math.QuatRotate(node.Rotation3(), Vec3{0, 0, -1})"
    }
    func "QuatSlerp" {
      params=["Quat", "Quat", "float"]
      result="Quat"
      names=["a", "b", "t"]
      doc="QuatSlerp blends two rotations along the shortest arc."
      example="r := math.QuatSlerp(from, to, 0.5)"
    }
    func "Rad2Deg" {
      params=["float"]
      result="float"
      names=["radians"]
      doc="Rad2Deg converts radians to degrees."
      example="log.Info(string(math.Rad2Deg(node.Rotation())))"
    }
    func "Rotate" {
      params=["Vec2", "float"]
      result="Vec2"
      names=["v", "radians"]
      doc="Rotate turns v clockwise by an angle in radians."
      example="offset := math.Rotate(Vec2{1, 0}, node.Rotation())"
    }
    func "Round" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Round returns x rounded to the nearest whole number; halves round away from zero."
      example="snapped := math.Round(x)"
    }
    func "Sign" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Sign returns -1, 0 or 1 depending on the sign of x."
      example="dir := math.Sign(input.Axis(\"horizontal\"))"
    }
    func "Sin" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Sin returns the sine of an angle in radians."
      example="y := math.Sin(time.Elapsed() * 2) * Amplitude"
    }
    func "Sqrt" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Sqrt returns the square root of x. Negative x gives NaN."
      example="d := math.Sqrt(dx*dx + dy*dy)"
    }
    func "Tan" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Tan returns the tangent of an angle in radians."
      example="slope := math.Tan(math.Deg2Rad(30))"
    }
    func "Trunc" {
      params=["float"]
      result="float"
      names=["x"]
      doc="Trunc drops the fractional part of x."
      example="whole := math.Trunc(-2.7)"
    }
    const "Pi" {
      type="float"
      int=0
      float=3.1415927410125732
      bool=false
      str=""
      doc="Pi is the ratio of a circle's circumference to its diameter, about 3.14159."
    }
    const "Tau" {
      type="float"
      int=0
      float=6.2831854820251465
      bool=false
      str=""
      doc="Tau is a full turn in radians, 2·Pi."
    }
  }
  module "aego/physics" {
    func "Gravity" {
      params=[]
      result="Vec2"
      doc="Gravity returns the world gravity in units per second squared. +Y points down."
    }
    func "Layer" {
      params=["string"]
      result="int"
      names=["name"]
      doc="Layer returns the index of a named physics layer."
    }
    func "LayerMask" {
      params=["string"]
      result="int"
      names=["name"]
      doc="LayerMask returns the mask bit of a named layer. Add masks of different layers to combine them."
      example="mask := physics.LayerMask(\"World\") + physics.LayerMask(\"Enemies\")"
    }
    func "Linecast" {
      params=["Vec2", "Vec2", "int"]
      result="struct:aego/physics.RayHit"
      names=["from", "to", "mask"]
      doc="Linecast returns the first hit between from and to on the layers in mask; -1 means every layer."
      example="hit := physics.Linecast(eye, target, physics.LayerMask(\"World\"))"
    }
    func "OverlapBox" {
      params=["Vec2", "Vec2", "[]NodeRef"]
      result="int"
      names=["center", "size", "out"]
      doc="OverlapBox writes the bodies touching the axis-aligned box into out and returns the count."
    }
    func "OverlapCircle" {
      params=["Vec2", "float", "[]NodeRef"]
      result="int"
      names=["center", "radius", "out"]
      doc="OverlapCircle writes the bodies touching the circle into out and returns the count."
    }
    func "OverlapPoint" {
      params=["Vec2", "[]NodeRef"]
      result="int"
      names=["point", "out"]
      doc="OverlapPoint writes the bodies whose colliders contain p into out and returns the count."
    }
    func "Raycast" {
      params=["Vec2", "Vec2", "float"]
      result="struct:aego/physics.RayHit"
      names=["origin", "dir", "maxDist"]
      doc="Raycast returns the closest hit along dir within maxDist. The caller's own body is ignored, triggers are skipped."
      example="hit := physics.Raycast(pos, Vec2{Y: 1}, 0.6)\nif hit.Hit {\n\tgrounded = true\n}"
    }
    func "RaycastAll" {
      params=["Vec2", "Vec2", "[]struct:aego/physics.RayHit"]
      result="int"
      names=["from", "to", "out"]
      doc="RaycastAll fills out with hits between from and to, nearest first, and returns how many it wrote. It writes at most len(out)."
    }
    func "SetGravity" {
      params=["Vec2"]
      result="void"
      names=["gravity"]
      doc="SetGravity changes the world gravity for the rest of the Play session."
    }
  }
  module "aego/rand" {
    func "Bool" {
      params=[]
      result="bool"
      doc="Bool returns true or false with equal chance."
      example="flip := rand.Bool()"
    }
    func "Float" {
      params=[]
      result="float"
      doc="Float returns a random number in [0, 1)."
      example="if rand.Float() < 0.25 {\n\tdropLoot()\n}"
    }
    func "Int" {
      params=["int", "int"]
      result="int"
      names=["min", "max"]
      doc="Int returns a random int in [min, max). It returns min when max <= min."
      example="roll := rand.Int(1, 7)"
    }
    func "Range" {
      params=["float", "float"]
      result="float"
      names=["min", "max"]
      doc="Range returns a random float in [min, max)."
      example="delay := rand.Range(0.5, 1.5)"
    }
    func "Seed" {
      params=[]
      result="int"
      doc="Seed returns the seed of the world's generator. Replays with the same seed produce the same numbers."
      example="log.Info(\"seed \" + string(rand.Seed()))"
    }
  }
  module "aego/save" {
    func "Autosave" {
      params=["float"]
      result="void"
      names=["seconds"]
      doc="Autosave saves to the slot named autosave every given number of real seconds; 0 turns it off."
    }
    func "Checkpoint" {
      params=[]
      result="void"
      doc="Checkpoint saves the game to the slot named checkpoint."
      example="save.Checkpoint()"
    }
    func "Delete" {
      params=["string"]
      result="void"
      names=["slot"]
      doc="Delete removes a save and its preview."
    }
    func "Exists" {
      params=["string"]
      result="bool"
      names=["slot"]
      doc="Exists reports whether a slot holds a save."
    }
    func "GetBool" {
      params=["string", "bool"]
      result="bool"
      names=["key", "def"]
      doc="GetBool reads a value this node stored, or def; it works in OnLoad."
    }
    func "GetFloat" {
      params=["string", "float"]
      result="float"
      names=["key", "def"]
      doc="GetFloat reads a value this node stored, or def; it works in OnLoad."
    }
    func "GetInt" {
      params=["string", "int"]
      result="int"
      names=["key", "def"]
      doc="GetInt reads a value this node stored, or def; it works in OnLoad."
    }
    func "GetString" {
      params=["string", "string"]
      result="string"
      names=["key", "def"]
      doc="GetString reads a value this node stored, or def; it works in OnLoad."
    }
    func "GetVec2" {
      params=["string", "Vec2"]
      result="Vec2"
      names=["key", "def"]
      doc="GetVec2 reads a value this node stored, or def; it works in OnLoad."
    }
    func "GlobalBool" {
      params=["string", "bool"]
      result="bool"
      names=["key", "def"]
      doc="GlobalBool reads game-wide progress, or def."
    }
    func "GlobalFloat" {
      params=["string", "float"]
      result="float"
      names=["key", "def"]
      doc="GlobalFloat reads game-wide progress, or def."
    }
    func "GlobalInt" {
      params=["string", "int"]
      result="int"
      names=["key", "def"]
      doc="GlobalInt reads game-wide progress, or def."
      example="kills := save.GlobalInt(\"kills\", 0)"
    }
    func "GlobalString" {
      params=["string", "string"]
      result="string"
      names=["key", "def"]
      doc="GlobalString reads game-wide progress, or def."
    }
    func "Load" {
      params=["string"]
      result="void"
      names=["slot"]
      doc="Load reloads the saved scene and restores the slot at the end of the frame."
      example="if save.Exists(\"slot1\") {\n  save.Load(\"slot1\")\n}"
    }
    func "PutBool" {
      params=["string", "bool"]
      result="void"
      names=["key", "value"]
      doc="PutBool stores a value for this node; call it in OnSave."
    }
    func "PutFloat" {
      params=["string", "float"]
      result="void"
      names=["key", "value"]
      doc="PutFloat stores a value for this node; call it in OnSave."
    }
    func "PutInt" {
      params=["string", "int"]
      result="void"
      names=["key", "value"]
      doc="PutInt stores a value for this node; call it in OnSave."
    }
    func "PutString" {
      params=["string", "string"]
      result="void"
      names=["key", "value"]
      doc="PutString stores a value for this node; call it in OnSave."
    }
    func "PutVec2" {
      params=["string", "Vec2"]
      result="void"
      names=["key", "value"]
      doc="PutVec2 stores a value for this node; call it in OnSave."
    }
    func "Save" {
      params=["string"]
      result="void"
      names=["slot"]
      doc="Save writes the game to a slot at the end of the frame."
      example="save.Save(\"slot1\")"
    }
    func "SetGlobalBool" {
      params=["string", "bool"]
      result="void"
      names=["key", "value"]
      doc="SetGlobalBool stores game-wide progress that every save carries."
    }
    func "SetGlobalFloat" {
      params=["string", "float"]
      result="void"
      names=["key", "value"]
      doc="SetGlobalFloat stores game-wide progress that every save carries."
    }
    func "SetGlobalInt" {
      params=["string", "int"]
      result="void"
      names=["key", "value"]
      doc="SetGlobalInt stores game-wide progress that every save carries."
    }
    func "SetGlobalString" {
      params=["string", "string"]
      result="void"
      names=["key", "value"]
      doc="SetGlobalString stores game-wide progress that every save carries."
    }
  }
  module "aego/scene" {
    func "ByID" {
      params=["string"]
      result="NodeRef"
      names=["id"]
      doc="ByID returns the node with this id, as written in the scene file, or nil."
    }
    func "Despawn" {
      params=["NodeRef"]
      result="void"
      names=["node"]
      doc="Despawn returns a spawned copy to its pool; it destroys a node that did not come from a pool."
      example="scene.Despawn(node)"
    }
    func "Destroy" {
      params=["NodeRef"]
      result="void"
      names=["node"]
      doc="Destroy removes a node and its children at the end of the phase."
      example="scene.Destroy(Target)"
    }
    func "Find" {
      params=["string"]
      result="NodeRef"
      names=["path"]
      doc="Find returns the node at a path from the scene root, or nil."
      example="spawn := scene.Find(\"Level/Spawn\")"
    }
    func "InArea" {
      params=["Rect", "int", "[]NodeRef"]
      result="int"
      names=["rect", "mask", "out"]
      doc="InArea writes the bodies touching the rectangle on the layers in mask into out when physics runs; without physics, every enabled 2D node whose position lies in the rectangle, ignoring mask."
      example="n := scene.InArea(Rect{x - 2, y - 2, 4, 4}, -1, near)"
    }
    func "Instantiate" {
      params=["AssetRef<prefab>", "NodeRef"]
      result="NodeRef"
      names=["prefab", "parent"]
      doc="Instantiate creates a copy of a prefab under parent, or under the root when parent is nil.\nThe new nodes appear at the end of the phase; their scripts get Ready before the next Update."
      example="b := scene.Instantiate(Bullet, nil)\nb.SetPosition(node.WorldPosition())"
    }
    func "Pool" {
      params=["AssetRef<prefab>", "int"]
      result="void"
      names=["prefab", "count"]
      doc="Pool makes n copies of a prefab ahead of time; their Ready runs now and Spawn takes them later."
      example="scene.Pool(Bullet, 32)"
    }
    func "Spawn" {
      params=["AssetRef<prefab>", "Vec2"]
      result="NodeRef"
      names=["prefab", "position"]
      doc="Spawn places a copy of a prefab at a position under the scene root, taken from its pool when one is free."
      example="b := scene.Spawn(Bullet, node.WorldPosition())"
    }
    func "SpawnAt" {
      params=["AssetRef<prefab>", "NodeRef", "Vec2", "float"]
      result="NodeRef"
      names=["prefab", "parent", "position", "rotation"]
      doc="SpawnAt places a copy of a prefab under parent with a local position and rotation."
      example="fx := scene.SpawnAt(Spark, node, Vec2{}, 0)"
    }
    func "WithComponent" {
      params=["string", "[]NodeRef"]
      result="int"
      names=["component", "out"]
      doc="WithComponent writes enabled nodes that have the component into out and returns the count."
      example="n := scene.WithComponent(\"Body2D\", bodies)"
    }
    func "WithTag" {
      params=["string", "[]NodeRef"]
      result="int"
      names=["tag", "out"]
      doc="WithTag writes enabled nodes with the tag into out and returns the count; Enemy also finds Enemy.Flying. Nodes come in the order they got the tag."
      example="n := scene.WithTag(\"Enemy\", enemies)"
    }
  }
  module "aego/settings" {
    func "Apply" {
      params=[]
      result="bool"
      doc="Apply applies every staged value at once; if one fails, none change."
      example="if !settings.Apply() {"
    }
    func "ClearOverride" {
      params=["string"]
      result="void"
      names=["id"]
      doc="ClearOverride removes a session override."
      example="settings.ClearOverride(\"audio.bus.music.volume\")"
    }
    func "ClearOverrides" {
      params=[]
      result="void"
      doc="ClearOverrides removes every session override."
      example="settings.ClearOverrides()"
    }
    func "CloseView" {
      params=[]
      result="void"
      doc="CloseView hides the settings screen."
      example="settings.CloseView()"
    }
    func "GetBool" {
      params=["string"]
      result="bool"
      names=["id"]
      doc="GetBool returns the effective value of an on/off setting."
      example="if settings.GetBool(\"accessibility.reducedMotion\") {"
    }
    func "GetFloat" {
      params=["string"]
      result="float"
      names=["id"]
      doc="GetFloat returns the effective value of a number setting."
      example="shake *= settings.GetFloat(\"accessibility.screenShake\")"
    }
    func "GetInt" {
      params=["string"]
      result="int"
      names=["id"]
      doc="GetInt returns the effective value of an integer or choice setting."
      example="fps := settings.GetInt(\"display.frameLimit\")"
    }
    func "GetString" {
      params=["string"]
      result="string"
      names=["id"]
      doc="GetString returns a text setting, or the name of the current choice."
      example="mode := settings.GetString(\"display.window.mode\")"
    }
    func "NeedsRestart" {
      params=[]
      result="bool"
      doc="NeedsRestart reports whether an applied setting takes effect only after a restart."
      example="if settings.NeedsRestart() {"
    }
    func "OpenView" {
      params=[]
      result="void"
      doc="OpenView shows the settings screen and pauses the game until it closes."
      example="settings.OpenView()"
    }
    func "OverrideBool" {
      params=["string", "bool"]
      result="void"
      names=["id", "value"]
      doc="OverrideBool sets an on/off value for this session only."
      example="settings.OverrideBool(\"audio.bus.sfx.mute\", true)"
    }
    func "OverrideFloat" {
      params=["string", "float"]
      result="void"
      names=["id", "value"]
      doc="OverrideFloat sets a value for this session only; it is never saved."
      example="settings.OverrideFloat(\"audio.bus.music.volume\", 0.2)"
    }
    func "OverrideInt" {
      params=["string", "int"]
      result="void"
      names=["id", "value"]
      doc="OverrideInt sets an integer for this session only."
      example="settings.OverrideInt(\"display.frameLimit\", 30)"
    }
    func "OverrideString" {
      params=["string", "string"]
      result="void"
      names=["id", "value"]
      doc="OverrideString sets a text value for this session only."
      example="settings.OverrideString(\"display.window.resolution\", \"1280x720\")"
    }
    func "Reset" {
      params=["string"]
      result="void"
      names=["id"]
      doc="Reset stages a return to the project default."
      example="settings.Reset(\"input.sensitivity\")"
    }
    func "Revert" {
      params=[]
      result="void"
      doc="Revert drops the staged values."
      example="settings.Revert()"
    }
    func "Save" {
      params=[]
      result="void"
      doc="Save writes the player profile now; it is also saved on its own shortly after a change."
      example="settings.Save()"
    }
    func "SetBool" {
      params=["string", "bool"]
      result="void"
      names=["id", "value"]
      doc="SetBool stages a value; Apply makes it take effect."
      example="settings.SetBool(\"accessibility.subtitles\", true)"
    }
    func "SetFloat" {
      params=["string", "float"]
      result="void"
      names=["id", "value"]
      doc="SetFloat stages a number."
      example="settings.SetFloat(\"audio.bus.music.volume\", 0.5)"
    }
    func "SetInt" {
      params=["string", "int"]
      result="void"
      names=["id", "value"]
      doc="SetInt stages an integer or choice index."
      example="settings.SetInt(\"display.frameLimit\", 60)"
    }
    func "SetString" {
      params=["string", "string"]
      result="void"
      names=["id", "value"]
      doc="SetString stages a text value."
      example="settings.SetString(\"display.window.resolution\", \"1920x1080\")"
    }
    func "ViewOpen" {
      params=[]
      result="bool"
      doc="ViewOpen reports whether the settings screen is shown."
      example="if settings.ViewOpen() {"
    }
  }
  module "aego/testing" {
    func "Equal" {
      params=["int", "int"]
      result="void"
      names=["got", "want"]
      doc="Equal fails the test when two ints differ."
      example="testing.Equal(score(), 100)"
    }
    func "EqualFloat" {
      params=["float", "float", "float"]
      result="void"
      names=["got", "want", "eps"]
      doc="EqualFloat fails the test when got is further than eps from want, or is NaN."
      example="testing.EqualFloat(math.Sqrt(2), 1.4142, 0.001)"
    }
    func "EqualString" {
      params=["string", "string"]
      result="void"
      names=["got", "want"]
      doc="EqualString fails the test when two strings differ."
      example="testing.EqualString(name(), \"Player\")"
    }
    func "Fail" {
      params=["string"]
      result="void"
      names=["msg"]
      doc="Fail stops the test and reports msg."
      example="testing.Fail(\"unreachable\")"
    }
    func "False" {
      params=["bool", "string"]
      result="void"
      names=["v", "msg"]
      doc="False fails the test with msg when v is true."
      example="testing.False(dead, \"player should be alive\")"
    }
    func "True" {
      params=["bool", "string"]
      result="void"
      names=["v", "msg"]
      doc="True fails the test with msg when v is false."
      example="testing.True(hp > 0, \"player should be alive\")"
    }
  }
  module "aego/time" {
    func "Delta" {
      params=[]
      result="float"
      doc="Delta returns the game seconds since the previous frame: real time × Scale, 0 while paused. Inside FixedUpdate it is the fixed step."
      example="x += Speed * time.Delta()"
    }
    func "Elapsed" {
      params=[]
      result="float"
      doc="Elapsed returns the game seconds since Play started. It stops while paused and follows Scale."
      example="y := math.Sin(time.Elapsed() * 3)"
    }
    func "Fixed" {
      params=[]
      result="float"
      doc="Fixed returns the fixed step length in seconds, 1/60 by default. Scale does not change it; it changes how many steps run."
      example="steps := int(1 / time.Fixed())"
    }
    func "Frame" {
      params=[]
      result="int"
      doc="Frame returns the number of frames this world has run, paused frames included."
      example="if time.Frame() % 60 == 0 {\n\tlog.Info(\"tick\")\n}"
    }
    func "IsPaused" {
      params=[]
      result="bool"
      doc="IsPaused reports whether game time is paused."
      example="if time.IsPaused() {"
    }
    func "Scale" {
      params=[]
      result="float"
      doc="Scale returns the time scale: 1 is normal speed, 0.5 is half speed, 0 freezes game time without pausing."
      example="if time.Scale() < 1 {"
    }
    func "SetPaused" {
      params=["bool"]
      result="void"
      names=["paused"]
      doc="SetPaused pauses or resumes game time. While paused, Update, FixedUpdate and game-time coroutines of ordinary scripts do not run."
      example="time.SetPaused(true)"
    }
    func "SetScale" {
      params=["float"]
      result="void"
      names=["scale"]
      doc="SetScale sets the time scale from 0 to 8. The fixed step stays the same, so the simulation stays stable; only the number of steps changes."
      example="time.SetScale(0.25)"
    }
    func "Tick" {
      params=[]
      result="int"
      doc="Tick returns the number of the current or last fixed step. It is the same number the profiler and the Event Monitor show."
      example="log.Info(\"landed on tick \" + string(time.Tick()))"
    }
    func "Unscaled" {
      params=[]
      result="float"
      doc="Unscaled returns the real seconds since the previous frame, ignoring Scale and pause."
      example="menuFade += time.Unscaled()"
    }
    func "UnscaledElapsed" {
      params=[]
      result="float"
      doc="UnscaledElapsed returns the real seconds since Play started, pauses included."
      example="blink := math.Sin(time.UnscaledElapsed() * 6)"
    }
  }
  module "aego/timer" {
    func "Cooldown" {
      params=["float"]
      result="Handle<aego/timer.Timer>"
      names=["seconds"]
      doc="Cooldown makes a timer that starts ready; Use takes it and starts the wait."
      example="if attack.Use() {\n\tfire()\n}"
    }
    func "New" {
      params=["float"]
      result="Handle<aego/timer.Timer>"
      names=["seconds"]
      doc="New makes a timer that stays after it ends, so Restart can run it again."
      example="spawn = timer.New(3).Repeat(-1)"
    }
    func "Start" {
      params=["float"]
      result="Handle<aego/timer.Timer>"
      names=["seconds"]
      doc="Start makes a one-shot timer that frees itself when it fires."
      example="yield timer.Start(0.5)"
    }
  }
  module "aego/tween" {
    func "Position" {
      params=["NodeRef", "Vec2", "float", "enum:aego/curve.Easing"]
      result="Handle<aego/tween.Tween>"
      names=["node", "to", "duration", "ease"]
      doc="Position moves a 2D node to a local position."
      example="yield tween.Position(node, Vec2{4, 0}, 0.5, curve.OutCubic)"
    }
    func "ToColor" {
      params=["NodeRef", "string", "Color", "float", "enum:aego/curve.Easing"]
      result="Handle<aego/tween.Tween>"
      names=["node", "path", "to", "duration", "ease"]
      doc="ToColor animates a Color property."
      example="tween.ToColor(node, \"SpriteRenderer.Tint\", HitTint, 0.2, curve.Linear)"
    }
    func "ToFloat" {
      params=["NodeRef", "string", "float", "float", "enum:aego/curve.Easing"]
      result="Handle<aego/tween.Tween>"
      names=["node", "path", "to", "duration", "ease"]
      doc="ToFloat animates a float or int property, or one lane of a vector or color.\nPaths: Component.Field, Component.Field.a, transform.rotation, script/Name.Field."
      example="tween.ToFloat(node, \"SpriteRenderer.Tint.a\", 0, 0.3, curve.OutQuad)"
    }
    func "ToQuat" {
      params=["NodeRef", "string", "Quat", "float", "enum:aego/curve.Easing"]
      result="Handle<aego/tween.Tween>"
      names=["node", "path", "to", "duration", "ease"]
      doc="ToQuat turns a rotation along the short arc."
      example="tween.ToQuat(node, \"transform.rotation\", math.QuatEuler(0, 1.57, 0), 0.5, curve.InOutCubic)"
    }
    func "ToVec2" {
      params=["NodeRef", "string", "Vec2", "float", "enum:aego/curve.Easing"]
      result="Handle<aego/tween.Tween>"
      names=["node", "path", "to", "duration", "ease"]
      doc="ToVec2 animates a Vec2 property."
      example="tween.ToVec2(node, \"transform.scale\", Vec2{1.2, 1.2}, 0.1, curve.OutBack)"
    }
    func "ToVec3" {
      params=["NodeRef", "string", "Vec3", "float", "enum:aego/curve.Easing"]
      result="Handle<aego/tween.Tween>"
      names=["node", "path", "to", "duration", "ease"]
      doc="ToVec3 animates a Vec3 property, such as the position of a 3D node."
      example="tween.ToVec3(node, \"transform.position\", Vec3{0, 2, 0}, 1, curve.InOutSine)"
    }
  }
